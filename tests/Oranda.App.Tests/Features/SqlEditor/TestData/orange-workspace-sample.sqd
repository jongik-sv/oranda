[HEADER]
VERSION=5.0.12
TOOL=
CHAR=ASCII
DATE=2024-01-15 09:00
[WORKSPACE]
COUNT=8
NAME=주문 집계.sql
STMT=19
-- 기준일 이후 주문을 고객별로 집계한다
SELECT CUST_ID 고객, ORD_DT 주문일, COUNT(*) 건수, SUM(AMT) 금액
FROM (
        SELECT O.CUST_ID, O.ORD_DT, O.ORD_NO, O.AMT, O.STATUS_CD,
	           CASE
                   WHEN O.STATUS_CD IN ('10', '20') THEN '진행'
	               WHEN O.STATUS_CD LIKE '9%' THEN '취소'
                   ELSE '완료'
	           END 상태
        FROM   APP_USER.TB_ORDER O
	    WHERE  O.ORD_DT >= :기준일
        AND    O.CUST_ID IN (SELECT CUST_ID
	                           FROM APP_USER.TB_CUSTOMER
                              WHERE MGR_NM = :담당자
	                            AND DEPT_CD = :부서)
     ) T
WHERE  T.상태 <> '취소'
GROUP  BY CUST_ID, ORD_DT
ORDER  BY ORD_DT DESC, CUST_ID
VAR=3
:기준일=0,
:담당자=0,
:부서=0,
NAME=재고 현황(요약).sql
STMT=9
SELECT W.WH_CD, W.ITEM_CD, I.ITEM_NM,
       SUM(W.QTY)                      재고수량,
       SUM(W.QTY * I.UNIT_PRC)         재고금액
FROM   APP_USER.TB_STOCK W
       JOIN APP_USER.TB_ITEM I ON I.ITEM_CD = W.ITEM_CD
WHERE  W.QTY > 0
GROUP  BY W.WH_CD, W.ITEM_CD, I.ITEM_NM
HAVING SUM(W.QTY) > 10
ORDER  BY 5 DESC
VAR=0
NAME=주문이력
STMT=4
SELECT H.ORD_NO, H.SEQ, H.CHG_DT, H.CHG_TYPE, H.CHG_USER
FROM   APP_USER.TB_ORDER_HIST H
WHERE  H.ORD_NO = 'ORD0001'
ORDER  BY H.SEQ
VAR=0
NAME=1001
STMT=45
SELECT E.EMP_ID, E.EMP_NM, E.DEPT_CD,
       D.DEPT_NM,
       E.COL_01,
       E.COL_02,
       E.COL_03,
       E.COL_04,
       E.COL_05,
       E.COL_06,
       E.COL_07,
       E.COL_08,
       E.COL_09,
       E.COL_10,
       E.COL_11,
       E.COL_12,
       E.COL_13,
       E.COL_14,
       E.COL_15,
       E.COL_16,
       E.COL_17,
       E.COL_18,
       E.COL_19,
       E.COL_20,
       E.COL_21,
       E.COL_22,
       E.COL_23,
       E.COL_24,
       E.COL_25,
       E.COL_26,
       E.COL_27,
       E.COL_28,
       E.COL_29,
       E.COL_30,
       E.COL_31,
       E.COL_32,
       E.COL_33,
       E.COL_34,
       E.COL_35,
       E.COL_36,
       E.COL_37,
       E.COL_38,
       E.COL_39,
       E.COL_40
FROM   HR.TB_EMP E
       LEFT JOIN HR.TB_DEPT D ON D.DEPT_CD = E.DEPT_CD
WHERE  E.USE_YN = 'Y'
VAR=0
NAME=고객 정리
STMT=4
SELECT C.CUST_ID, C.CUST_NM, C.LAST_ORD_DT
FROM   APP_USER.TB_CUSTOMER C
WHERE  C.LAST_ORD_DT < ADD_MONTHS(SYSDATE, -36)
AND    NOT EXISTS (SELECT 1 FROM APP_USER.TB_ORDER O WHERE O.CUST_ID = C.CUST_ID)
VAR=0
NAME=SQL2
STMT=4
SELECT OBJECT_NAME, OBJECT_TYPE, STATUS
FROM   ALL_OBJECTS
WHERE  OWNER = 'APP_USER'
AND    OBJECT_ID = :ObjectId
VAR=1
:ObjectId=0,
NAME=일일 보고
STMT=4
SELECT TRUNC(O.ORD_DT) 일자, O.CUST_ID, COUNT(*) 건수
FROM   APP_USER.TB_ORDER O
WHERE  TO_CHAR(O.ORD_DT, 'YYYY-MM-DD') = :REPORT_DT
GROUP  BY TRUNC(O.ORD_DT), O.CUST_ID
VAR=1
:REPORT_DT=0,2024-01-15
NAME=SQL3
STMT=3
SELECT S.SALE_NO, S.SALE_DT, S.AMT
FROM   SALES.TB_SALE S
WHERE  S.SALE_DT BETWEEN TO_DATE(:FROM_DT, 'YYYYMMDD') AND TO_DATE(:TO_DT, 'YYYYMMDD')
VAR=2
:FROM_DT=0,20240101
:TO_DT=0,20240131
