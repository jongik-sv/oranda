NAME=라인길이 계산 공정.sql
STMT=35
SELECT PROC_CD 공정, COIL_ID 코일ID, LN_SPD  "L/S", 작업시간, COIL_THY_LTH  이론길이, 수정작업시간 계산작업시간
FROM ( 
        select  A.PROC_CD, A.ord_no, A.ord_ln, A.MTL_CD, A.coil_id, A.COIL_WGT, A.COIL_WTH, A.MTL_COIL_WTH, A.COIL_LTH, A.COIL_LTH1, 
                COIL_THY_LTH, A.LN_SPD, 
                A.coil_wk_tim 작업시간,  
                CASE  
                    WHEN  (A.PROC_CD IN ('74', '76', '77') OR A.PROC_CD LIKE '6%') AND MOD(A.MTL_COIL_WTH, A.COIL_WTH) < 100 THEN 
                        ROUND(COIL_LTH / ROUND(MTL_COIL_WTH / A.COIL_WTH) / A.LN_SPD, 1) 
                    WHEN  (A.PROC_CD IN ('74', '76', '77') OR A.PROC_CD LIKE '6%') AND MOD(A.MTL_COIL_WTH, A.COIL_WTH) >= 100 THEN 
                        ROUND(COIL_LTH / (MTL_COIL_WTH / A.COIL_WTH) / A.LN_SPD, 1) 
                    ELSE ROUND(A.COIL_LTH / A.LN_SPD, 1)  
                END 수정작업시간 
        from   (select  A.PROC_CD, A.ord_no, A.ord_ln, A.MTL_CD, A.coil_id, A.COIL_WGT, A.COIL_WTH, B.MTL_COIL_WTH,  
                        CASE  
                            WHEN A.PROC_CD LIKE 'A%' AND IN_LN_SHR_WK_YN = 'Y' THEN -1 
                            ELSE A.COIL_LTH 
                        END COIL_LTH, 
                        A.COIL_LTH COIL_LTH1, 
                        A.COIL_THY_LTH, 
                        A.LN_SPD, 
                        A.coil_wk_tim 
                         
                from    mesapuser.tb_m47_prd_act_cmn A, mesapuser.TB_M47_WK_ACT_CMN B 
                where   A.PDN_PST_DD BETWEEN to_char(sysdate - 36, 'yyyymmdd') AND to_char(sysdate, 'yyyymmdd') 
                AND     A.PCOIL_ID = B.COIL_ID 
                AND     A.PROC_CD = B.PROC_CD 
                AND     A.MTL_CD NOT IN ('HZ000001') 
 
                AND     (SUBSTR(A.PROC_CD, 1, 1) IN ('3', '5', '6', '7', '9', 'A') OR A.PROC_CD = '82') 
                AND     SUBSTR(A.PROC_CD, 2, 1) NOT IN ('O', 'I') 
                ) A 
        ) 
WHERE  COIL_LTH != -1 -- CCL INLINE은 SHL 작업시간 적용 
AND   (DECODE(수정작업시간, 0, 0.1, 수정작업시간) not between 작업시간 * 0.8 and 작업시간 * 1.2 OR     작업시간 > 200 ) 
ORDER BY COIL_ID;
VAR=3
:작업시간=0,
:하영재=0,
:문종배=0,
NAME=작업시간(휴지).sql
STMT=84
WITH   PAU AS 
(
    SELECT PROC_CD, PAU_STR_DH, PAU_END_DH
    FROM   MESAPUSER.TB_M47_PAU_ACT 
    WHERE  PAU_PST_DD  BETWEEN TO_CHAR(SYSDATE - 36, 'YYYYMMDD') AND TO_CHAR(SYSDATE, 'YYYYMMDD')
    AND    PROC_CD IN ('1P', '83', '84', '85')
)
,
PRD AS 
(
    SELECT  A.PROC_CD, A.ORD_NO, A.ORD_LN, A.COIL_ID, A.COIL_WGT, 
            A.WK_STR_DH, A.WK_END_DH, A.COIL_WK_TIM,   
            NVL((SELECT MAX(1) FROM PAU 
                 WHERE  PROC_CD    = A.PROC_CD 
                 AND    (   PAU_STR_DH BETWEEN A.WK_STR_DH AND A.WK_END_DH)),0) PAU_FLAG1,
            NVL((SELECT MAX(1) FROM PAU 
                 WHERE  PROC_CD    = A.PROC_CD 
                 AND    (   PAU_END_DH BETWEEN A.WK_STR_DH AND A.WK_END_DH)),0) PAU_FLAG2
                 
    FROM    MESAPUSER.TB_M47_PRD_ACT_CMN A
    WHERE   A.PDN_PST_DD BETWEEN TO_CHAR(SYSDATE - 36, 'YYYYMMDD') AND TO_CHAR(SYSDATE, 'YYYYMMDD') 
    AND     A.PROC_CD IN ('1P', '83', '84', '85')
)
--SELECT PROC_CD || '-' || COIL_ID || ', 작업시간(현재) : ' || TO_CHAR(COIL_WK_TIM, '90.99')  || ', (실제)' || TO_CHAR(REAL_WORK_TIM, '90.99') ERR
SELECT PROC_CD 공정, COIL_ID 코일ID, COIL_WGT, COIL_WK_TIM 현재작업시간, REAL_WORK_TIM "재계산된 작업시간"
FROM (
        SELECT  PROC_CD, ORD_NO, ORD_LN, COIL_ID, COIL_WGT, 
                WK_STR_DH, WK_END_DH, COIL_WK_TIM, PAU_FLAG1, PAU_FLAG2,
                CASE WHEN PAU_FLAG1 + PAU_FLAG2 != 0 THEN MESAPUSER.FUNC_REAL_PRD_TIM(WK_STR_DH, WK_END_DH, PROC_CD)
                     ELSE (WK_END_DH - WK_STR_DH) * 24 * 60 END AS REAL_WORK_TIM
        FROM    PRD
     )
WHERE  COIL_WK_TIM NOT BETWEEN DECODE(REAL_WORK_TIM,0,0.1,REAL_WORK_TIM) * 0.8 AND DECODE(REAL_WORK_TIM,0,0.1,REAL_WORK_TIM) * 1.2 
OR     COIL_WK_TIM > 200 
ORDER BY PROC_CD, COIL_ID;




/*+ M473030030 작업시간(휴지)조회 M473030030.select.workTim_pau */ 
WITH   PAU AS 
(
    SELECT PROC_CD, PAU_STR_DH, PAU_END_DH
    FROM   MESAPUSER.TB_M47_PAU_ACT 
    WHERE  PAU_PST_DD  BETWEEN '20230801' AND '20230831'
    AND    PROC_CD IN ('1P', '83', '84', '85')
)
,
PRD AS 
(
    SELECT  A.PROC_CD, A.ORD_NO, A.ORD_LN, A.COIL_ID, A.COIL_WGT, 
            A.WK_STR_DH, A.WK_END_DH, A.COIL_WK_TIM,   
            NVL((SELECT MAX(1) FROM PAU 
                 WHERE  PROC_CD    = A.PROC_CD 
                 AND    (   PAU_STR_DH BETWEEN A.WK_STR_DH AND A.WK_END_DH)),0) PAU_FLAG1,
            NVL((SELECT MAX(1) FROM PAU 
                 WHERE  PROC_CD    = A.PROC_CD 
                 AND    (   PAU_END_DH BETWEEN A.WK_STR_DH AND A.WK_END_DH)),0) PAU_FLAG2
                 
    FROM    MESAPUSER.TB_M47_PRD_ACT_CMN A
    WHERE   A.PDN_PST_DD BETWEEN '20230801' AND '20230831'
    AND     A.PROC_CD IN ('1P', '83', '84', '85')
)
--SELECT PROC_CD || '-' || COIL_ID || ', 작업시간(현재) : ' || TO_CHAR(COIL_WK_TIM, '90.99')  || ', (실제)' || TO_CHAR(REAL_WORK_TIM, '90.99') ERR
SELECT PROC_CD, COIL_ID, COIL_WGT, COIL_WK_TIM, REAL_WORK_TIM
        , TO_CHAR(WK_STR_DH, 'YYYY-MM-DD HH24:MI:SS') AS WK_STR_DH
        , TO_CHAR(WK_END_DH, 'YYYY-MM-DD HH24:MI:SS') AS WK_END_DH
        , TO_CHAR(PAU_STR_DH, 'YYYY-MM-DD HH24:MI:SS') AS PAU_STR_DH
        , TO_CHAR(PAU_END_DH, 'YYYY-MM-DD HH24:MI:SS') AS PAU_END_DH
FROM (
        SELECT  PROC_CD, ORD_NO, ORD_LN, COIL_ID, COIL_WGT, 
                WK_STR_DH, WK_END_DH, COIL_WK_TIM, PAU_FLAG1, PAU_FLAG2,
                CASE WHEN PAU_FLAG1 + PAU_FLAG2 != 0 THEN MESAPUSER.FUNC_REAL_PRD_TIM(WK_STR_DH, WK_END_DH, PROC_CD)
                     ELSE (WK_END_DH - WK_STR_DH) * 24 * 60 END AS REAL_WORK_TIM,
                DECODE(PAU_FLAG1, 1, ( SELECT MAX(PAU_STR_DH) FROM PAU WHERE PROC_CD = PRD.PROC_CD
                                       AND    ( PAU_STR_DH BETWEEN PRD.WK_STR_DH AND PRD.WK_END_DH)), NULL) AS PAU_STR_DH,
                DECODE(PAU_FLAG2, 1, ( SELECT MAX(PAU_END_DH) FROM PAU WHERE PROC_CD = PRD.PROC_CD
                                       AND    ( PAU_END_DH BETWEEN PRD.WK_STR_DH AND PRD.WK_END_DH)), NULL) AS PAU_END_DH
        FROM    PRD
     )
WHERE	PROC_CD LIKE '%'  
AND		(COIL_WK_TIM NOT BETWEEN DECODE(REAL_WORK_TIM,0,0.1,REAL_WORK_TIM) * '0.8' AND DECODE(REAL_WORK_TIM,0,0.1,REAL_WORK_TIM) * '1.2' 
OR     COIL_WK_TIM > '200')
ORDER BY PROC_CD, COIL_ID
VAR=0
NAME=코일이력
STMT=60
with rmt_coil_id as
                (
                    select coil_id rmt_coil_id from tb_m42_master
                    where  rmtl_no in (
                                        select rmtl_no from tb_m47_coil_cmn --as of timestamp(sysdate - 6/24)
                                        where  coil_id = 'E6QA80L')
                ),
                
/*
CBL004M
CBL006G
CBR0088
CBS000B
CBV0059
*/
 coil_ids as
                (
                    select coil_id 
                    from   tb_m47_coil_id_hst
                    where  fr_coil_id = (select rmt_coil_id from rmt_coil_id)
                )
                select level level1, -- decode(level, 1, '*', lpad('   ', level*2) || 'ㄴ') indet, 
                        pcoil_id_h, 
                        rmtl_no,
                        ord_no,
                        decode(level, 1, coil_id_h) coil_id_1,
                        decode(level, 2, coil_id_h) coil_id_2,
                        decode(level, 3, coil_id_h) coil_id_3,
                        decode(level, 4, coil_id_h) coil_id_4,
                        decode(level, 5, coil_id_h) coil_id_5,
                        decode(level, 6, coil_id_h) coil_id_6,
                        decode(level, 7, coil_id_h) coil_id_7,
                        decode(level, 8, coil_id_h) coil_id_8,
                        decode(level, 9, coil_id_h) coil_id_9,
                        decode(level, 10, coil_id_h) coil_id_10,
--                        decode(level, 11, coil_id_h) coil_id_11, 
--                        decode(level, 12, coil_id_h) coil_id_12,
--                        decode(level, 13, coil_id_h) coil_id_13,
--                        decode(level, 14, coil_id_h) coil_id_14,
--                        decode(level, 15, coil_id_h) coil_id_15,
--                        
--                        decode(level, 16, coil_id_h) coil_id_16,
--                        decode(level, 17, coil_id_h) coil_id_17,
--                        decode(level, 18, coil_id_h) coil_id_18,
--                        decode(level, 19, coil_id_h) coil_id_19, 
--                        decode(level, 20, coil_id_h) coil_id_20,
                        coil_id_h, coil_wgt_1 coil_wgt, COIL_AW1,rmtl_aw_1 rmtl_aw, coil_wth, REQ_TST_PIC_ID, mo_no, 
                        a.proc_cd, op_grd, a.coil_inf_crt_tp, PASS_BOD_MTL_AW, CREATION_TIMESTAMP   --, a.*
                from  ( select  nvl(b.pcoil_id, a.pcoil_id) pcoil_id_h, nvl(b.coil_id, a.coil_id) coil_id_h,
                                nvl(b.coil_wgt, a.coil_wgt) coil_wgt_1, nvl(b.rmtl_aw, a.rmtl_aw) rmtl_aw_1, A.COIL_AW COIL_AW1, a.* 
                        from tb_m47_coil_cmn a, (select * 
                                                 from   tb_m47_prd_act_cmn 
                                                 where  coil_id != pcoil_id
                                                 and    coil_id in (select coil_id from coil_ids)) b
                        where  a.coil_id = b.coil_id (+)
                        and    a.coil_id in (select coil_id from coil_ids)
                        order by coil_inf_crt_tp desc) a
                connect by prior coil_id_h = pcoil_id_h
                start with coil_id = (select rmt_coil_id from rmt_coil_id)
                ;
