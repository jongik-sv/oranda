<Project Sdk="Microsoft.NET.Sdk">

  <!--
    실제 DB 시험(컨테이너 26ai, 사내 19c, ADB)은 [Trait("Category", "Integration")] 를 붙인다.
    컨테이너 없이 돌릴 때: dotnet test Oranda.sln -filter "Category!=Integration"
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <!-- 기본 실행에서는 컨테이너가 필요한 시험을 뺀다. 돌릴 때는 dotnet test 의 filter 옵션에 Category=Integration (명령줄 필터가 이 값을 덮어쓴다). -->
    <VSTestTestCaseFilter>Category!=Integration&amp;Category!=Perf</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.Oracle" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oranda.Oracle\Oranda.Oracle.csproj" />
    <ProjectReference Include="..\..\src\Oranda.Language\Oranda.Language.csproj" />
  </ItemGroup>

</Project>
