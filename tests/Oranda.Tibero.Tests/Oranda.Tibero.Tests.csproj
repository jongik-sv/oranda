<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Oranda.Tibero 의 단위 시험. 드라이버·서버 없이 도는 것만 둔다.
    서버가 필요한 시험은 [Trait("Category", "Integration")] 를 붙이고 TiberoItEnv.Skip() 으로 시작한다:
    ORANDA_IT_TIBERO_* 환경 변수가 없으면 아무것도 하지 않고, ORANDA_IT_REQUIRE=1 이면 실패한다.
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oranda.Tibero\Oranda.Tibero.csproj" />
    <!-- 합친 카탈로그 시험(Oracle 원문 + Tibero 원문)에만 쓴다. -->
    <ProjectReference Include="..\..\src\Oranda.Oracle\Oranda.Oracle.csproj" />
    <!-- 결과 편집(R4)이 쓰는 DBMS 무관 편집 계획·DML 생성이 Tibero 모양 결과 열에서 맞는지 확인한다. -->
    <ProjectReference Include="..\..\src\Oranda.Language\Oranda.Language.csproj" />
    <!-- 가져오기·내보내기 서비스(T5) 시험이 쓰는 가짜 실행 서비스·메타데이터·세션. -->
    <ProjectReference Include="..\Oranda.Testing\Oranda.Testing.csproj" />
    <!-- 가짜 드라이버는 빌드만 하고 출력 하위 폴더(fake-driver/)에 둔다. 출력 루트에 두면 기본 로드 컨텍스트가 먼저 잡는다. -->
    <ProjectReference Include="..\Oranda.Tibero.FakeDriver\Oranda.Tibero.FakeDriver.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyFakeDriver" AfterTargets="Build">
    <MSBuild Projects="..\Oranda.Tibero.FakeDriver\Oranda.Tibero.FakeDriver.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FakeDriverDll" />
    </MSBuild>
    <Copy SourceFiles="@(FakeDriverDll)" DestinationFolder="$(OutDir)fake-driver" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

</Project>
