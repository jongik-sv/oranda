<Project>
  <!-- 모든 src/·tests/ 프로젝트 공통 빌드 설정 (TRD 10). 스파이크(spikes/)는 자체 Directory.Build.props 로 이 파일을 가린다. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- 버전 일괄 관리: MAJOR.MINOR.PATCH (+ CI 빌드 번호는 -p:Version 으로 덮어쓴다) -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>Oranda</Product>

    <!-- 공개 배포 메타(D-014, TSK-08-01). 저작권자 표기는 LICENSE 와 같게 둔다. -->
    <Authors>jongik-sv</Authors>
    <Copyright>Copyright (c) 2026 jongik-sv</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jongik-sv/oranda</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jongik-sv/oranda</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Tibero 드라이버(TDP.NET, Tibero.DataAccess)는 빌드에 넣지 않는다(D-046-1). 사용자가 설정에서 위치를 지정하고 Oranda.Tibero 가 실행 중에 읽는다
    (docs/design/tibero-driver-adapter.md). 그래서 드라이버용 피드·상수·발행 가드가 없다.
  -->
</Project>
