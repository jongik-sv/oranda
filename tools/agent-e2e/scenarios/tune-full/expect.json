{
  "about": "context→plan→stats/index/histogram→후보→bench→가장 빠른 것을 새 탭. 원래 탭은 그대로.",
  "order": [
    ["get_tuning_context", "get_cursor_plan", "explain_plan", "get_sql_stats"],
    ["get_table_stats", "get_index_info", "get_histogram", "get_tuning_context"],
    ["benchmark_queries"],
    ["new_tab"]
  ],
  "forbidden_tools": ["propose_edit", "save_tab", "run_command", "export_result"],
  "unchanged_tabs": ["t1", "t2"],
  "bench_min_variants": 2,
  "new_tab_regex": "(?is)ordered_at\\s*(>=|between)",
  "new_tab_not_regex": "(?is)to_char\\s*\\(\\s*(o\\.)?ordered_at",
  "answer_regex": ["(?i)ordered_at|to_char"]
}
