---
import { Image } from 'astro:assets';
import mainWindow from '../assets/landing/main-window.png';
import planCompare from '../assets/landing/plan-compare.png';
import lockMonitor from '../assets/landing/lock-monitor.png';
import mybatis from '../assets/landing/mybatis.png';
import { page, siteUrl } from '../lib/links';

const screens = [
  { href: page('editor/sql-editor/'), label: 'SQL 편집기', image: mainWindow, position: 'right top' },
  { href: page('plan/execution-plan/'), label: '실행 계획', image: planCompare, position: 'left top' },
  { href: page('tools/monitor/#lock-모니터'), label: 'Lock 모니터', image: lockMonitor, position: 'left top' },
  { href: page('editor/mybatis/'), label: 'MyBatis 매퍼', image: mybatis, position: 'left top' },
];

const frequent = [
  { href: page('plan/execution-plan/#계획-고정과-비교'), label: '계획을 고정해 지금 계획과 비교하기' },
  { href: page('tools/monitor/#lock-모니터'), label: '잠금을 보유한 세션 찾기' },
  { href: page('connect/manage/#환경-구분과-색'), label: '개발, 테스트, 운영 접속 구분하기' },
  { href: page('connect/manage/#가져오기와-내보내기-고르기-창'), label: '다른 도구의 접속 목록 가져오기' },
  { href: page('settings/shortcuts/#키맵-프리셋'), label: '단축키를 Orange 5 프리셋으로 바꾸기' },
  { href: page('transfer/data-transfer/'), label: '결과를 Excel이나 CSV로 내보내기' },
];

// 전체 목차는 사이드바와 같은 자료를 쓴다. 쪽을 더하거나 순서를 바꾸면 여기도 함께 바뀐다.
const chapters = Astro.locals.starlightRoute.sidebar.flatMap((entry) =>
  entry.type === 'group'
    ? [{ label: entry.label, links: entry.entries.flatMap((item) => (item.type === 'link' ? [item] : [])) }]
    : []
);
---

<div class="not-content manual-home">
  <section class="band first">
    <div class="wrap">
      <h2 class="oranda-display">처음 쓰신다면 이 순서로 읽으세요</h2>
      <ol class="steps">
        <li>
          <span class="number oranda-display" aria-hidden="true">1</span>
          <div>
            <a class="step-link" href={page('install/prerequisites/')}>사전 조건</a>
            <p>설치 전에 운영체제, 설치 파일, 접속 조건을 확인합니다.</p>
          </div>
        </li>
        <li>
          <span class="number oranda-display" aria-hidden="true">2</span>
          <div>
            <div class="step-links">
              <a class="step-link" href={page('install/windows/')}>Windows 설치</a>
              <a class="step-link" href={page('install/macos/')}>macOS 설치</a>
            </div>
            <p>쓰는 운영체제에 맞는 쪽만 읽습니다. 보안 경고를 처리하는 방법도 나옵니다.</p>
          </div>
        </li>
        <li>
          <span class="number oranda-display" aria-hidden="true">3</span>
          <div>
            <a class="step-link" href={page('connect/first-connection/')}>첫 접속</a>
            <p>접속을 만들어 Oracle 데이터베이스에 연결합니다.</p>
          </div>
        </li>
        <li>
          <span class="number oranda-display" aria-hidden="true">4</span>
          <div>
            <a class="step-link" href={page('run/execute/')}>SQL 실행</a>
            <p>SQL 문장과 스크립트를 실행합니다.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="oranda-display">기억나는 화면에서 찾기</h2>
      <div class="screens">
        {
          screens.map((screen) => (
            <a class="screen" href={screen.href}>
              <Image
                src={screen.image}
                widths={[640, screen.image.width]}
                sizes="(max-width: 640px) 100vw, 640px"
                alt=""
                style={`object-position: ${screen.position}`}
              />
              <span>{screen.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band tint">
    <div class="wrap">
      <h2 class="oranda-display">자주 찾는 내용</h2>
      <ul class="frequent">
        {frequent.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="oranda-display">전체 목차</h2>
      <div class="chapters">
        {
          chapters.map((chapter) => (
            <nav aria-label={chapter.label}>
              <h3>{chapter.label}</h3>
              <div class="chapter-links">
                {chapter.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
            </nav>
          ))
        }
      </div>
    </div>
  </section>

  <div class="closing wrap">
    <a href={siteUrl('')}>Oranda 소개</a>
    <a href="https://github.com/jongik-sv/oranda">GitHub</a>
  </div>
</div>

<style>
  .manual-home {
    --line: var(--sl-color-hairline);
    --muted: var(--sl-color-gray-2);
    --tint: #f3f3f3;
    --number: #d9481c;
    font-family: var(--oranda-body);
    line-height: 1.6;
    color: var(--sl-color-white);
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  :global(:root[data-theme='dark']) .manual-home {
    --tint: #1d2a2e;
    --number: #ff9468;
  }

  .manual-home a {
    color: var(--sl-color-text-accent);
  }

  .manual-home a:hover {
    color: var(--sl-color-white);
  }

  /* 목록과 화면 묶음은 줄 전체가 링크임이 분명하므로 밑줄을 마우스를 올렸을 때만 보인다. */
  .manual-home :is(.screen, .frequent a, .chapter-links a) {
    text-decoration: none;
  }

  .manual-home :is(.screen, .frequent a, .chapter-links a):hover {
    text-decoration: underline;
  }

  .manual-home a:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  .wrap {
    width: 100%;
    max-width: 82.5rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    box-sizing: border-box;
  }

  .band {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .band.first {
    padding-bottom: 0;
  }

  .tint {
    background: var(--tint);
  }

  h2 {
    margin: 0 0 1.5rem;
    color: var(--sl-color-white);
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.25;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15.5rem, 100%), 1fr));
    gap: 1.75rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    gap: 0.875rem;
  }

  .number {
    font-size: 2.75rem;
    line-height: 1;
    color: var(--number);
  }

  .step-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.875rem;
  }

  .step-link {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .steps p {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .screens {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16.25rem, 100%), 1fr));
    gap: 1.75rem 1.5rem;
  }

  .screen {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .screen img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 8px;
    box-sizing: border-box;
  }

  .frequent {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(21.25rem, 100%), 1fr));
    gap: 0.25rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frequent a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.0625rem;
  }

  .chapters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15.5rem, 100%), 1fr));
    gap: 2rem 2.5rem;
  }

  h3 {
    margin: 0 0 0.375rem;
    color: var(--sl-color-white);
    font-size: 1.125rem;
  }

  .chapter-links {
    display: flex;
    flex-direction: column;
  }

  .chapter-links a {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
  }

  .closing {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding-block: 1rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .closing a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
