<Project Sdk="Microsoft.NET.Sdk">

  <!-- ODP.NET 기반 구현: 접속·점검·실행·메타데이터·모니터링, SQL 카탈로그 리소스. -->

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- SQL 카탈로그 자동 수집(TSK-02-04, docs/design/catalog.md). 기능 Task 는 Catalog/<폴더>/ 에 .sql 만 더한다. -->
  <ItemGroup>
    <EmbeddedResource Include="Catalog\**\*.sql" LogicalName="Catalog/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oranda.Core\Oranda.Core.csproj" />
  </ItemGroup>

</Project>
