<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 게시본 시작 단축 (TSK-01-04): Windows self-contained 게시는 ReadyToRun composite.
       일반 R2R 대비 입력 가능까지 −0.5~0.6 s, 게시 폴더 +30 MB. composite 는 self-contained 에서만 동작한다.
       macOS 는 측정 전이라 일반 R2R(CI 의 -p:PublishReadyToRun=true) 그대로 둔다. 트리밍은 시간 효과가 없어 쓰지 않는다. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $(RuntimeIdentifier.StartsWith('win-')) And '$(SelfContained)' == 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 명령 제목 한국어 기본값(docs/design/commands.md 7장 제목 열). 한국어 표. 영어 짝은 CommandTitles-en.json(TSK-10-02). StringCatalog 가 읽는다. -->
  <ItemGroup>
    <EmbeddedResource Include="Shell\Resources\CommandTitles.json" LogicalName="Oranda.App.Resources.CommandTitles.json" />
    <EmbeddedResource Include="Shell\Resources\CommandTitles-en.json" LogicalName="Oranda.App.Resources.CommandTitles-en.json" />
  </ItemGroup>

  <!-- 키맵 프리셋 4종(TSK-02-05): 정본 docs/design/keymaps/*.json 을 복사하지 않고 링크해 임베디드 리소스로 넣는다. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\design\keymaps\*.json"
                      Link="Shell\Keymaps\Presets\%(Filename)%(Extension)"
                      LogicalName="Oranda.App.Keymaps.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 화면 글자 한/영 리소스(TSK-10-02). 키 집합이 같아야 한다(LocalizationTests). 파일 이름에 점+언어(Strings.ko.json)를 쓰면 SDK 가 위성 어셈블리로 만들어 버려서 strings-ko.json 으로 둔다. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\strings-*.json" LogicalName="Oranda.App.%(Filename)%(Extension)" />
    <!-- XAML 에 한국어로 적힌 글자의 영어 짝(LiteralTranslator). -->
    <EmbeddedResource Include="Resources\literals-en.json" LogicalName="Oranda.App.literals-en.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oranda.Core\Oranda.Core.csproj" />
    <ProjectReference Include="..\Oranda.Language\Oranda.Language.csproj" />
    <ProjectReference Include="..\Oranda.Oracle\Oranda.Oracle.csproj" />
    <ProjectReference Include="..\Oranda.Platform\Oranda.Platform.csproj" />
  </ItemGroup>
</Project>
