<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\oranda.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 화면 언어는 한/영뿐이다. 패키지 위성 리소스(AvaloniaEdit zh-Hans 등)는 넣지 않는다(TSK-08-07). -->
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Windows self-contained 게시는 일반 ReadyToRun (D-034, TSK-10-08). composite 는 Microsoft·Oracle 이 서명한 dll 까지 다시 컴파일해
       서명을 지운다(exe·dll 254개 중 무서명 236개). 일반 R2R 은 이미 R2R 인 런타임 dll 을 건너뛰어 서명이 남는다.
       대가: 입력 가능까지 약 +0.5~0.6 s(추정. D-006 은 모든 dll 을 R2R 로 컴파일한 일반 R2R 을 쟀고, 이 구성은 Windows 에서 재지 않았다).
       설치 파일은 99 → 80 MB(80,016,283 bytes)로 줄어 80 MB 목표(TSK-10-06, 83,886,080 bytes)를 맞춘다.
       트리밍은 시간 효과가 없어 쓰지 않는다. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $(RuntimeIdentifier.StartsWith('win-')) And '$(SelfContained)' == 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <!-- 원래 Authenticode 서명이 있는 패키지 dll 은 R2R 로 다시 컴파일하지 않는다(다시 쓰면 서명이 사라진다). 그러면 무서명은
       Oranda 와 원래 서명이 없는 패키지(Avalonia·Dock·SQLitePCLRaw·Velopack 등) 51개만 남는다.
       패키지를 더하면 R2R 을 끈 게시본(-p:PublishReadyToRun=false)과 서명 수를 비교해 이 목록을 고친다(scripts/release/README.md 「코드 서명」). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PublishReadyToRunExclude Include="CommunityToolkit.Mvvm.dll" />
    <PublishReadyToRunExclude Include="HarfBuzzSharp.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Data.Sqlite.dll" />
    <PublishReadyToRunExclude Include="Oracle.ManagedDataAccess.dll" />
    <PublishReadyToRunExclude Include="SkiaSharp.dll" />
    <PublishReadyToRunExclude Include="System.Configuration.ConfigurationManager.dll" />
    <PublishReadyToRunExclude Include="System.Diagnostics.EventLog.dll" />
    <PublishReadyToRunExclude Include="System.Diagnostics.PerformanceCounter.dll" />
    <PublishReadyToRunExclude Include="System.DirectoryServices.Protocols.dll" />
    <PublishReadyToRunExclude Include="System.Security.Cryptography.Pkcs.dll" />
    <PublishReadyToRunExclude Include="System.Security.Cryptography.ProtectedData.dll" />
  </ItemGroup>

  <!-- 게시본에는 PDB 를 넣지 않는다 (TSK-10-06). win-x64 게시 폴더 301 MB 중 103 MB 가 PDB 였다(SkiaSharp·HarfBuzz 네이티브 PDB 100 MB).
       DebugType 은 빌드 출력의 PDB 까지 없애 개발 디버깅을 막고, 패키지가 넣는 네이티브 PDB 는 빼지 못하므로 게시 목록에서만 뺀다.
       vpk pack 도 기본으로 *.pdb 를 빼므로 설치본은 원래 PDB 가 없었다. -->
  <Target Name="ExcludePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- Windows 설치본에서 실행에 쓰지 않는 런타임 파일을 뺀다(TSK-08-07, 설치 파일 80 MB 이하 = PRD 7.2, 줄이기 전 83,939,374 bytes).
       디버거·덤프 전용: mscordaccore·mscordbi(디버거 연결), DiaSymReader(Windows PDB 읽기), createdump(DOTNET_DbgEnableMiniDump 때만).
       충돌 보고는 예외 글로 남기므로(CrashReportWriter) 덤프 도구가 필요 없다. 독립 GC clrgc·clrgcexp 는 GCName 설정 때만 읽는다.
       런타임 팩 자산을 푼 바로 뒤에 빼야 빌드 출력·게시 목록·deps.json 에서 함께 빠진다. -->
  <Target Name="ExcludeDebugOnlyRuntimeFiles" AfterTargets="ResolveRuntimePackAssets"
          Condition="$(RuntimeIdentifier.StartsWith('win-')) And '$(SelfContained)' == 'true'">
    <PropertyGroup>
      <_OrandaDebugOnlyPattern>^(mscordaccore.*\.dll|mscordbi\.dll|Microsoft\.DiaSymReader\.Native\..*\.dll|createdump\.exe|clrgc(exp)?\.dll)$</_OrandaDebugOnlyPattern>
    </PropertyGroup>
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(_OrandaDebugOnlyPattern)'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(_OrandaDebugOnlyPattern)'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 명령 제목 한국어 기본값(docs/design/commands.md 7장 제목 열). 한국어 표. 영어 짝은 CommandTitles-en.json(TSK-10-02). StringCatalog 가 읽는다. -->
  <ItemGroup>
    <EmbeddedResource Include="Shell\Resources\CommandTitles.json" LogicalName="Oranda.App.Resources.CommandTitles.json" />
    <EmbeddedResource Include="Shell\Resources\CommandTitles-en.json" LogicalName="Oranda.App.Resources.CommandTitles-en.json" />
  </ItemGroup>

  <!-- 키맵 프리셋 4종(TSK-02-05): 정본 docs/design/keymaps/*.json 을 복사하지 않고 링크해 임베디드 리소스로 넣는다. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\design\keymaps\*.json"
                      Link="Shell\Keymaps\Presets\%(Filename)%(Extension)"
                      LogicalName="Oranda.App.Keymaps.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 릴리스 노트(도움말 > 새 기능): 정본 docs/release-notes/<버전>.md 를 복사하지 않고 링크해 임베디드 리소스로 넣는다. 파일이 늘면 빌드만으로 따라 들어간다. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\release-notes\*.md"
                      Link="Features\Update\ReleaseNotes\%(Filename)%(Extension)"
                      LogicalName="Oranda.App.ReleaseNotes.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 화면 글자 한/영 리소스(TSK-10-02). 키 집합이 같아야 한다(LocalizationTests). 파일 이름에 점+언어(Strings.ko.json)를 쓰면 SDK 가 위성 어셈블리로 만들어 버려서 strings-ko.json 으로 둔다. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\strings-*.json" LogicalName="Oranda.App.%(Filename)%(Extension)" />
    <!-- XAML 에 한국어로 적힌 글자의 영어 짝(LiteralTranslator). -->
    <EmbeddedResource Include="Resources\literals-en.json" LogicalName="Oranda.App.literals-en.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- 빌드 때 -p:OrandaUpdateFeed=<주소> 를 주면 업데이트 피드 기본값으로 박힌다(설정의 주소가 비었을 때 쓴다). 비우면 「피드 없음」. -->
  <ItemGroup Condition="'$(OrandaUpdateFeed)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OrandaUpdateFeed</_Parameter1>
      <_Parameter2>$(OrandaUpdateFeed)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oranda.Core\Oranda.Core.csproj" />
    <ProjectReference Include="..\Oranda.Language\Oranda.Language.csproj" />
    <ProjectReference Include="..\Oranda.Oracle\Oranda.Oracle.csproj" />
    <ProjectReference Include="..\Oranda.Platform\Oranda.Platform.csproj" />
    <!-- orandactl(MCP 서버)은 앱이 코드로 참조하지 않는다. 빌드 순서와 출력 위치만 받아 앱 출력의 orandactl\ 폴더로 복사한다. -->
    <ProjectReference Include="..\Oranda.Agent.Cli\Oranda.Agent.Cli.csproj" ReferenceOutputAssembly="false" OutputItemType="OrandactlOutput" />
  </ItemGroup>

  <Target Name="CopyOrandactlToOutput" AfterTargets="Build" Condition="'@(OrandactlOutput)' != ''">
    <ItemGroup>
      <_OrandactlFile Include="%(OrandactlOutput.RootDir)%(OrandactlOutput.Directory)*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OrandactlFile)" DestinationFolder="$(OutDir)orandactl" SkipUnchangedFiles="true" />
  </Target>
</Project>
