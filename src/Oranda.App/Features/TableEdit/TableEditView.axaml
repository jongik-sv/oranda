<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:te="using:Oranda.App.Features.TableEdit"
             x:Class="Oranda.App.Features.TableEdit.TableEditView"
             x:DataType="te:TableEditSession">
  <!-- 객체 상세 편집 모드의 편집 표(테이블 편집기 설계 7.2~7.4, 시안 화면 0 A·③·④). 바뀐 칸 노랑 · 새 줄 초록 · 지울 줄 빨강 줄긋기.
       칸 글은 칸을 벗어날 때 모델에 들어가고(LostFocus), 그때 아래 DDL 이 다시 만들어진다. -->
  <UserControl.Styles>
    <Style Selector="TextBox.cell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.cell.changed">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
    </Style>
    <Style Selector="AutoCompleteBox.cell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="AutoCompleteBox.cell.changed">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
    </Style>
    <Style Selector="CheckBox.cell.changed">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
    </Style>
    <Style Selector="Border.row.added">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffAddedBrush}" />
    </Style>
    <Style Selector="Border.row.dropped">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffRemovedBrush}" />
    </Style>
    <Style Selector="Border.row.locked">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.head TextBlock">
      <Setter Property="Margin" Value="4,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.edit-rows ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- 특수 테이블(임시·외부·IOT·클러스터): 열 주석·기본값만(설계 3장). -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar" IsVisible="{Binding IsRestricted}">
      <TextBlock x:Name="RestrictionText" Text="{Binding RestrictionText}" Margin="4,0" TextWrapping="Wrap" />
    </Border>
    <Panel>
      <!-- 열 페이지(설계 7.2): # · 이름 · 형식 · 길이 · 소수 · NULL · 기본값 · 가상 식 · 주석 -->
      <DockPanel IsVisible="{Binding IsColumnsPage}">
        <Border DockPanel.Dock="Top" Classes="head" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OrandaSeparatorBrush}">
          <Grid ColumnDefinitions="18,34,150,140,56,46,44,120,170,*">
            <TextBlock Grid.Column="1" Text="#" />
            <TextBlock Grid.Column="2" Text="이름" />
            <TextBlock Grid.Column="3" Text="형식" />
            <TextBlock Grid.Column="4" Text="길이" />
            <TextBlock Grid.Column="5" Text="소수" />
            <TextBlock Grid.Column="6" Text="NULL" />
            <TextBlock Grid.Column="7" Text="기본값" />
            <TextBlock Grid.Column="8" Text="가상 식" />
            <TextBlock Grid.Column="9" Text="주석" />
          </Grid>
        </Border>
        <ListBox x:Name="ColumnRows" Classes="edit-rows" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                 AutomationProperties.Name="열 편집 표">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="te:ColumnRowViewModel">
              <Border Classes="row" Classes.added="{Binding IsAdded}" Classes.dropped="{Binding IsDropped}" ToolTip.Tip="{Binding Error}">
                <Panel>
                  <Grid ColumnDefinitions="18,34,150,140,56,46,44,120,170,*">
                    <TextBlock Grid.Column="0" Text="{Binding StateMark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding PositionText}" Margin="4,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Classes="cell" Classes.changed="{Binding IsNameChanged}" IsEnabled="{Binding CanEditName}"
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="이름" />
                    <AutoCompleteBox Grid.Column="3" Classes="cell" Classes.changed="{Binding IsTypeChanged}" IsEnabled="{Binding CanEditType}"
                                     ItemsSource="{Binding Session.TypeNames}" FilterMode="StartsWithOrdinal" MinimumPrefixLength="0"
                                     Text="{Binding DataType, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="형식" />
                    <TextBox Grid.Column="4" Classes="cell" Classes.changed="{Binding IsTypeChanged}" IsEnabled="{Binding CanEditLength}"
                             Text="{Binding LengthText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="길이" />
                    <TextBox Grid.Column="5" Classes="cell" Classes.changed="{Binding IsTypeChanged}" IsEnabled="{Binding CanEditScale}"
                             Text="{Binding ScaleText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="소수" />
                    <CheckBox Grid.Column="6" Classes="cell" Classes.changed="{Binding IsNullableChanged}" IsEnabled="{Binding CanEditLength}"
                              IsChecked="{Binding IsNullable}" HorizontalAlignment="Center" AutomationProperties.Name="NULL" />
                    <TextBox Grid.Column="7" Classes="cell" Classes.changed="{Binding IsDefaultChanged}" IsEnabled="{Binding CanEditDefault}"
                             Text="{Binding DefaultValue, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="기본값" />
                    <TextBox Grid.Column="8" Classes="cell" Classes.changed="{Binding IsVirtualChanged}" IsEnabled="{Binding CanEditVirtual}"
                             Text="{Binding VirtualExpression, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="가상 식" />
                    <TextBox Grid.Column="9" Classes="cell" Classes.changed="{Binding IsCommentChanged}" IsEnabled="{Binding CanEditComment}"
                             Text="{Binding Comment, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="주석" />
                  </Grid>
                  <Rectangle Height="1" Fill="{DynamicResource OrandaIconRedBrush}" VerticalAlignment="Center" IsVisible="{Binding IsDropped}" IsHitTestVisible="False" />
                </Panel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- 제약 페이지(설계 7.3, 시안 ③): 이름 · 종류 · 열 · 참조 · 삭제 규칙 · 조건 · 사용 -->
      <DockPanel IsVisible="{Binding IsConstraintsPage}">
        <Border DockPanel.Dock="Top" Classes="head" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OrandaSeparatorBrush}">
          <Grid ColumnDefinitions="18,190,56,170,220,110,*,44">
            <TextBlock Grid.Column="1" Text="이름" />
            <TextBlock Grid.Column="2" Text="종류" />
            <TextBlock Grid.Column="3" Text="열" />
            <TextBlock Grid.Column="4" Text="참조" />
            <TextBlock Grid.Column="5" Text="삭제 규칙" />
            <TextBlock Grid.Column="6" Text="조건" />
            <TextBlock Grid.Column="7" Text="사용" />
          </Grid>
        </Border>
        <ListBox x:Name="ConstraintRows" Classes="edit-rows" ItemsSource="{Binding Constraints}" SelectedItem="{Binding SelectedConstraint, Mode=TwoWay}"
                 AutomationProperties.Name="제약 편집 표">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="te:ConstraintRowViewModel">
              <Border Classes="row" Classes.added="{Binding IsAdded}" Classes.dropped="{Binding IsDropped}" ToolTip.Tip="{Binding Error}">
                <Panel>
                  <Grid ColumnDefinitions="18,190,56,170,220,110,*,44">
                    <TextBlock Grid.Column="0" Text="{Binding StateMark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Classes="cell" Classes.changed="{Binding IsNameChanged}" IsEnabled="{Binding CanEditCells}"
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="이름" />
                    <TextBlock Grid.Column="2" Text="{Binding KindText}" Margin="4,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Classes="cell" Classes.changed="{Binding IsDefinitionChanged}" IsEnabled="{Binding CanEditColumns}"
                             Text="{Binding ColumnsText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="열" />
                    <TextBox Grid.Column="4" Classes="cell" Classes.changed="{Binding IsDefinitionChanged}" IsEnabled="{Binding CanEditReference}"
                             Text="{Binding ReferenceText, UpdateSourceTrigger=LostFocus}" PlaceholderText="소유자.테이블 (열)" AutomationProperties.Name="참조" />
                    <ComboBox Grid.Column="5" IsEnabled="{Binding CanEditReference}" IsVisible="{Binding IsForeignKey}" SelectedIndex="{Binding DeleteRuleIndex}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="삭제 규칙">
                      <ComboBoxItem Content="없음" />
                      <ComboBoxItem Content="CASCADE" />
                      <ComboBoxItem Content="SET NULL" />
                    </ComboBox>
                    <TextBox Grid.Column="6" Classes="cell" Classes.changed="{Binding IsDefinitionChanged}" IsEnabled="{Binding CanEditCondition}"
                             Text="{Binding Condition, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="조건" />
                    <CheckBox Grid.Column="7" Classes="cell" Classes.changed="{Binding IsEnabledChanged}" IsEnabled="{Binding CanEditCells}"
                              IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" AutomationProperties.Name="사용" />
                  </Grid>
                  <Rectangle Height="1" Fill="{DynamicResource OrandaIconRedBrush}" VerticalAlignment="Center" IsVisible="{Binding IsDropped}" IsHitTestVisible="False" />
                </Panel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- 인덱스 페이지(설계 7.4, 시안 ④): 이름 · 유일 · 종류 · 열(ASC/DESC) · 테이블스페이스. 제약 인덱스·NORMAL 이 아닌 인덱스는 흐림. -->
      <DockPanel IsVisible="{Binding IsIndexesPage}">
        <Border DockPanel.Dock="Top" Classes="head" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OrandaSeparatorBrush}">
          <Grid ColumnDefinitions="18,200,44,120,*,150">
            <TextBlock Grid.Column="1" Text="이름" />
            <TextBlock Grid.Column="2" Text="유일" />
            <TextBlock Grid.Column="3" Text="종류" />
            <TextBlock Grid.Column="4" Text="열" />
            <TextBlock Grid.Column="5" Text="테이블스페이스" />
          </Grid>
        </Border>
        <ListBox x:Name="IndexRows" Classes="edit-rows" ItemsSource="{Binding Indexes}" SelectedItem="{Binding SelectedIndex, Mode=TwoWay}"
                 AutomationProperties.Name="인덱스 편집 표">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="te:IndexRowViewModel">
              <Border Classes="row" Classes.added="{Binding IsAdded}" Classes.dropped="{Binding IsDropped}" Classes.locked="{Binding !CanEditCells}"
                      ToolTip.Tip="{Binding LockedReason}">
                <Panel>
                  <Grid ColumnDefinitions="18,200,44,120,*,150">
                    <TextBlock Grid.Column="0" Text="{Binding StateMark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Classes="cell" Classes.changed="{Binding IsNameChanged}" IsEnabled="{Binding CanEditCells}"
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="이름" />
                    <CheckBox Grid.Column="2" Classes="cell" Classes.changed="{Binding IsDefinitionChanged}" IsEnabled="{Binding CanEditCells}"
                              IsChecked="{Binding IsUnique}" HorizontalAlignment="Center" AutomationProperties.Name="유일" />
                    <TextBlock Grid.Column="3" Text="{Binding KindText}" Margin="4,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="4" Classes="cell" Classes.changed="{Binding IsDefinitionChanged}" IsEnabled="{Binding CanEditCells}"
                             Text="{Binding ColumnsText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="열" />
                    <TextBox Grid.Column="5" Classes="cell" Classes.changed="{Binding IsDefinitionChanged}" IsEnabled="{Binding CanEditCells}"
                             Text="{Binding Tablespace, UpdateSourceTrigger=LostFocus}" PlaceholderText="(기본)" AutomationProperties.Name="테이블스페이스" />
                  </Grid>
                  <Rectangle Height="1" Fill="{DynamicResource OrandaIconRedBrush}" VerticalAlignment="Center" IsVisible="{Binding IsDropped}" IsHitTestVisible="False" />
                </Panel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- 설명 페이지: 테이블 주석 -->
      <StackPanel IsVisible="{Binding IsDescriptionPage}" Margin="8" Spacing="4">
        <TextBlock Text="테이블 주석" />
        <TextBox x:Name="TableCommentBox" Classes.changed="{Binding IsTableCommentChanged}" AcceptsReturn="False" IsEnabled="{Binding CanEditTableComment}"
                 Text="{Binding TableComment, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="테이블 주석" />
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
