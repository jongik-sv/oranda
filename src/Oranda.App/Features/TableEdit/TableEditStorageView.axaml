<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:te="using:Oranda.App.Features.TableEdit"
             x:Class="Oranda.App.Features.TableEdit.TableEditStorageView"
             x:DataType="te:TableEditSession">
  <!-- 저장 페이지(설계 18.2, 시안 ⑦). 위: 테이블 저장 속성 표(속성 · 지금 값 · 바꿀 값 · 효과). 가운데: LOB 표(LOB 열이 없으면 없음).
       아래: MOVE 경고 줄. 비운 바꿀 값 칸은 그대로 둔다(문장 없음). -->
  <UserControl.Styles>
    <!-- 표 모양 = 앱 격자 표 양식(Styles/GridC) + 편집 칸 공용 모양(TableEditGridStyles). -->
    <StyleInclude Source="avares://Oranda.App/Features/TableEdit/TableEditGridStyles.axaml" />
    <Style Selector="TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="4,8,4,2" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- 못 고치는 까닭(특수 테이블 제한 · 방언이 못 함). -->
    <Border x:Name="StorageLockedBar" DockPanel.Dock="Top" Classes="panel-toolbar" IsVisible="{Binding IsStorageLocked}">
      <TextBlock x:Name="StorageLockedText" Text="{Binding StorageLockedReason}" Margin="4,0" TextWrapping="Wrap" />
    </Border>

    <!-- 일반 테이블 → 파티션 테이블(설계 18.4). 「파티션」 페이지는 파티션 테이블에만 있어서 이 단추로 연다. -->
    <Border x:Name="PartitioningBar" DockPanel.Dock="Top" Classes="panel-toolbar" IsVisible="{Binding CanOpenPartitioning}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="OpenPartitioningButton" Classes="tool" Content="파티션 테이블로 바꾸기…"
                ToolTip.Tip="「파티션」 페이지를 열어 방식·키 열·파티션을 정합니다" AutomationProperties.Name="파티션 테이블로 바꾸기" />
        <TextBlock Text="파티션 테이블이 아닙니다" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
    </Border>

    <!-- 아래: MOVE 경고 줄. -->
    <TextBlock x:Name="StorageMoveText" DockPanel.Dock="Bottom" Classes="warn" Margin="8,4" Text="{Binding StorageMoveText}" IsVisible="{Binding HasStorageMove}" />

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,0,8">
        <!-- 테이블 저장 속성 표. -->
        <TextBlock Classes="title" Text="테이블" />
        <Border Classes="grid-c-header">
          <Grid ColumnDefinitions="24,180,160,200,*" MinHeight="24">
            <Border Grid.Column="0" Classes="grid-c-cell mark" />
            <Border Grid.Column="1" Classes="grid-c-cell"><TextBlock Text="속성" /></Border>
            <Border Grid.Column="2" Classes="grid-c-cell"><TextBlock Text="지금 값" /></Border>
            <Border Grid.Column="3" Classes="grid-c-cell"><TextBlock Text="바꿀 값" /></Border>
            <Border Grid.Column="4" Classes="grid-c-cell"><TextBlock Text="효과" /></Border>
          </Grid>
        </Border>
        <ItemsControl x:Name="StorageRowList" ItemsSource="{Binding StorageRows}" AutomationProperties.Name="저장 속성 표">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="te:StorageRowViewModel">
              <Border Classes="row" ToolTip.Tip="{Binding Tip}">
                <Grid ColumnDefinitions="24,180,160,200,*">
                  <Border Grid.Column="0" Classes="grid-c-cell row-head mark"><TextBlock Text="{Binding StateMark}" /></Border>
                  <Border Grid.Column="1" Classes="grid-c-cell"><TextBlock Text="{Binding Label}" /></Border>
                  <Border Grid.Column="2" Classes="grid-c-cell"><TextBlock Text="{Binding CurrentText}" /></Border>
                  <Border Grid.Column="3" Classes="grid-c-cell">
                    <Panel>
                      <TextBox Classes="cell" Classes.changed="{Binding IsChanged}" IsVisible="{Binding IsText}" IsEnabled="{Binding CanEdit}"
                               Text="{Binding Text, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Label}" />
                      <ComboBox Classes="cell" Classes.changed="{Binding IsChanged}" IsVisible="{Binding IsChoice}" IsEnabled="{Binding CanEdit}"
                                ItemsSource="{Binding Options}" SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" />
                    </Panel>
                  </Border>
                  <Border Grid.Column="4" Classes="grid-c-cell"><TextBlock Classes.warn="{Binding IsWarning}" Text="{Binding EffectText}" /></Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- LOB 표(LOB 열이 없으면 없음). -->
        <StackPanel x:Name="LobPanel" IsVisible="{Binding HasLobRows}">
          <TextBlock Classes="title" Text="LOB 열" Margin="4,12,4,2" />
          <Border Classes="grid-c-header">
            <Grid ColumnDefinitions="24,160,170,160,170,150,150" MinHeight="24">
              <Border Grid.Column="0" Classes="grid-c-cell mark" />
              <Border Grid.Column="1" Classes="grid-c-cell"><TextBlock Text="열" /></Border>
              <Border Grid.Column="2" Classes="grid-c-cell"><TextBlock Text="방식" /></Border>
              <Border Grid.Column="3" Classes="grid-c-cell"><TextBlock Text="테이블스페이스" /></Border>
              <Border Grid.Column="4" Classes="grid-c-cell"><TextBlock Text="압축" /></Border>
              <Border Grid.Column="5" Classes="grid-c-cell"><TextBlock Text="중복 제거" /></Border>
              <Border Grid.Column="6" Classes="grid-c-cell"><TextBlock Text="행 안에" /></Border>
            </Grid>
          </Border>
          <ItemsControl x:Name="LobRowList" ItemsSource="{Binding LobRows}" AutomationProperties.Name="LOB 열 표">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="te:LobRowViewModel">
                <Border Classes="row">
                  <Grid ColumnDefinitions="24,160,170,160,170,150,150">
                    <Border Grid.Column="0" Classes="grid-c-cell row-head mark" />
                    <Border Grid.Column="1" Classes="grid-c-cell"><TextBlock Text="{Binding ColumnName}" /></Border>
                    <Border Grid.Column="2" Classes="grid-c-cell">
                      <ComboBox Classes="cell" Classes.changed="{Binding IsKindChanged}" IsEnabled="{Binding CanEditKind}"
                                ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex, Mode=TwoWay}"
                                ToolTip.Tip="{Binding KindTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="LOB 저장 방식" />
                    </Border>
                    <Border Grid.Column="3" Classes="grid-c-cell">
                      <TextBox Classes="cell" Classes.changed="{Binding IsTablespaceChanged}" IsEnabled="{Binding CanEditTablespace}"
                               Text="{Binding Tablespace, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding TablespacePlaceholder}"
                               AutomationProperties.Name="LOB 테이블스페이스" />
                    </Border>
                    <Border Grid.Column="4" Classes="grid-c-cell">
                      <ComboBox Classes="cell" Classes.changed="{Binding IsCompressionChanged}" IsEnabled="{Binding CanEditCompression}"
                                ItemsSource="{Binding CompressionOptions}" SelectedIndex="{Binding CompressionIndex, Mode=TwoWay}"
                                ToolTip.Tip="{Binding CompressionTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="LOB 압축" />
                    </Border>
                    <Border Grid.Column="5" Classes="grid-c-cell">
                      <ComboBox Classes="cell" Classes.changed="{Binding IsDeduplicateChanged}" IsEnabled="{Binding CanEditDeduplicate}"
                                ItemsSource="{Binding DeduplicateOptions}" SelectedIndex="{Binding DeduplicateIndex, Mode=TwoWay}"
                                ToolTip.Tip="{Binding CompressionTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="LOB 중복 제거" />
                    </Border>
                    <Border Grid.Column="6" Classes="grid-c-cell">
                      <ComboBox Classes="cell" Classes.changed="{Binding IsInRowChanged}" IsEnabled="{Binding CanEditInRow}"
                                ItemsSource="{Binding InRowOptions}" SelectedIndex="{Binding InRowIndex, Mode=TwoWay}" AutomationProperties.Name="LOB 행 안에 저장" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
