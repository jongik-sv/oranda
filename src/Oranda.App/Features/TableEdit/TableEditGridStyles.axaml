<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 테이블 편집 표(열·제약·인덱스·파티션·저장) 공용 모양. 표 틀은 앱 격자 표 양식(Styles/GridC: Border.grid-c-header·Border.grid-c-cell·ListBox.grid-c)을 그대로 쓰고,
       여기서는 바인드 변수 표(BindVariablesView)처럼 입력 칸을 칸에 테두리 없이 채우는 것과 편집 상태 색만 더한다.
       바뀐 칸 노랑(.changed) · 새 줄 초록(.row.added) · 지울 줄 빨강(.row.dropped) · 못 고치는 줄 흐림(.row.locked·.row.merged). 색은 앱 테마 자원만 쓴다. -->

  <!-- 줄: 격자 표와 같은 줄 높이 24, 칸은 입력 칸이 꽉 채운다(칸 안쪽 여백은 입력 칸이 가진다). -->
  <Style Selector="ListBox.edit-rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Border.row Border.grid-c-cell">
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- 글만 있는 칸(번호·종류·행 수 등). -->
  <Style Selector="Border.row Border.grid-c-cell > TextBlock">
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.row Border.grid-c-cell.mark > TextBlock">
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.row Border.grid-c-cell.num > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <!-- 머리글: 격자 표 머리글(바탕·굵기·선)에 칸 글을 입력 칸 글과 같은 자리에 맞춘다. -->
  <Style Selector="Border.grid-c-header Border.grid-c-cell > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.grid-c-header Border.grid-c-cell.num > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.grid-c-header Border.grid-c-cell.mark > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- 고른 줄: 격자 표의 고른 줄 색에 더해, 줄 색(새·지울 줄)이 덮어도 보이게 행 머리를 고른 색으로. -->
  <Style Selector="ListBox.edit-rows ListBoxItem:selected Border.grid-c-cell.row-head">
    <Setter Property="Background" Value="{DynamicResource OrandaTableSelectionBrush}" />
  </Style>

  <!-- 입력 칸: 평소에는 글만, 올리면 옅은 바탕, 고치는 중이면 아래 강조선. -->
  <Style Selector="TextBox.cell">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="TextBox.cell.num">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <!-- 못 고치는 칸은 바탕·테두리 없이 흐린 글만(칸마다 회색 덩어리로 보이지 않게). -->
  <Style Selector="TextBox.cell:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.cell.changed">
    <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
  </Style>
  <Style Selector="TextBox.cell.changed:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
  </Style>

  <!-- 형식 칸(자동 완성): 안의 입력 칸을 같은 모양으로. -->
  <Style Selector="AutoCompleteBox.cell">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="AutoCompleteBox.cell TextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="AutoCompleteBox.cell TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="AutoCompleteBox.cell:disabled TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="AutoCompleteBox.cell.changed TextBox">
    <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
  </Style>

  <!-- 고르기 칸: 테두리 없이 칸을 채우고, 못 고치면 바탕·▾ 없이 흐린 글만. -->
  <Style Selector="ComboBox.cell">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox.cell:disabled /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.cell:disabled /template/ PathIcon#DropDownGlyph">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ComboBox.cell.changed">
    <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
  </Style>

  <!-- 체크 칸: 칸 가운데. 바뀐 칸 색은 칸(Border.grid-c-cell.changed)이 칠한다. -->
  <Style Selector="CheckBox.cell">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- 테마 체크 상자 틀의 높이 32 를 줄 높이(24) 안으로. -->
  <Style Selector="CheckBox.cell /template/ Grid#RootGrid > Grid">
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="CheckBox.cell:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Border.grid-c-cell.changed">
    <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
  </Style>

  <!-- 줄 상태. -->
  <Style Selector="Border.row.added">
    <Setter Property="Background" Value="{DynamicResource OrandaDiffAddedBrush}" />
  </Style>
  <Style Selector="Border.row.dropped">
    <Setter Property="Background" Value="{DynamicResource OrandaDiffRemovedBrush}" />
  </Style>
  <Style Selector="Border.row.locked, Border.row.merged">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <!-- 지울 줄의 줄긋기. -->
  <Style Selector="Rectangle.strike">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource OrandaIconRedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
</Styles>
