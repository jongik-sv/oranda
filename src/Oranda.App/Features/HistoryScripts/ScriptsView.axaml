<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.HistoryScripts"
             x:Class="Oranda.App.Features.HistoryScripts.ScriptsView"
             x:DataType="vm:ScriptsViewModel">
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="4">
      <Button x:Name="AddButton" Content="폴더 연결" Margin="0,0,4,0" />
      <Button x:Name="RemoveButton" Content="연결 끊기" Margin="0,0,4,0" />
      <Button x:Name="RefreshButton" Content="새로 고침" Margin="0,0,4,0" />
      <Button x:Name="RunButton" Content="실행(@)" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="6,2" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Opacity="0.7" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:ScriptNode">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:ScriptNode" ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding FullPath}" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
