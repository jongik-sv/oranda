<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Oranda.App.Features.Templates"
        x:Class="Oranda.App.Features.Templates.SnippetEditWindow"
        x:DataType="vm:SnippetEditViewModel"
        Title="{Binding Title}"
        Width="580" Height="460" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="12">
    <!-- 아래: 오류·저장/취소 -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button x:Name="SaveButton" Content="저장" IsDefault="True" Classes="accent" MinWidth="80" />
        <Button x:Name="CancelButton" Content="취소" IsCancel="True" MinWidth="80" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Classes="invalid" Text="{Binding Error}" IsVisible="{Binding HasError}"
                 TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
    </DockPanel>

    <!-- 위: 줄임말·이름·설명 -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Grid.Row="0" Text="줄임말" VerticalAlignment="Center" />
      <TextBox x:Name="PrefixBox" Grid.Row="0" Grid.Column="1" Classes="compact" Text="{Binding Prefix, Mode=TwoWay}"
               FontFamily="{DynamicResource OrandaEditorFontFamily}" PlaceholderText="예: selx (편집기에서 치고 Tab)"
               AutomationProperties.Name="줄임말" />
      <TextBlock Grid.Row="1" Grid.Column="1" Classes="panel-caption" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                 TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Text="이름" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Classes="compact" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="비우면 줄임말"
               AutomationProperties.Name="이름" />
      <TextBlock Grid.Row="3" Text="설명" VerticalAlignment="Center" />
      <TextBox Grid.Row="3" Grid.Column="1" Classes="compact" Text="{Binding Description, Mode=TwoWay}" PlaceholderText="목록에 보일 한 줄 설명"
               AutomationProperties.Name="설명" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" Text="본문" Margin="0,10,0,4" />
    <TextBlock DockPanel.Dock="Bottom" Classes="panel-caption" TextWrapping="Wrap" Margin="0,4,0,0"
               Text="$1, $2 … 자리(삽입 뒤 Tab 으로 옮김) · ${1:기본값} 기본 글이 있는 자리 · $0 마지막 커서 자리 · 같은 번호는 함께 바뀜 · \$ 는 $ 글자" />
    <Border BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1" MinHeight="120">
      <ContentControl x:Name="BodyHost" />
    </Border>
  </DockPanel>
</Window>
