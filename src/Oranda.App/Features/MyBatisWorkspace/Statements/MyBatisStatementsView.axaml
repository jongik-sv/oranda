<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.MyBatisWorkspace.Statements"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             x:Class="Oranda.App.Features.MyBatisWorkspace.Statements.MyBatisStatementsView"
             x:DataType="vm:MyBatisStatementsViewModel">
  <UserControl.Styles>
    <!-- 배지 색: Warning·Error 는 앱 공용 글자 클래스(warning-text·danger-text)를 쓰고, Info 만 여기서 정한다. -->
    <Style Selector="TextBlock.badge-info">
      <Setter Property="Foreground" Value="{DynamicResource OrandaIconBlueBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <TextBlock Text="MyBatis 문서를 열면 쿼리 목록이 여기에 보입니다."
               IsVisible="{Binding !ShowsBody}"
               Opacity="0.6"
               TextWrapping="Wrap"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="12" />
    <!-- 세션이 없어도 쓸 수 있는 보기 모드(매퍼 폴더 트리)가 있으면 도구 막대의 모드 단추와 모드 내용은 보인다. 세션 몫(문장 단추·경로·안내 띠)은 세션이 있을 때만. -->
    <DockPanel IsVisible="{Binding ShowsBody}">
      <!-- 패널 툴바: 새 문장 · id 바꾸기 · 지우기 · 펼친 SQL 을 새 SQL 탭으로 | (오른쪽 끝) 보기 전환. 이름은 툴팁으로 보인다. -->
      <Border DockPanel.Dock="Top" Classes="panel-toolbar">
        <DockPanel>
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding ViewModes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MyBatisStatementsModeButton">
                <ToggleButton Classes="toolbar"
                              IsVisible="{Binding IsAvailable}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              ToolTip.Tip="{Binding Title}"
                              AutomationProperties.Name="{Binding Title}"
                              Content="{Binding IconKey, Converter={x:Static icons:IconKeyConverter.Instance}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="1" IsVisible="{Binding HasSession}">
            <Button x:Name="NewButton" Classes="toolbar" Content="새 쿼리" ToolTip.Tip="새 쿼리 만들기"
                    icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True" Command="{Binding NewStatementCommand}" />
            <Button x:Name="RenameButton" Classes="toolbar" Content="id 바꾸기" ToolTip.Tip="고른 쿼리의 id 바꾸기"
                    icons:ButtonIcon.Key="rename" icons:ButtonIcon.IconOnly="True" Command="{Binding RenameStatementCommand}" />
            <Button x:Name="DeleteButton" Classes="toolbar" Content="쿼리 지우기" ToolTip.Tip="고른 쿼리 지우기"
                    icons:ButtonIcon.Key="delete" icons:ButtonIcon.IconOnly="True" Command="{Binding DeleteStatementCommand}" />
            <Separator Classes="toolbar" />
            <Button x:Name="ExpandButton" Classes="toolbar" Content="새 SQL 탭으로 펼치기" ToolTip.Tip="펼친 SQL 을 새 SQL 탭으로 열기"
                    icons:ButtonIcon.Key="fileSql" icons:ButtonIcon.IconOnly="True" Command="{Binding ExpandToSqlTabCommand}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Classes="panel-status" IsVisible="{Binding HasSession}">
        <TextBlock Text="로그를 붙여 넣으면 namespace.id 로 쿼리를 찾아 엽니다." TextWrapping="Wrap" />
      </Border>
      <!-- 매퍼 경로(가운데 줄임: 폴더 쪽만 줄이고 파일 이름은 남긴다, 툴팁 = 전체 경로)와 namespace. 우클릭 = 매퍼 전체 펼치기 메뉴. -->
      <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Background="Transparent" Padding="8,6,8,4" ToolTip.Tip="{Binding MapperPath}"
              IsVisible="{Binding HasSession}">
        <StackPanel Spacing="1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="panel-caption" Text="{Binding MapperDirectory}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Classes="panel-caption" Text="{Binding MapperFileName}" />
          </Grid>
          <TextBlock Classes="panel-caption" Text="{Binding NamespaceText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <DockPanel>
        <!-- 머리글 줄: 공용 격자(Styles/GridC)와 같은 머리글. 칸 너비는 아래 줄 서식과 같은 값을 쓴다(가상화 목록이라 공유 너비 대신 고정). -->
        <Border DockPanel.Dock="Top" Classes="grid-c-header" IsVisible="{Binding !IsModeActive}">
          <Grid ColumnDefinitions="40,*,60,78,64">
            <Border Classes="grid-c-cell"><TextBlock Text="종류" /></Border>
            <Border Grid.Column="1" Classes="grid-c-cell"><TextBlock Text="id" /></Border>
            <Border Grid.Column="2" Classes="grid-c-cell"><TextBlock Text="수정" /></Border>
            <Border Grid.Column="3" Classes="grid-c-cell"><TextBlock Text="조합 오류" TextTrimming="CharacterEllipsis" /></Border>
            <Border Grid.Column="4" Classes="grid-c-cell"><TextBlock Text="쓰는 곳" TextTrimming="CharacterEllipsis" /></Border>
          </Grid>
        </Border>
        <Grid>
        <!-- 평평한 줄 목록(묶음 머리 줄 + 항목 줄). 가상화되므로 요소가 수천 개여도 보이는 줄만 만든다. 줄 높이 24 DIP, 공용 격자 양식(grid-c). -->
        <ListBox x:Name="Tree" Classes="grid-c statements" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 IsVisible="{Binding !IsModeActive}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MyBatisStatementNode">
              <Panel>
                <Border IsVisible="{Binding IsGroup}" Classes="grid-c-cell row-head" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExpandGlyph}" Width="10" Opacity="0.7" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Grid IsVisible="{Binding !IsGroup}" ColumnDefinitions="40,*,60,78,64" Opacity="{Binding RowOpacity}" ToolTip.Tip="{Binding ToolTipText}">
                  <Border Classes="grid-c-cell row-head" Padding="0">
                    <TextBlock Text="{Binding KindText}" Opacity="0.75" FontSize="{DynamicResource OrandaFontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Grid.Column="1" Classes="grid-c-cell">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Border>
                  <Border Grid.Column="2" Classes="grid-c-cell" Padding="4,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource OrandaFontSizeSmall}">
                      <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource OrandaUncommittedBrush}"
                                 IsVisible="{Binding ModifiedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding NewText}" Foreground="{DynamicResource OrandaSuccessForegroundBrush}"
                                 IsVisible="{Binding NewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding AmbiguousText}" Classes="warning-text"
                                 IsVisible="{Binding AmbiguousText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding KeepText}" Opacity="0.7"
                                 IsVisible="{Binding KeepText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="3" Classes="grid-c-cell" Padding="4,0">
                    <ItemsControl ItemsSource="{Binding Badges}" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource OrandaFontSizeSmall}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MyBatisStatementBadgeView">
                          <TextBlock Text="{Binding Text}" ToolTip.Tip="{Binding ToolTip}"
                                     Classes.badge-info="{Binding IsInfo}" Classes.warning-text="{Binding IsWarning}" Classes.danger-text="{Binding IsError}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <Border Grid.Column="4" Classes="grid-c-cell" Padding="4,0">
                    <TextBlock Text="{Binding UsageText}" Opacity="0.7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontSize="{DynamicResource OrandaFontSizeSmall}" ToolTip.Tip="{Binding UsageText}" />
                  </Border>
                </Grid>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ContentControl Content="{Binding ModeContent}" IsVisible="{Binding IsModeActive}" />
        </Grid>
      </DockPanel>
    </DockPanel>
  </Grid>
</UserControl>
