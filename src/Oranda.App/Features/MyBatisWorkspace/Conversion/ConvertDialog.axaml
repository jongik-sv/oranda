<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Oranda.App.Features.MyBatisWorkspace.Conversion"
        xmlns:icons="using:Oranda.App.Shell.Icons"
        xmlns:sqled="using:Oranda.App.Features.SqlEditor"
        x:Class="Oranda.App.Features.MyBatisWorkspace.Conversion.ConvertDialog"
        x:DataType="vm:ConvertDialogViewModel"
        Title="MyBatis 작업 공간으로 바꾸기"
        Width="1080" Height="740" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <!-- 표 줄: 촘촘한 높이, 겹친 id 는 위험 색 글자와 테두리, 제외한 줄은 확인 글을 흐리게. -->
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox.invalid">
      <Setter Property="Foreground" Value="{DynamicResource OrandaDangerForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaDangerForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.note.warn">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.note.dim">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Grid.hdr > TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <!-- 머리: 제목과 회색 한 줄 -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="2">
      <TextBlock Text="MyBatis 작업 공간으로 바꾸기" FontWeight="SemiBold" FontSize="15" />
      <TextBlock x:Name="HeaderText" Text="{Binding HeaderText}" Classes="panel-caption" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- 바닥: 안내 한 줄 + 취소 + 기본 단추 -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock x:Name="FooterText" Text="{Binding FooterText}" Classes="panel-caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Content="취소" IsCancel="True" />
        <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" IsDefault="True" Classes="accent" />
      </StackPanel>
    </Grid>

    <!-- 오른쪽: 미리보기와 시나리오 값 -->
    <Border DockPanel.Dock="Right" Width="440" Background="{DynamicResource OrandaToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
      <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" x:Name="FormatCaption" Text="{Binding FormatCaption}" Classes="panel-caption" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewTitle" Text="{Binding PreviewTitle}" Classes="section" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource OrandaCodeBackgroundBrush}" BorderBrush="{DynamicResource OrandaSeparatorBrush}"
                BorderThickness="1" CornerRadius="3">
          <sqled:SqlCodeView x:Name="PreviewBox" Text="{Binding PreviewXml}" AutomationProperties.Name="미리보기" />
        </Border>
        <TextBlock Grid.Row="2" Text="시나리오 「바꿀 때 값」" Classes="section" />
        <Border Grid.Row="3" Background="{DynamicResource OrandaCodeBackgroundBrush}" BorderBrush="{DynamicResource OrandaSeparatorBrush}"
                BorderThickness="1" CornerRadius="3" Padding="8,6" MinHeight="44" MaxHeight="110">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ScenarioBox" Text="{Binding ScenarioText}" TextWrapping="Wrap"
                       FontFamily="{DynamicResource OrandaGridFontFamily}" FontSize="{DynamicResource OrandaGridFontSize}" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- 왼쪽: 설정 -->
    <Grid Margin="0,0,12,0" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="6">
      <StackPanel Spacing="6">
        <TextBlock Text="저장할 매퍼" Classes="section" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton x:Name="NewFileRadio" GroupName="ConvertTarget" Content="새 매퍼 파일" IsChecked="{Binding IsNewFile}" MinHeight="0" />
          <RadioButton x:Name="ExistingRadio" GroupName="ConvertTarget" Content="기존 매퍼에 문장 추가" IsChecked="{Binding IsExistingMapper}" MinHeight="0" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
          <TextBox x:Name="PathBox" Classes="compact" Text="{Binding Path}" AutomationProperties.Name="매퍼 파일 경로"
                   FontFamily="{DynamicResource OrandaGridFontFamily}" />
          <Button x:Name="BrowseButton" Grid.Column="1" Classes="tool" Content="찾아보기" icons:ButtonIcon.Key="folder" icons:ButtonIcon.IconOnly="True" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="namespace" Classes="panel-caption" VerticalAlignment="Center" />
          <TextBox x:Name="NamespaceBox" Grid.Column="1" Classes="compact" Classes.invalid="{Binding HasNamespaceError}" Text="{Binding Namespace}"
                   IsReadOnly="{Binding !IsNamespaceEditable}" ToolTip.Tip="{Binding NamespaceError}" AutomationProperties.Name="namespace" FontFamily="{DynamicResource OrandaGridFontFamily}" />
        </Grid>
        <TextBlock x:Name="ExistingErrorText" Text="{Binding ExistingError}" IsVisible="{Binding HasExistingError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource OrandaDangerForegroundBrush}" FontSize="{DynamicResource OrandaFontSizeSmall}" />
      </StackPanel>

      <TextBlock Grid.Row="1" Text="바꿀 탭" Classes="section" Margin="0,6,0,0" />

      <!-- 바꿀 탭 표: 머리 줄 + 줄 목록. 열 너비는 두 곳이 같다. -->
      <Border Grid.Row="2" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <Grid Classes="hdr" ColumnDefinitions="28,96,150,128,*">
              <TextBlock Grid.Column="1" Text="탭" Margin="6,0,0,0" />
              <TextBlock Grid.Column="2" Text="문장 id" Margin="6,0,0,0" />
              <TextBlock Grid.Column="3" Text="종류" Margin="6,0,0,0" />
              <TextBlock Grid.Column="4" Text="확인" Margin="6,0,0,0" />
            </Grid>
          </Border>
          <ListBox x:Name="LineList" Classes="rows" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Background="Transparent"
                   AutomationProperties.Name="바꿀 탭 목록">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConvertLineViewModel">
                <Grid ColumnDefinitions="28,96,150,128,*" MinHeight="26">
                  <CheckBox Grid.Column="0" IsChecked="{Binding Include}" IsEnabled="{Binding CanPickKind}" MinWidth="0" MinHeight="0"
                            Padding="0" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Candidate.TabTitle}" />
                  <TextBlock Grid.Column="1" Text="{Binding TabTitle}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding TabTitle}" />
                  <TextBox Grid.Column="2" Classes="compact" Classes.invalid="{Binding HasIdError}" Text="{Binding Id}" Margin="2,1" MinHeight="22" Padding="4,1"
                           ToolTip.Tip="{Binding IdError}" AutomationProperties.Name="문장 id"
                           FontFamily="{DynamicResource OrandaGridFontFamily}" FontSize="{DynamicResource OrandaGridFontSize}" />
                  <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:ConvertLineViewModel.KindLabels}" SelectedIndex="{Binding KindIndex}"
                            IsEnabled="{Binding CanPickKind}" Margin="2,1" MinHeight="22" Padding="6,1" HorizontalAlignment="Stretch"
                            FontSize="{DynamicResource OrandaFontSizeSmall}" AutomationProperties.Name="종류" />
                  <TextBlock Grid.Column="4" Classes="note" Classes.warn="{Binding HasWarning}" Classes.dim="{Binding IsDimmed}" Text="{Binding NoteText}"
                             Margin="6,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NoteText}"
                             FontSize="{DynamicResource OrandaFontSizeSmall}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <TextBlock Grid.Row="3" Text="문장 id 는 탭 이름과 첫 동사로 제안합니다. 칸을 눌러 고칠 수 있습니다." Classes="panel-caption" Margin="0,2,0,0" />

      <StackPanel Grid.Row="4" Spacing="2" Margin="0,6,0,0">
        <TextBlock Text="바꾸는 방법" Classes="section" />
        <CheckBox Content="바인드와 치환 변수 바꾸기" IsChecked="True" IsEnabled="False" MinHeight="24" />
        <CheckBox x:Name="JdbcTypeCheck" Content="타입을 아는 바인드에 jdbcType 붙이기" IsChecked="{Binding AddJdbcType}" MinHeight="24" />
        <CheckBox x:Name="WrapWhereCheck" Content="WHERE 의 바인드 조건을 where·if 로 감싸기" IsChecked="{Binding WrapWhere}" MinHeight="24" />
        <CheckBox x:Name="CdataCheck" Content="비교 기호가 있는 문장은 CDATA 로 감싸기 (끄면 엔티티)" IsChecked="{Binding UseCdata}" MinHeight="24" />
        <CheckBox x:Name="ScenarioCheck" Content="지금 탭의 바인드 값을 첫 시나리오로 저장" IsChecked="{Binding SaveScenario}" MinHeight="24" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
