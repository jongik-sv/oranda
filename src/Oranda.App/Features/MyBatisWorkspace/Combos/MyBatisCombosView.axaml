<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:sqled="using:Oranda.App.Features.SqlEditor"
             xmlns:vm="using:Oranda.App.Features.MyBatisWorkspace.Combos"
             xmlns:local="using:Oranda.App.Features.MyBatisWorkspace.Combos"
             x:Class="Oranda.App.Features.MyBatisWorkspace.Combos.MyBatisCombosView"
             x:DataType="vm:MyBatisCombosViewModel">
  <UserControl.Styles>
    <!-- 표 칸 폭(머리글과 줄이 같은 클래스를 써서 세로로 맞는다). 조건 칸은 조건 수만큼 반복된다. -->
    <Style Selector=":is(Control).c-no"><Setter Property="Width" Value="40" /></Style>
    <Style Selector=":is(Control).c-cond"><Setter Property="Width" Value="96" /></Style>
    <Style Selector=":is(Control).c-result"><Setter Property="Width" Value="190" /></Style>
    <Style Selector="TextBlock.on"><Setter Property="Foreground" Value="{DynamicResource OrandaSuccessForegroundBrush}" /></Style>
    <Style Selector="TextBlock.pass"><Setter Property="Foreground" Value="{DynamicResource OrandaSuccessForegroundBrush}" /></Style>
    <Style Selector="TextBlock.warning"><Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" /></Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource OrandaDangerForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{DynamicResource OrandaGridFontFamily}" /></Style>
    <!-- 오류 줄: 옅은 빨강 바탕 + 왼쪽 3 DIP 빨강 띠(다른 줄도 같은 폭을 비워 칸이 어긋나지 않는다). -->
    <Style Selector="Border.combo-row">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.combo-row.error">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffRemovedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaDangerForegroundBrush}" />
    </Style>
    <Style Selector="Border.count-chip">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.quick-fix">
      <Setter Property="Background" Value="{DynamicResource OrandaHotRowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaIconAmberBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="Border.code">
      <Setter Property="Background" Value="{DynamicResource OrandaCodeBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- 머리 줄: 문장 · 조건 n개 → 조합 m개 | 통과·오류 | 조합 방식 · 검사 | 다시 검사 · 취소 -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="dim" VerticalAlignment="Center" Text="조합 방식" />
          <ComboBox Classes="compact" VerticalAlignment="Center" ItemsSource="{x:Static vm:MyBatisCombosViewModel.StrategyChoices}"
                    SelectedIndex="{Binding StrategyIndex, Mode=TwoWay}" AutomationProperties.Name="조합 방식"
                    ToolTip.Tip="조건이 8개 이하면 모든 켬·끔 조합, 넘거나 「줄이기」면 하나씩 끄기 + 모두 켬 + 모두 끔" />
          <TextBlock Classes="dim" Margin="6,0,0,0" VerticalAlignment="Center" Text="검사" />
          <ComboBox Classes="compact" VerticalAlignment="Center" ItemsSource="{x:Static vm:MyBatisCombosViewModel.ModeChoices}"
                    SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" AutomationProperties.Name="검사 방식"
                    ToolTip.Tip="실행 계획은 접속이 필요하고 EXPLAIN PLAN 만 합니다(문장은 실행하지 않음)" />
          <Separator Classes="toolbar" />
          <Button Classes="toolbar" Content="다시 검사" icons:ButtonIcon.Key="refresh" icons:ButtonIcon.IconOnly="True"
                  Command="{Binding RecheckCommand}" ToolTip.Tip="같은 문장을 고른 방식으로 다시 검사" />
          <Button Classes="toolbar" Content="취소" icons:ButtonIcon.Key="cancel" icons:ButtonIcon.IconOnly="True"
                  Command="{Binding CancelCommand}" ToolTip.Tip="검사 취소(검사한 줄은 남음)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Footnote}" />
          <Border Classes="count-chip chip" IsVisible="{Binding HasReport}" ToolTip.Tip="통과(주의 포함)">
            <TextBlock Classes="pass" FontWeight="SemiBold" Text="{Binding PassText}" />
          </Border>
          <Border Classes="count-chip chip" IsVisible="{Binding HasReport}" ToolTip.Tip="오류">
            <TextBlock Classes="error" Text="{Binding ErrorText}" />
          </Border>
          <!-- 결정형 진행(움직이는 막대는 쓰지 않는다). 글 칸은 MinWidth 로 고정해 자릿수가 바뀌어도 머리 줄이 흔들리지 않는다. -->
          <ProgressBar Width="80" VerticalAlignment="Center" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone}" IsVisible="{Binding IsRunning}" />
          <TextBlock Classes="dim" MinWidth="110" VerticalAlignment="Center" Text="{Binding ProgressText}" IsVisible="{Binding IsRunning}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 빠른 고침 띠: 고칠 수 있는 모양이 있으면 보인다. 「고치기」 는 미리보기를 연다(적용은 미리보기에서). -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Fixes}" IsVisible="{Binding !!Fixes.Count}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComboFixItem">
          <Border Classes="quick-fix">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="accent" Padding="10,0" MinHeight="22" VerticalAlignment="Center" Content="{Binding ActionText}"
                      Command="{Binding $parent[UserControl].((vm:MyBatisCombosViewModel)DataContext).PreviewCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="고친 원문과 고친 뒤 검사 결과를 먼저 보고 적용" />
              <ContentControl DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                              Content="{Binding Source='docEdit', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" />
              <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Heading}" />
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Description}" ToolTip.Tip="{Binding Description}" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Panel>
      <!-- 검사 전 안내 -->
      <StackPanel IsVisible="{Binding !Rows.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <ContentControl HorizontalAlignment="Center" Opacity="0.55"
                        Content="{Binding Source='compile', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=32}" />
        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="조합 검사 결과가 없습니다" />
        <TextBlock HorizontalAlignment="Center" Classes="dim" Text="MyBatis 문서에서 문장을 고르고 도구 막대의 「조합 검사」를 누르세요" />
      </StackPanel>

      <Grid ColumnDefinitions="*,5,420" IsVisible="{Binding !!Rows.Count}">
        <DockPanel Grid.Column="0">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="grid-header">
                <StackPanel Orientation="Horizontal" Classes="cells" Margin="3,0,0,0">
                  <TextBlock Classes="c-no num" Text="#" />
                  <ItemsControl ItemsSource="{Binding ConditionLabels}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="c-cond mono" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="c-result" Text="결과" />
                  <TextBlock Text="펼친 SQL" />
                </StackPanel>
              </Border>
              <ListBox Classes="table" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="조합 검사 결과">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ComboRowItem">
                    <Border Classes="combo-row" Classes.error="{Binding IsError}">
                      <StackPanel Orientation="Horizontal" Classes="cells">
                        <TextBlock Classes="c-no num dim" Text="{Binding Number}" />
                        <ItemsControl ItemsSource="{Binding States}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComboStateCell">
                              <TextBlock Classes="c-cond" Classes.on="{Binding IsOn}" Classes.dim="{Binding !IsOn}" Text="{Binding Text}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="c-result" Classes.pass="{Binding IsPass}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}"
                                   Text="{Binding ResultText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ResultText}" />
                        <TextBlock Classes="mono" local:SqlInlineText.Sql="{Binding SqlLine}" TextTrimming="CharacterEllipsis" MaxWidth="900" ToolTip.Tip="{Binding SqlLine}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </ScrollViewer>
        </DockPanel>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <!-- 오른쪽: 고른 조합의 펼친 SQL(오류 자리 강조)·설명·단추. 미리보기 중이면 고친 원문과 고친 뒤 결과. -->
        <Border Grid.Column="2" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource OrandaPanelHeaderBrush}">
          <Panel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsPreviewing}">
              <StackPanel Margin="12,10" Spacing="8" IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                    <Button Classes="toolbar" Content="시나리오로 저장" icons:ButtonIcon.Key="save" icons:ButtonIcon.IconOnly="True" Command="{Binding SaveScenarioCommand}"
                            ToolTip.Tip="이 조합의 켬·끔이 되게 값을 채운 새 시나리오" />
                    <Button Classes="toolbar" Content="편집기에서 보기" icons:ButtonIcon.Key="docEdit" icons:ButtonIcon.IconOnly="True" Command="{Binding ShowInEditorCommand}"
                            ToolTip.Tip="문장 탭을 열고 원인 줄로 이동" />
                  </StackPanel>
                  <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SelectedRow.Heading}" />
                </DockPanel>
                <!-- 글은 code-behind 가 SelectedRow 에서 넣고, 오류 자리는 같은 곳에서 건 변환기가 칠한다. -->
                <Border Classes="code">
                  <sqled:SqlCodeView x:Name="DetailSqlView" MaxHeight="360" AutomationProperties.Name="펼친 SQL" />
                </Border>
                <TextBlock TextWrapping="Wrap" Text="{Binding SelectedRow.Detail}" IsVisible="{Binding SelectedRow.HasDetail}"
                           Classes.error="{Binding SelectedRow.IsError}" Classes.warning="{Binding SelectedRow.IsWarning}" />
                <TextBlock TextWrapping="Wrap" Classes="dim" Text="이 조합을 시나리오로 저장하면 값을 넣어 다시 확인할 수 있습니다." />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsPreviewing}">
              <StackPanel Margin="12,10" Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <Button Classes="accent" Padding="10,0" MinHeight="22" Content="적용" Command="{Binding ApplyFixCommand}" ToolTip.Tip="문장 탭에 적용(실행 취소 한 번으로 되돌림)" />
                    <Button Classes="toolbar" Content="닫기" Command="{Binding ClosePreviewCommand}" ToolTip.Tip="적용하지 않고 미리보기 닫기" />
                  </StackPanel>
                  <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding PreviewTitle}" />
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Text="{Binding PreviewSummary}" />
                <Border Classes="code">
                  <sqled:SqlCodeView x:Name="FixPreviewView" Text="{Binding PreviewText}" MaxHeight="360" AutomationProperties.Name="고친 원문" />
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
