<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:sqled="using:Oranda.App.Features.SqlEditor"
             xmlns:vm="using:Oranda.App.Features.MyBatisWorkspace.Expanded"
             x:Class="Oranda.App.Features.MyBatisWorkspace.Expanded.MyBatisExpandedView"
             x:DataType="vm:MyBatisExpandedViewModel">
  <Grid>
    <TextBlock Text="MyBatis 쿼리 탭을 열면 펼친 SQL 이 여기에 보입니다."
               IsVisible="{Binding HasNoStatement}"
               Opacity="0.6"
               TextWrapping="Wrap"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="12" />
    <Grid IsVisible="{Binding HasStatement}" RowDefinitions="Auto,Auto,Auto,*">
      <!-- 분할 머리 줄(TSK-03-10): [시나리오 콤보 · 추가/이름 바꾸기/복제/지우기] ........ 명령 단추(실행 계획·복사 2종).
           탭 안 분할은 좁을 수 있어 설명 · 켜진 조건 칩은 아래 한 줄로 둔다. -->
      <Border Grid.Row="0" Classes="panel-toolbar">
        <DockPanel>
          <StackPanel x:Name="ActionBar" DockPanel.Dock="Right" Orientation="Horizontal" />
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="ScenarioCombo" Classes="compact" MinWidth="120" MaxWidth="260" Margin="2,0,2,0"
                      ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                      ToolTip.Tip="시나리오는 앱 안에 xml 경로 기준으로 저장합니다. 매퍼 파일은 건드리지 않습니다."
                      AutomationProperties.Name="시나리오 목록">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MyBatisScenarioItem">
                  <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Note}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="toolbar" Content="시나리오 추가" Command="{Binding AddCommand}"
                    icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True" />
            <Button Classes="toolbar" Content="이름 바꾸기" Command="{Binding RenameCommand}"
                    icons:ButtonIcon.Key="rename" icons:ButtonIcon.IconOnly="True" />
            <Button Classes="toolbar" Content="시나리오 복제" Command="{Binding DuplicateCommand}"
                    icons:ButtonIcon.Key="copy" icons:ButtonIcon.IconOnly="True" />
            <Button Classes="toolbar" Content="시나리오 지우기" Command="{Binding DeleteCommand}"
                    icons:ButtonIcon.Key="delete" icons:ButtonIcon.IconOnly="True" />
          </StackPanel>
          <Panel />
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,3,6,3">
        <TextBlock Grid.Column="0" Classes="panel-caption" Text="{Binding Header}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Header}" />
        <Border Grid.Column="1" Classes="chip" Margin="8,0,0,0" IsVisible="{Binding HasChip}">
          <TextBlock Classes="success-text" Text="{Binding ConditionChip}" />
        </Border>
      </Grid>
      <TextBlock Grid.Row="2" Classes="warning-text" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"
                 TextWrapping="Wrap" Margin="8,4" />
      <!-- 읽기 전용 펼친 SQL(편집기와 같은 SQL 강조). 바인드·치환 값은 「바인드 변수」 창에서만 넣는다(TSK-03-10). -->
      <sqled:SqlCodeView x:Name="SqlView" Grid.Row="3" Text="{Binding Sql}"
                         Background="{DynamicResource OrandaCodeBackgroundBrush}" AutomationProperties.Name="펼친 SQL" />
    </Grid>
  </Grid>
</UserControl>
