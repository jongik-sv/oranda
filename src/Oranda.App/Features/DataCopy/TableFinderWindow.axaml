<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dc="using:Oranda.App.Features.DataCopy"
        x:Class="Oranda.App.Features.DataCopy.TableFinderWindow"
        x:DataType="dc:TableFinderViewModel"
        Title="테이블 찾기"
        Width="720" Height="460" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <!-- 이름에서 검색 값과 맞는 글자: 굵게, 옅은 노란 바탕(어두운 테마도 보이게 진한 쪽). -->
    <Style Selector="Run.hit">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Background" Value="#66F5C518" />
    </Style>
    <Style Selector="TextBlock.added-chip">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12,10,12,12">
    <!-- 위: 계정 · 이름·테이블 명 필터 · 시노님 포함 -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,160,12,*,12,Auto">
      <TextBlock Grid.Column="0" Text="계정" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="OwnerBox" Grid.Column="1" Classes="compact" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner, Mode=TwoWay}" AutomationProperties.Name="계정" />
      <TextBox x:Name="FilterBox" Grid.Column="3" Classes="compact search" Text="{Binding FilterText, Mode=TwoWay}"
               PlaceholderText="이름·테이블 명 필터 (* 와일드카드)" AutomationProperties.Name="이름·테이블 명 필터" />
      <CheckBox Grid.Column="5" Content="시노님 포함" IsChecked="{Binding IncludeSynonyms, Mode=TwoWay}" VerticalAlignment="Center" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" Opacity="0.7" Margin="0,6,0,4"
               FontSize="{DynamicResource OrandaFontSizeSmall}" TextTrimming="CharacterEllipsis" />
    <!-- 아래: 안내 · 선택한 N개 추가 · 닫기 -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="AddButton" Classes="accent" Content="{Binding AddButtonText}" IsEnabled="{Binding CanAdd}" IsDefault="True" MinWidth="120"
                AutomationProperties.Name="선택한 테이블 추가" />
        <Button x:Name="CloseButton" Content="닫기" IsCancel="True" MinWidth="80" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="{Binding PickedText}" Opacity="0.7" FontSize="{DynamicResource OrandaFontSizeSmall}" />
        <TextBlock Text="시노님은 실제 계정·테이블로 풀어 더합니다" Opacity="0.55" FontSize="{DynamicResource OrandaFontSizeSmall}" />
      </StackPanel>
    </DockPanel>
    <Border Classes="grid-frame" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="grid-header">
          <Grid ColumnDefinitions="34,240,70,*">
            <CheckBox Grid.Column="0" HorizontalAlignment="Center" IsThreeState="False" IsChecked="{Binding AllVisibleChecked, Mode=TwoWay}"
                      IsEnabled="{Binding CanCheckAll}" ToolTip.Tip="보이는 표 모두 고르기·풀기" AutomationProperties.Name="보이는 표 모두 고르기" />
            <TextBlock Grid.Column="1" Padding="6,0" Text="이름" />
            <TextBlock Grid.Column="2" Padding="6,0" Text="유형" />
            <TextBlock Grid.Column="3" Padding="6,0" Text="테이블 명(주석)" />
          </Grid>
        </Border>
        <Panel>
          <ListBox x:Name="List" Classes="table" ItemsSource="{Binding Rows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="찾은 테이블">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dc:TableFinderRow">
                <Grid ColumnDefinitions="34,240,70,*" Opacity="{Binding IsAdded, Converter={x:Static dc:TableFinderWindow.AddedOpacity}}">
                  <CheckBox Grid.Column="0" HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}"
                            AutomationProperties.Name="{Binding Name}" />
                  <!-- 긴 이름은 칸 안에서 말줄임(가로 StackPanel 은 폭을 묶지 않아 유형 칸을 덮었다). 「이미 있음」은 칸 오른쪽. -->
                  <DockPanel Grid.Column="1" Margin="6,0" ToolTip.Tip="{Binding Name}">
                    <Border DockPanel.Dock="Right" IsVisible="{Binding IsAdded}" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center">
                      <TextBlock Classes="added-chip" Text="이미 있음" />
                    </Border>
                    <TextBlock Classes="mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding NameBefore}" /><Run Classes="hit" Text="{Binding NameMatch}" /><Run Text="{Binding NameAfter}" />
                    </TextBlock>
                  </DockPanel>
                  <TextBlock Grid.Column="2" Padding="6,0" VerticalAlignment="Center" Text="{Binding TypeText}" Opacity="0.75" />
                  <TextBlock Grid.Column="3" Padding="6,0,10,0" VerticalAlignment="Center" Text="{Binding Comment}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Comment}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding HasEmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.6" TextWrapping="Wrap" Margin="16" />
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
