<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dc="using:Oranda.App.Features.DataCopy"
        xmlns:core="using:Oranda.Core.Transfer.Copy"
        xmlns:icons="using:Oranda.App.Shell.Icons"
        xmlns:sm="using:Oranda.App.Features.SessionMonitor"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        x:Class="Oranda.App.Features.DataCopy.DataCopyWindow"
        x:DataType="dc:DataCopyViewModel"
        Title="데이터 복사"
        Width="1240" Height="780" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <!-- 상태 표시줄·편집 안내의 오류 글(앱 공통 TextBlock.error 스타일이 없어 이 창에서 정한다). -->
    <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource OrandaDangerForegroundBrush}" /></Style>
    <Style Selector="TextBlock.level.error"><Setter Property="Foreground" Value="{DynamicResource OrandaIconRedBrush}" /></Style>
    <Style Selector="TextBlock.level.confirm"><Setter Property="Foreground" Value="{DynamicResource OrandaIconOrangeBrush}" /></Style>
    <Style Selector="TextBlock.level.pass"><Setter Property="Foreground" Value="{DynamicResource OrandaIconGreenBrush}" /></Style>
    <!-- 단계 표시: 번호 동그라미 + 이름, 지금 단계는 아래 파란 줄·채운 번호·굵은 글자. -->
    <Style Selector="Border.step">
      <Setter Property="Padding" Value="4,2,8,3" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.step TextBlock"><Setter Property="Opacity" Value="0.6" /></Style>
    <Style Selector="Border.step.current"><Setter Property="BorderBrush" Value="{DynamicResource OrandaIconBlueBrush}" /></Style>
    <Style Selector="Border.step.current TextBlock">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.step-num">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
    </Style>
    <Style Selector="Border.step-num TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.step.current Border.step-num">
      <Setter Property="Background" Value="{DynamicResource OrandaIconBlueBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaIconBlueBrush}" />
    </Style>
    <Style Selector="Border.step.current Border.step-num TextBlock"><Setter Property="Foreground" Value="{DynamicResource OrandaEnvChipForegroundBrush}" /></Style>
    <!-- 설정 묶음 상자와 그리드 테두리. -->
    <Style Selector="Border.group">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,5,8,6" />
    </Style>
    <Style Selector="Border.grid-frame">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.group TextBlock.field, Grid.form > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
    </Style>
    <!-- 촘촘한 체크 상자(Fluent 기본 32 → 22). -->
    <Style Selector="CheckBox.compact"><Setter Property="MinHeight" Value="0" /></Style>
    <!-- 테이블 입력 자동 완성 칸: 안쪽 글 칸을 TextBox.compact 높이에 맞춘다. -->
    <Style Selector="AutoCompleteBox.compact /template/ TextBox#PART_TextBox">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="CheckBox.compact /template/ Grid#RootGrid > Grid"><Setter Property="Height" Value="22" /></Style>
  </Window.Styles>
  <DockPanel>
    <!-- 아래 상태 표시줄: 안내·오류 | 단계 | 원본 | 대상 | 테이블 수 | 바쁜 표시. -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <Border Classes="status-cell">
          <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Classes.error="{Binding StatusIsError}" AutomationProperties.Name="상태" />
        </Border>
        <Border Grid.Column="1" Classes="status-cell">
          <Panel>
            <TextBlock Text="1/3 규칙 편집" IsVisible="{Binding IsRuleEdit}" VerticalAlignment="Center" />
            <TextBlock Text="2/3 사전 점검" IsVisible="{Binding IsPrecheck}" VerticalAlignment="Center" />
            <TextBlock Text="3/3 실행·검증" IsVisible="{Binding IsRun}" VerticalAlignment="Center" />
          </Panel>
        </Border>
        <Border Grid.Column="2" Classes="status-cell" IsVisible="{Binding Editor.Source, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ContentControl Content="{Binding Source='database', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=12}" VerticalAlignment="Center" />
            <TextBlock Text="원본" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Editor.Source.Profile.Name}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="status-cell" IsVisible="{Binding Editor.Target, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ContentControl Content="{Binding Source='database', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=12}" VerticalAlignment="Center" />
            <TextBlock Text="대상" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Editor.Target.Profile.Name}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="status-cell" IsVisible="{Binding HasJob}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="테이블 수" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Editor.Rules.Count}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ProgressBar Grid.Column="5" Width="100" Height="4" Margin="8,0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="210,Auto,*">
      <!-- 내 작업 목록 -->
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="panel-toolbar">
          <StackPanel Orientation="Horizontal" Spacing="1">
            <Button x:Name="NewJobButton" Classes="toolbar" Focusable="False" Content="새 작업" icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="새 작업 만들기" />
            <Button x:Name="DuplicateJobButton" Classes="toolbar" Focusable="False" Content="복제" icons:ButtonIcon.Key="copy" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="선택한 작업 복제" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button x:Name="RenameJobButton" Classes="toolbar" Focusable="False" Content="이름 바꾸기" icons:ButtonIcon.Key="rename" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="이름 바꾸기" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Separator Classes="toolbar" />
            <Button x:Name="ExportJobButton" Classes="toolbar" Focusable="False" Content="내보내기" icons:ButtonIcon.Key="export" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="작업 파일로 내보내기" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button x:Name="ImportJobButton" Classes="toolbar" Focusable="False" Content="가져오기" icons:ButtonIcon.Key="import" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="작업 파일 가져오기" />
            <Separator Classes="toolbar" />
            <Button x:Name="DeleteJobButton" Classes="toolbar" Focusable="False" Content="삭제" icons:ButtonIcon.Key="delete" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="선택한 작업 삭제" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Classes="grid-header" Padding="8,3">
          <TextBlock Text="내 작업" />
        </Border>
        <ListBox x:Name="JobList" Classes="table" ItemsSource="{Binding Jobs.Items}" SelectedItem="{Binding Jobs.Selected}" AutomationProperties.Name="내 작업">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="dc:JobListItem">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="6,3">
                <ContentControl Content="{Binding IconKey, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Spacing="0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding LastRunText}" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LastRunText}"
                             IsVisible="{Binding LastRunText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="실행한 적 없음" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.5"
                             IsVisible="{Binding LastRunText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource OrandaSplitterBrush}" />

      <!-- 단계 화면 -->
      <DockPanel Grid.Column="2">
        <!-- 작업 이름: 세 단계 모두 이 작업의 일이므로 단계 표시줄보다 위에 둔다. -->
        <Border DockPanel.Dock="Top" Padding="8,6,8,4" IsVisible="{Binding HasJob}">
          <Grid ColumnDefinitions="Auto,320,*" ColumnSpacing="8" Classes="form" DataContext="{Binding Editor}" x:DataType="dc:RuleEditorViewModel">
            <TextBlock Text="작업 이름" />
            <TextBox x:Name="JobNameBox" Grid.Column="1" Classes="compact" Text="{Binding Name}" FontWeight="SemiBold" AutomationProperties.Name="작업 이름" />
          </Grid>
        </Border>
        <!-- 단계 표시줄: ① 규칙 편집 › ② 사전 점검 › ③ 실행·검증 -->
        <Border DockPanel.Dock="Top" Classes="panel-toolbar" Padding="6,2">
          <DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="step" Classes.current="{Binding IsRuleEdit}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="step-num"><TextBlock Text="1" /></Border>
                  <TextBlock Text="규칙 편집" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.45" />
              <Border Classes="step" Classes.current="{Binding IsPrecheck}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="step-num"><TextBlock Text="2" /></Border>
                  <TextBlock Text="사전 점검" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.45" />
              <Border Classes="step" Classes.current="{Binding IsRun}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="step-num"><TextBlock Text="3" /></Border>
                  <TextBlock Text="실행·검증" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 끝나지 않은 지난 실행 -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasUnfinished}" Padding="8,6"
                Background="{DynamicResource OrandaToolbarBackgroundBrush}" BorderBrush="{DynamicResource OrandaIconAmberBrush}" BorderThickness="0,0,0,2">
          <ItemsControl ItemsSource="{Binding UnfinishedRuns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dc:UnfinishedRunItem">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="1">
                    <TextBlock Text="지난 실행이 끝나지 않았습니다. 대상 트리거·FK 상태를 확인하세요." FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Header}" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.75" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                          <TextBlock Text="{Binding}" FontSize="{DynamicResource OrandaFontSizeSmall}" FontFamily="{DynamicResource OrandaCodeFontFamily}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="tool" Content="다시 켜기" icons:ButtonIcon.Key="reset" VerticalAlignment="Top"
                          ToolTip.Tip="꺼 두었던 트리거와 FK 를 대상에서 다시 켭니다" Click="OnReenable" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- 세 단계 화면(하나만 보인다): 한 칸에 겹쳐 둬 보이는 화면이 남은 자리를 모두 채운다. -->
        <Panel>
        <!-- 1단계: 규칙 편집 -->
        <DockPanel IsVisible="{Binding IsRuleEdit}">
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <DockPanel>
              <Button x:Name="ToPrecheckButton" DockPanel.Dock="Right" Classes="accent" Content="사전 점검 ›" IsEnabled="{Binding CanGoToPrecheck}"
                      Padding="14,0" MinHeight="24" Margin="0,1,2,1"
                      ToolTip.Tip="작업을 저장하고 원본·대상 세션을 열어 사전 점검을 시작합니다" />
              <Button x:Name="SaveJobButton" DockPanel.Dock="Right" Content="저장" icons:ButtonIcon.Key="save"
                      MinHeight="24" Margin="0,1,6,1" IsEnabled="{Binding HasJob}"
                      ToolTip.Tip="지금까지 편집한 작업을 저장합니다 (Ctrl+S). 다른 작업을 열거나 창을 닫을 때도 저장합니다."
                      AutomationProperties.Name="작업 저장" />
              <TextBlock Text="원본·대상을 고르고 아래 테이블 규칙에 테이블을 더한 뒤 사전 점검으로 넘어갑니다." VerticalAlignment="Center" Margin="6,0"
                         Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>

          <!-- 새 버전 Oranda 가 만든 작업(읽기 전용): 점검·실행을 막은 이유 -->
          <Border DockPanel.Dock="Top" IsVisible="{Binding HasReadOnlyJobNotice}" Padding="8,5"
                  Background="{DynamicResource OrandaToolbarBackgroundBrush}" BorderBrush="{DynamicResource OrandaIconAmberBrush}" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ContentControl Content="{Binding Source='warn', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
              <TextBlock x:Name="ReadOnlyJobNoticeText" Text="{Binding ReadOnlyJobNotice}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                         AutomationProperties.Name="새 버전 작업 안내" />
            </StackPanel>
          </Border>

          <DockPanel IsEnabled="{Binding HasJob}">
            <!-- 작업 설정: 원본 | 대상 | 범위·실행 묶음 -->
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="8,6,8,0" DataContext="{Binding Editor}" x:DataType="dc:RuleEditorViewModel">
              <Grid ColumnDefinitions="*,8,*,8,1.3*">
                <!-- 원본 -->
                <Border Classes="group">
                  <Grid ColumnDefinitions="52,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                      <ContentControl Content="{Binding Source='database', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                      <TextBlock Classes="section-label" Text="원본" VerticalAlignment="Center" />
                      <Border Classes="chip" Padding="6,0" ToolTip.Tip="원본 세션은 읽기 전용 트랜잭션으로 열립니다. 원본에는 아무것도 쓰지 않습니다.">
                        <TextBlock Text="읽기 전용" />
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="field" Text="접속" />
                    <ComboBox x:Name="SourceBox" Grid.Row="1" Grid.Column="1" Classes="compact" HorizontalAlignment="Stretch" ItemsSource="{Binding SourceOptions}"
                              SelectedItem="{Binding Source}" AutomationProperties.Name="원본 접속">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dc:ConnectionOption"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Classes="field" Text="기본 계정"
                               ToolTip.Tip="표 이름만 적어 더할 때 먼저 찾는 원본 계정입니다. 바꾸면 이 계정이던 규칙도 따라 바뀝니다. 다른 계정의 표는 계정.표로 적거나 시노님으로 더합니다." />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="compact" Text="{Binding SourceOwner, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="원본 기본 계정"
                             ToolTip.Tip="표 이름만 적어 더할 때 먼저 찾는 원본 계정입니다. 바꾸면 이 계정이던 규칙도 따라 바뀝니다. 다른 계정의 표는 계정.표로 적거나 시노님으로 더합니다." />
                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Classes="compact" Content="같은 시점으로 읽기" IsChecked="{Binding ConsistentRead}"
                              ToolTip.Tip="원본 세션을 읽기 전용 트랜잭션 하나로 열어 모든 테이블을 같은 시점으로 읽습니다. 끄면 테이블마다 따로 읽습니다." />
                  </Grid>
                </Border>
                <!-- 대상 -->
                <Border Grid.Column="2" Classes="group">
                  <Grid ColumnDefinitions="52,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                      <ContentControl Content="{Binding Source='database', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                      <TextBlock Classes="section-label" Text="대상" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="field" Text="접속" />
                    <ComboBox x:Name="TargetBox" Grid.Row="1" Grid.Column="1" Classes="compact" HorizontalAlignment="Stretch" ItemsSource="{Binding TargetOptions}"
                              SelectedItem="{Binding Target}" AutomationProperties.Name="대상 접속">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dc:ConnectionOption">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            <!-- 고를 수 없는 대상(운영 접속)은 이유를 항목 글에도 붙인다(툴팁을 못 봐도 알 수 있게). -->
                            <TextBlock Text="운영 접속 · 대상 불가" IsVisible="{Binding !IsEnabled}" Classes="danger-text" FontSize="{DynamicResource OrandaFontSizeSmall}" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Classes="field" Text="기본 계정"
                               ToolTip.Tip="기본 원본 계정의 표를 넣을 대상 계정입니다. 다른 원본 계정의 표는 같은 이름의 계정에 넣고, 표마다 오른쪽 칸에서 바꿀 수 있습니다. 바꾸면 이 계정이던 규칙도 따라 바뀝니다." />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="compact" Text="{Binding TargetOwner, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="대상 기본 계정"
                             ToolTip.Tip="기본 원본 계정의 표를 넣을 대상 계정입니다. 다른 원본 계정의 표는 같은 이름의 계정에 넣고, 표마다 오른쪽 칸에서 바꿀 수 있습니다. 바꾸면 이 계정이던 규칙도 따라 바뀝니다." />
                    <TextBlock Grid.Row="3" Classes="field" Text="커밋" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Classes="compact" HorizontalAlignment="Stretch" ItemsSource="{Binding CommitModes}" SelectedItem="{Binding Commit}" AutomationProperties.Name="커밋 단위">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:CommitMode"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.CommitText}}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Classes="compact" Content="트리거 끄기를 기본으로" IsChecked="{Binding DisableTriggersByDefault}" />
                  </Grid>
                </Border>
                <!-- 범위·실행 -->
                <Border Grid.Column="4" Classes="group">
                  <Grid ColumnDefinitions="64,110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                      <ContentControl Content="{Binding Source='settings', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                      <TextBlock Classes="section-label" Text="범위 · 실행" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="field" Text="기간" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="compact" HorizontalAlignment="Stretch" ItemsSource="{Binding PeriodKinds}" SelectedItem="{Binding PeriodChoice}"
                              AutomationProperties.Name="기간 종류">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dc:PeriodKindOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 계산된 기간(시작 포함 · 끝 제외), 직접 고르면 날짜 칸 둘 -->
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PeriodText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding !IsCustomPeriod}" ToolTip.Tip="시작 포함 · 끝 제외" AutomationProperties.Name="계산된 기간" />
                    <!-- 직접 지정: 시작·끝 날짜를 한 줄씩(좁은 창에서도 날짜가 잘리지 않게). -->
                    <TextBlock Grid.Row="2" Classes="field" Text="시작" IsVisible="{Binding IsCustomPeriod}" />
                    <CalendarDatePicker Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectedDate="{Binding CustomFrom}" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding IsCustomPeriod}" AutomationProperties.Name="시작 날짜" />
                    <TextBlock Grid.Row="3" Classes="field" Text="끝" IsVisible="{Binding IsCustomPeriod}" />
                    <CalendarDatePicker Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedDate="{Binding CustomTo}" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding IsCustomPeriod}" AutomationProperties.Name="끝 날짜" />
                    <!-- 끝 날짜 셈: 「미만」·「끝 날짜 포함」(날짜 칸 옆에 두면 좁은 창에서 눌려 안 보여 따로 한 줄) -->
                    <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Classes="compact" HorizontalAlignment="Stretch" ItemsSource="{Binding PeriodEnds}" SelectedItem="{Binding PeriodEnd}"
                              IsVisible="{Binding IsCustomPeriod}" AutomationProperties.Name="끝 날짜 셈"
                              ToolTip.Tip="미만: 끝 날짜는 들어가지 않습니다 · 끝 날짜 포함: 끝 날짜 하루 끝까지 들어갑니다">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dc:PeriodEndOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 전기일: DATE·TIMESTAMP 기간 열의 하루를 이 시각부터 다음 날 이 시각 전까지로 센다(문자열 날짜 열은 그대로). -->
                    <TextBlock Grid.Row="5" Classes="field" Text="전기일" IsVisible="{Binding HasPeriod}" />
                    <NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="23" Increment="1" FormatString="0" Value="{Binding DayStartHour}"
                                   IsVisible="{Binding HasPeriod}" AutomationProperties.Name="전기일 기준 시각"
                                   ToolTip.Tip="DATE·TIMESTAMP 기간 열은 하루를 이 시각부터 다음 날 이 시각 전까지로 셉니다(7 이면 11-01 07:00 ~ 11-02 07:00 미만). 0 은 자정, 문자열 날짜 열은 그대로입니다" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="시 기준" VerticalAlignment="Center" Classes="dim" IsVisible="{Binding HasPeriod}" />
                    <TextBlock Grid.Row="6" Classes="field" Text="배치 크기" />
                    <NumericUpDown Grid.Row="6" Grid.Column="1" Minimum="1" Maximum="50000" Increment="500" FormatString="0" Value="{Binding BatchSize}" AutomationProperties.Name="배치 크기" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="행씩" VerticalAlignment="Center" Classes="dim" />
                    <TextBlock Grid.Row="7" Classes="field" Text="실패 상한" />
                    <NumericUpDown Grid.Row="7" Grid.Column="1" Minimum="1" Maximum="100000" Increment="10" FormatString="0" Value="{Binding MaxFailedRows}"
                                   AutomationProperties.Name="실패 행 상한" ToolTip.Tip="한 표에서 넣지 못한 행이 이 수를 넘으면 그 표를 멈춥니다" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="행" VerticalAlignment="Center" Classes="dim" />
                  </Grid>
                </Border>
              </Grid>

              <!-- 작업 변수: 조건에서 :이름 으로 쓴다(값 여러 개면 IN (:이름)). -->
              <Expander x:Name="VariablesExpander" Padding="8,4" HorizontalAlignment="Stretch" AutomationProperties.Name="변수">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ContentControl Content="{Binding Source='binds', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                    <TextBlock Classes="section-label" Text="변수" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Variables.Count, StringFormat='({0})'}" Classes="dim" VerticalAlignment="Center" />
                    <TextBlock Text="직접 조건·추가 조건에서 :이름 으로 씁니다. 값이 여러 개면 IN (:이름) 으로 씁니다." Classes="dim"
                               FontSize="{DynamicResource OrandaFontSizeSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="4">
                  <ItemsControl ItemsSource="{Binding Variables}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dc:CopyVariableViewModel">
                        <Grid ColumnDefinitions="150,80,*,120,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                          <TextBox Classes="compact" Text="{Binding Name}" PlaceholderText="이름(예: COILS)" VerticalAlignment="Top"
                                   FontFamily="{DynamicResource OrandaGridFontFamily}" AutomationProperties.Name="변수 이름" />
                          <ComboBox Grid.Column="1" Classes="compact" ItemsSource="{x:Static dc:VariableTypeOption.All}" SelectedItem="{Binding TypeOption}" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top" AutomationProperties.Name="변수 형식">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="dc:VariableTypeOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBox Classes="compact" Text="{Binding ValuesText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="26" MaxHeight="96"
                                     FontFamily="{DynamicResource OrandaGridFontFamily}" PlaceholderText="값(여러 개면 줄바꿈·쉼표로 나눔, 엑셀 열 붙여넣기 가능)"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="변수 값" />
                            <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Classes="danger-text" TextWrapping="Wrap"
                                       FontSize="{DynamicResource OrandaFontSizeSmall}" AutomationProperties.Name="변수 오류" />
                          </StackPanel>
                          <StackPanel Grid.Column="3" Spacing="0" VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Text="{Binding CountText}" Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                            <TextBlock Text="{Binding UsageText}" Classes="mono" FontSize="{DynamicResource OrandaFontSizeSmall}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="조건에 이렇게 씁니다" />
                          </StackPanel>
                          <Button Grid.Column="4" Classes="toolbar" Content="조건에 넣기" icons:ButtonIcon.Key="filter" icons:ButtonIcon.IconOnly="True"
                                  VerticalAlignment="Top" ToolTip.Tip="고른 규칙의 WHERE 조건에 넣기" Click="OnInsertVariableCondition"
                                  IsEnabled="{Binding $parent[ItemsControl].((dc:RuleEditorViewModel)DataContext).CanInsertVariableCondition, FallbackValue=False}" />
                          <Button Grid.Column="5" Classes="toolbar" Content="변수 빼기" icons:ButtonIcon.Key="remove" icons:ButtonIcon.IconOnly="True"
                                  VerticalAlignment="Top" ToolTip.Tip="이 변수 빼기" Click="OnRemoveVariable" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="AddVariableButton" Classes="tool" Content="변수 더하기" icons:ButtonIcon.Key="add" HorizontalAlignment="Left"
                          ToolTip.Tip="코일·주문번호·MO·자재코드처럼 조건에 넣을 값을 변수로 둡니다" />
                </StackPanel>
              </Expander>

              <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Classes="error" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTargetReadOnlyNotice}">
                <ContentControl Content="{Binding Source='error', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                <TextBlock x:Name="TargetReadOnlyNoticeText" Text="{Binding TargetReadOnlyNotice}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                           AutomationProperties.Name="대상 접속 읽기 전용 안내" />
              </StackPanel>
            </StackPanel>

            <!-- 규칙 그리드 | 선택한 규칙 편집 -->
            <Grid Margin="8,6,8,8" DataContext="{Binding Editor}" x:DataType="dc:RuleEditorViewModel">
              <!-- 오른쪽 상세 칸은 창 폭에 따라 320~420(좁은 창에서도 그리드 자리를 남긴다). -->
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="420" />
              </Grid.ColumnDefinitions>
              <DockPanel>
                <!-- 테이블 규칙 머리줄: 이름 + 테이블 입력(원본의 표·시노님 자동 완성) + 규칙 단추. 원본을 고른 뒤에 쓰므로 원본 설정 아래에 둔다. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                  <TextBlock DockPanel.Dock="Left" Classes="section-label" Text="테이블 규칙" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <StackPanel Orientation="Horizontal" Spacing="1">
                    <AutoCompleteBox x:Name="AddTableBox" Classes="compact" Width="240" PlaceholderText="테이블 이름 입력 후 Enter"
                                     MinimumPrefixLength="1" MinimumPopulateDelay="0:0:0.15" FilterMode="None" MaxDropDownHeight="320"
                                     AutomationProperties.Name="추가할 테이블 이름"
                                     ToolTip.Tip="테이블 또는 계정.테이블. 원본의 테이블·시노님을 이름으로 찾아 보여 줍니다. 시노님은 원본에서 실제 계정·테이블로 풀어 더합니다." />
                    <Button x:Name="AddTableButton" Classes="toolbar" Focusable="False" Content="테이블 추가" icons:ButtonIcon.Key="rowAdd" icons:ButtonIcon.IconOnly="True"
                            ToolTip.Tip="테이블 규칙 추가 (Enter)" />
                    <Button x:Name="FindTablesButton" Classes="toolbar" Focusable="False" Content="테이블 찾기…" icons:ButtonIcon.Key="find"
                            ToolTip.Tip="이름·테이블 명으로 찾아 여러 테이블을 한 번에 추가" IsEnabled="{Binding $parent[Window].((dc:DataCopyViewModel)DataContext).HasJob}"
                            AutomationProperties.Name="테이블 찾기" />
                    <Button x:Name="RemoveRuleButton" Classes="toolbar" Focusable="False" Content="규칙 제거" icons:ButtonIcon.Key="rowDelete" icons:ButtonIcon.IconOnly="True"
                            ToolTip.Tip="선택한 규칙 제거 (Delete)" IsEnabled="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Separator Classes="toolbar" />
                    <Button x:Name="MoveRuleUpButton" Classes="toolbar" Focusable="False" Content="위로" icons:ButtonIcon.Key="up" icons:ButtonIcon.IconOnly="True"
                            ToolTip.Tip="선택한 규칙을 위로(처리 순서는 사전 점검이 FK 로 정합니다)" IsEnabled="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button x:Name="MoveRuleDownButton" Classes="toolbar" Focusable="False" Content="아래로" icons:ButtonIcon.Key="down" icons:ButtonIcon.IconOnly="True"
                            ToolTip.Tip="선택한 규칙을 아래로(처리 순서는 사전 점검이 FK 로 정합니다)" IsEnabled="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Separator Classes="toolbar" />
                    <Button x:Name="ReadColumnsToolButton" Classes="toolbar" Focusable="False" Content="열 정보 읽기" icons:ButtonIcon.Key="columns" icons:ButtonIcon.IconOnly="True"
                            ToolTip.Tip="선택한 테이블의 열 정보를 원본에서 읽기" IsEnabled="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </DockPanel>
                <Border Classes="grid-frame">
                  <!-- 조회 결과와 같은 그리드(MonitorGrid). 행은 코드(MonitorGridBinder)가 Rules 에서 채운다. -->
                  <sm:MonitorGrid x:Name="RuleGrid" AutomationProperties.Name="테이블 규칙" />
                </Border>
              </DockPanel>
              <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

              <!-- 선택한 규칙 편집 -->
              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Classes="section-label" Text="선택한 규칙" Margin="0,0,0,3" />
                <Border Classes="grid-frame">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="grid-header" Padding="8,4" DataContext="{Binding SelectedRule}" x:DataType="dc:TableRuleViewModel"
                            IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                      <DockPanel>
                        <Button x:Name="LoadColumnsButton" DockPanel.Dock="Right" Classes="tool" Content="열 정보 읽기" icons:ButtonIcon.Key="refresh" Padding="4,0"
                                IsVisible="{Binding !HasColumns}" ToolTip.Tip="원본에서 이 테이블의 열 정보를 읽어 기간 열·마스킹·건너뛸 열을 고를 수 있게 합니다" />
                        <!-- 계정.표 와 「← 시노님 X」: 좁으면 시노님 글부터 줄인다(열 정보 읽기 단추와 겹치지 않게). -->
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,6,0">
                          <ContentControl Content="{Binding Source='table', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                          <TextBlock x:Name="RuleHeaderText" Grid.Column="1" Text="{Binding SourceName}" VerticalAlignment="Center" FontSize="{DynamicResource OrandaFontSizeBase}"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceName}" />
                          <TextBlock Grid.Column="2" Text="{Binding SynonymText}" IsVisible="{Binding HasSynonym}" Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="더할 때 적은 시노님"
                                     ToolTip.Tip="이 이름(시노님)으로 더했습니다. 복사는 저장된 실제 표로 합니다." />
                        </Grid>
                      </DockPanel>
                    </Border>
                    <ScrollViewer DataContext="{Binding SelectedRule}" x:DataType="dc:TableRuleViewModel" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                      <StackPanel Spacing="5" Margin="8,6,10,8">
                        <Grid ColumnDefinitions="68,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4" Classes="form">
                          <!-- 원본 계정(바꾸려면 표를 다시 더한다) · 대상 계정(고르거나 적는다) -->
                          <TextBlock Text="원본 계정" />
                          <TextBlock x:Name="RuleSourceOwnerText" Grid.Column="1" Text="{Binding SourceOwner}" Classes="mono" VerticalAlignment="Center"
                                     AutomationProperties.Name="원본 계정" ToolTip.Tip="원본 계정은 바꿀 수 없습니다. 다른 계정의 표는 계정.표로 다시 추가하세요." />
                          <TextBlock Grid.Row="1" Text="대상 계정" />
                          <!-- 글자는 코드(SyncRulePanel)가 고른 규칙과 맞춘다: 바인딩으로 두면 규칙을 바꾸는 순간 앞 규칙에 새 규칙 값이 써진다. -->
                          <ComboBox x:Name="TargetOwnerBox" Grid.Row="1" Grid.Column="1" Classes="compact" HorizontalAlignment="Stretch" IsEditable="True"
                                    AutomationProperties.Name="대상 계정" PlaceholderText="{Binding DefaultTarget}"
                                    ToolTip.Tip="이 표를 넣을 대상 계정입니다. 고르거나 직접 적습니다.">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="dc:TargetOwnerOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding Owner}" Classes="mono" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Hint}" Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" VerticalAlignment="Center" />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock x:Name="OtherTargetOwnerText" Grid.Row="2" Grid.Column="1" Text="{Binding OtherTargetOwnerNotice}" IsVisible="{Binding IsOtherTargetOwner}"
                                     Classes="warning-text" TextWrapping="Wrap" FontSize="{DynamicResource OrandaFontSizeSmall}" AutomationProperties.Name="다른 계정 안내" />
                          <TextBlock Grid.Row="3" Text="규칙" />
                          <ComboBox x:Name="KindBox" Grid.Row="3" Grid.Column="1" Classes="compact" HorizontalAlignment="Stretch" AutomationProperties.Name="규칙 종류"
                                    ToolTip.Tip="어떤 행을 복사할지 고릅니다. WHERE 절을 직접 쓰려면 「직접 조건」, 기간에 조건을 더하려면 「기간」의 추가 조건을 씁니다.">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="core:RuleKind">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.RuleKindText}}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.RuleKindHint}}" Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}"
                                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Grid.Row="4" Text="대상 처리" />
                          <ComboBox x:Name="ActionBox" Grid.Row="4" Grid.Column="1" Classes="compact" HorizontalAlignment="Stretch" AutomationProperties.Name="대상 처리">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="core:TargetAction"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.ActionText}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Grid.Row="5" Grid.Column="1" Text="원본에서 지워진 행은 MERGE 가 남깁니다" IsVisible="{Binding IsMerge}" Classes="dim" TextWrapping="Wrap"
                                     FontSize="{DynamicResource OrandaFontSizeSmall}" />
                        </Grid>

                        <!-- 기간 규칙 -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsPeriod}">
                          <TextBlock Classes="section-label" Text="기간 열" Margin="0,4,0,0" />
                          <ComboBox Classes="compact" ItemsSource="{Binding PeriodColumnOptions}" SelectedItem="{Binding FirstColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="기간 열">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="dc:PeriodColumnOption"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <!-- 문자열 날짜 형식은 YYYY-MM-DD HH24:MI:SS(19자)까지 보이게 칸 폭 전체를 쓴다. -->
                          <ComboBox Classes="compact" ItemsSource="{Binding StringFormats}" HorizontalAlignment="Stretch" IsVisible="{Binding FirstFormatVisible}"
                                    IsEditable="True" Text="{Binding FirstFormat}" PlaceholderText="문자열 날짜 형식" AutomationProperties.Name="문자열 날짜 형식" />
                          <StackPanel Spacing="4" IsVisible="{Binding HasSecondColumn}">
                            <TextBlock Text="또는(OR) 두 번째 기간 열" Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                              <ComboBox Classes="compact" ItemsSource="{Binding PeriodColumnOptions}" SelectedItem="{Binding SecondColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="두 번째 기간 열">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="dc:PeriodColumnOption"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <Button x:Name="RemoveSecondColumnButton" Grid.Column="1" Classes="toolbar" Content="두 번째 열 빼기" icons:ButtonIcon.Key="remove" icons:ButtonIcon.IconOnly="True"
                                      ToolTip.Tip="두 번째 기간 열 빼기" />
                            </Grid>
                            <ComboBox Classes="compact" ItemsSource="{Binding StringFormats}" HorizontalAlignment="Stretch" IsVisible="{Binding SecondFormatVisible}"
                                      IsEditable="True" Text="{Binding SecondFormat}" PlaceholderText="문자열 날짜 형식" AutomationProperties.Name="두 번째 문자열 날짜 형식" />
                          </StackPanel>
                          <Button x:Name="AddSecondColumnButton" Classes="tool" Content="두 번째 기간 열 더하기(OR)" icons:ButtonIcon.Key="add" HorizontalAlignment="Left"
                                  IsVisible="{Binding CanAddSecondColumn}" ToolTip.Tip="생성 시각 또는 수정 시각처럼 두 열 중 하나라도 기간 안이면 복사합니다" />
                          <!-- 추가 조건: 기간식과 AND 로 묶어 원본 조회·대상 지우기·건수 비교에 같이 쓴다. -->
                          <TextBlock Classes="section-label" Text="추가 조건(AND)" Margin="0,4,0,0" />
                          <TextBox x:Name="ExtraWhereBox" Classes="compact" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap" Text="{Binding ExtraWhere}"
                                   FontFamily="{DynamicResource OrandaGridFontFamily}" PlaceholderText="예: STATUS = 'DONE'" AutomationProperties.Name="추가 조건" />
                          <TextBlock Text="{Binding ConditionError}" IsVisible="{Binding HasConditionError}" Classes="danger-text" TextWrapping="Wrap" FontWeight="SemiBold"
                                     AutomationProperties.Name="추가 조건 오류" />
                          <TextBlock Text="기간 안의 행 가운데 이 조건에도 맞는 행만 복사하고, 대상에서도 같은 조건으로 지웁니다. :FROM_DT, :TO_DT 를 쓸 수 있습니다."
                                     Classes="dim" TextWrapping="Wrap" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                        </StackPanel>

                        <!-- 부모 키 규칙 -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsParentKey}">
                          <TextBlock Classes="section-label" Text="부모 테이블(FK)" Margin="0,4,0,0" />
                          <ComboBox Classes="compact" ItemsSource="{Binding ParentCandidates}" SelectedItem="{Binding Parent}" HorizontalAlignment="Stretch" AutomationProperties.Name="부모 키 연결">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="core:ParentLink"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.ParentLinkText}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>

                        <!-- 직접 조건 -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsCustom}">
                          <TextBlock Classes="section-label" Text="WHERE 조건" Margin="0,4,0,0" />
                          <TextBox Classes="compact" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Text="{Binding CustomWhere}" PlaceholderText=":FROM_DT, :TO_DT 를 쓸 수 있습니다"
                                   FontFamily="{DynamicResource OrandaGridFontFamily}" AutomationProperties.Name="직접 조건" />
                          <TextBlock Text="{Binding ConditionError}" IsVisible="{Binding HasConditionError}" Classes="danger-text" TextWrapping="Wrap" FontWeight="SemiBold"
                                     AutomationProperties.Name="직접 조건 오류" />
                        </StackPanel>

                        <!-- 마스킹 -->
                        <StackPanel Spacing="4">
                          <TextBlock Classes="section-label" Text="마스킹" Margin="0,4,0,0" ToolTip.Tip="대상에 넣기 전에 값을 바꿉니다" />
                          <TextBlock Text="대상에 넣기 전에 바꿉니다. 여러 표의 조인 키면 해시를 쓰세요." Classes="dim" TextWrapping="Wrap" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                          <ItemsControl ItemsSource="{Binding Masks}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="dc:MaskRowViewModel">
                                <!-- 값 칸은 테마 최소 폭(64)이 열 폭보다 크면 오른쪽이 잘리므로 MinWidth 를 풀고 열 폭을 넉넉히 둔다. -->
                                <Grid x:Name="MaskRow" ColumnDefinitions="*,104,72" ColumnSpacing="4" Margin="0,1">
                                  <TextBlock Text="{Binding Column}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="mono" ToolTip.Tip="{Binding Column}" />
                                  <ComboBox Grid.Column="1" Classes="compact" ItemsSource="{Binding AllowedKinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" AutomationProperties.Name="마스킹 방법">
                                    <ComboBox.ItemTemplate>
                                      <DataTemplate x:DataType="core:MaskKind"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.MaskKindText}}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <TextBox Grid.Column="2" Classes="compact" MinWidth="0" Text="{Binding Value}" IsVisible="{Binding NeedsValue}" AutomationProperties.Name="고정값" />
                                  <NumericUpDown Grid.Column="2" MinWidth="0" Minimum="0" Maximum="200" FormatString="0" Value="{Binding Count}" IsVisible="{Binding NeedsCount}"
                                                 AutomationProperties.Name="남길 글자 수" ShowButtonSpinner="False" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ComboBox x:Name="AddMaskBox" Classes="compact" HorizontalAlignment="Stretch" PlaceholderText="마스킹할 열 추가…" AutomationProperties.Name="마스킹할 열 추가" />
                        </StackPanel>

                        <!-- 건너뛸 열 -->
                        <StackPanel Spacing="0" IsVisible="{Binding HasColumns}">
                          <TextBlock Classes="section-label" Text="건너뛸 열" Margin="0,4,0,2" />
                          <ItemsControl ItemsSource="{Binding Skips}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="dc:SkipColumnViewModel">
                                <CheckBox Classes="compact" IsChecked="{Binding IsSkipped}"><TextBlock Text="{Binding Column}" Classes="mono" /></CheckBox>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </DockPanel>
            </Grid>
          </DockPanel>
        </DockPanel>

        <!-- 2단계: 사전 점검 -->
        <DockPanel IsVisible="{Binding IsPrecheck}">
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <DockPanel>
              <Button x:Name="RunButton" DockPanel.Dock="Right" Classes="accent" Content="복사 실행 ›" IsEnabled="{Binding CanStartRun}"
                      Padding="14,0" MinHeight="24" Margin="0,1,2,1"
                      ToolTip.Tip="점검에 오류가 없을 때만 실행할 수 있습니다. 확인이 필요한 문장은 이 단추로 미리 확인한 것으로 봅니다." />
              <StackPanel Orientation="Horizontal" Spacing="1">
                <Button x:Name="BackToRulesButton" Classes="tool" Content="규칙 편집" icons:ButtonIcon.Key="up" ToolTip.Tip="규칙 편집으로 돌아갑니다" />
                <Separator Classes="toolbar" />
                <Button x:Name="RecheckButton" Classes="toolbar" Focusable="False" Content="다시 점검" icons:ButtonIcon.Key="refresh" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="다시 점검" IsEnabled="{Binding CanGoToPrecheck}" />
                <Button x:Name="CancelCheckButton" Classes="toolbar" Focusable="False" Content="점검 취소" icons:ButtonIcon.Key="cancel" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="점검(예상 건수 세기 포함) 취소" IsEnabled="{Binding Precheck.CanCancel}" />
                <Separator Classes="toolbar" />
                <Button x:Name="OpenScriptButton" Classes="toolbar" Focusable="False" Content="편집기로 열기" icons:ButtonIcon.Key="newSql" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="SQL 미리 보기를 새 SQL 탭으로 열기" />
                <Button x:Name="SaveScriptButton" Classes="toolbar" Focusable="False" Content="SQL 스크립트로 저장" icons:ButtonIcon.Key="save" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="SQL 스크립트로 저장" />
                <TextBlock Text="{Binding Precheck.ProgressText}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75" FontSize="{DynamicResource OrandaFontSizeSmall}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Classes="panel-status" IsVisible="{Binding Precheck.NeedsRetype}">
            <!-- 테이블 다시 만들기 등 DROP 이 있으면: 입력할 대상 접속 이름을 그대로 보이고, 안 맞으면 「복사 실행」이 꺼진 이유를 옆에 보인다. -->
            <WrapPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap">
                <Run Text="테이블을 지우는(DROP) 문장이 있습니다. 대상 접속 이름" />
                <Run Text="{Binding Precheck.RetypeTargetName, StringFormat='「{0}」'}" FontWeight="SemiBold" />
                <Run Text="을(를) 입력하면 목록 전체를 확인한 것으로 봅니다." />
              </TextBlock>
              <TextBox x:Name="RetypeBox" Classes="compact" Width="220" Text="{Binding Precheck.RetypeInput}" PlaceholderText="{Binding Precheck.RetypeTargetName}"
                       AutomationProperties.Name="대상 접속 이름 다시 입력" Margin="0,0,8,0" />
              <TextBlock x:Name="RetypeStateText" Text="{Binding Precheck.RetypeState}" VerticalAlignment="Center" FontWeight="SemiBold"
                         Classes.warning-text="{Binding !Precheck.RetypeSatisfied}" AutomationProperties.Name="다시 입력 상태" />
            </WrapPanel>
          </Border>
          <Grid ColumnDefinitions="*,4,*" Margin="8,6,8,8">
            <!-- 점검 결과: 그리드 + 고른 항목 상세(문장 전체·고를 거리) -->
            <Grid RowDefinitions="Auto,Auto,*,4,Auto">
              <TextBlock Classes="section-label" Text="점검 결과" Margin="0,0,0,3" />
              <!-- 작업에 이미 연결된 시퀀스: 체크를 끄면 연결이 풀린다 -->
              <Border x:Name="LinkedSequencesBorder" Grid.Row="1" Classes="group" Margin="0,0,0,6" IsVisible="{Binding Precheck.HasLinkedSequences}">
                <StackPanel x:Name="LinkedSequencesPanel">
                  <TextBlock Classes="section-label" Text="연결된 시퀀스(복사 뒤 값을 맞춥니다)" />
                  <ItemsControl ItemsSource="{Binding Precheck.LinkedSequences}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dc:SequenceLinkViewModel">
                        <CheckBox Classes="compact" IsChecked="{Binding IsLinked}" Click="OnSequenceLinkClick" AutomationProperties.Name="시퀀스 연결">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Text}" Classes="mono" />
                            <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.7" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Classes="grid-frame">
                <sm:MonitorGrid x:Name="CheckGrid" AutomationProperties.Name="점검 결과" />
              </Border>
              <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />
              <Border Grid.Row="4" Classes="group" MinHeight="70" DataContext="{Binding Precheck.SelectedItem}" x:DataType="dc:CheckItemViewModel">
                <Panel>
                  <TextBlock Text="항목을 고르면 내용과 고를 거리가 여기에 보입니다." Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}"
                             IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNull}}" />
                  <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ContentControl Content="{Binding IconKey, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" Classes="level" Classes.error="{Binding IsError}"
                                   Classes.confirm="{Binding IsConfirm}" Classes.pass="{Binding IsPass}" />
                        <TextBlock Text="{Binding TableText}" Classes="mono" Opacity="0.8" />
                        <TextBlock Text="{Binding Code}" Classes="mono dim" FontSize="{DynamicResource OrandaFontSizeSmall}" VerticalAlignment="Center"
                                   ToolTip.Tip="점검 항목 코드" AutomationProperties.Name="점검 항목 코드" />
                      </StackPanel>
                      <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <!-- 시퀀스 후보: 켜면 작업에 연결해 저장하고 다시 점검한다 -->
                      <ContentControl Content="{Binding SequenceLink}" IsVisible="{Binding HasSequenceLink}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate x:DataType="dc:SequenceLinkViewModel">
                            <CheckBox Classes="compact" IsChecked="{Binding IsLinked}" Click="OnSequenceLinkClick" AutomationProperties.Name="시퀀스 연결"
                                      ToolTip.Tip="켜면 이 시퀀스를 작업에 저장하고, 복사가 끝난 뒤 값을 원본 최대값에 맞춥니다.">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="작업에 연결:" />
                                <TextBlock Text="{Binding Text}" Classes="mono" />
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                      <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="dc:CheckChoiceViewModel">
                            <CheckBox Classes="compact" IsChecked="{Binding IsChosen}" IsVisible="{Binding IsVisible}"
                                      Click="OnChoiceClick"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Panel>
              </Border>
            </Grid>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
            <!-- SQL 미리 보기: 문장 그리드 + 고른 문장 전체 -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,4,170">
              <TextBlock Classes="section-label" Text="SQL 미리 보기 (대상에서 실행할 문장과 원본 조회)" Margin="0,0,0,3" />
              <Border Grid.Row="1" Classes="grid-frame">
                <sm:MonitorGrid x:Name="SqlGrid" AutomationProperties.Name="SQL 미리 보기" />
              </Border>
              <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="Transparent" />
              <Border Grid.Row="3" Classes="code" Padding="0">
                <TextBox Classes="code-view" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         Text="{Binding Precheck.SelectedPreview.Sql}" PlaceholderText="문장을 고르면 전체가 여기에 보입니다(선택해 복사)"
                         AutomationProperties.Name="고른 문장" />
              </Border>
            </Grid>
          </Grid>
        </DockPanel>

        <!-- 3단계: 실행·검증 -->
        <Panel IsVisible="{Binding IsRun}">
        <DockPanel DataContext="{Binding Run}" x:DataType="dc:RunViewModel">
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="10,0,4,0" Opacity="0.7"
                          IsVisible="{Binding ReadStartedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="읽기 시작" VerticalAlignment="Center" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                <TextBlock Text="{Binding ReadStartedText}" VerticalAlignment="Center" FontSize="{DynamicResource OrandaFontSizeSmall}" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="1">
                <Button x:Name="BackFromRunButton" Classes="tool" Content="규칙 편집" icons:ButtonIcon.Key="up" IsEnabled="{Binding !IsRunning}"
                        ToolTip.Tip="규칙 편집으로 돌아갑니다(복사가 도는 동안에는 먼저 중지하세요)" />
                <Separator Classes="toolbar" />
                <Button x:Name="PauseButton" Classes="toolbar" Focusable="False" Content="일시 정지" icons:ButtonIcon.Key="timer" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="일시 정지(지금 배치가 끝난 뒤 멈춥니다)" IsEnabled="{Binding CanPause}" />
                <Button x:Name="ResumeButton" Classes="toolbar" Focusable="False" Content="계속" icons:ButtonIcon.Key="run" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="계속" IsEnabled="{Binding CanResume}" />
                <Button x:Name="StopButton" Classes="toolbar" Focusable="False" Content="중지" icons:ButtonIcon.Key="cancel" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="중지(현재 배치를 되돌리고 끈 트리거·FK 를 다시 켠 뒤 끝냅니다)" IsEnabled="{Binding CanStop}" />
                <Separator Classes="toolbar" />
                <Button x:Name="RetryButton" Classes="toolbar" Focusable="False" Content="실패 행만 다시 넣기" icons:ButtonIcon.Key="reset" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="실패 행만 다시 넣기" IsEnabled="{Binding CanRetry}" />
                <Button x:Name="CsvButton" Classes="toolbar" Focusable="False" Content="CSV로 저장" icons:ButtonIcon.Key="exportFile" icons:ButtonIcon.IconOnly="True" IsEnabled="{Binding HasFailedRows}"
                        ToolTip.Tip="실패 행의 키와 오류 메시지를 CSV 파일로 저장합니다(누를 때만 저장)" />
              </StackPanel>
              <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <Grid RowDefinitions="*,4,*,Auto" Margin="8,6,8,8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="section-label" Text="테이블별 진행" Margin="0,0,0,3" />
              <Border Classes="grid-frame">
                <sm:MonitorGrid x:Name="RunGrid" AutomationProperties.Name="테이블별 진행" />
              </Border>
            </DockPanel>
            <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />
            <!-- 아래 칸: 작업 로그(실제로 보낸 문장·결과) | 실패한 행. 끝나서 실패 행이 있으면 실패한 행 탭으로 옮긴다. -->
            <TabControl x:Name="RunDetailTabs" Grid.Row="2" Classes="compact" Padding="0" SelectedIndex="{Binding DetailTab, Mode=TwoWay}">
              <TabItem x:Name="RunLogTab" Header="작업 로그">
                <dc:CopyRunLogView x:Name="RunLogView" DataContext="{Binding Log}" Margin="0,2,0,0" />
              </TabItem>
              <TabItem x:Name="FailedRowsTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="실패한 행(키와 오류)" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FailedRows.Count}" VerticalAlignment="Center" />
                  </StackPanel>
                </TabItem.Header>
                <Border Classes="grid-frame" Margin="0,4,0,0">
                  <sm:MonitorGrid x:Name="FailedGrid" AutomationProperties.Name="실패한 행" />
                </Border>
              </TabItem>
            </TabControl>
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Notices}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                    <ContentControl Content="{Binding Source='info', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </DockPanel>
        </Panel>
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
