<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dc="using:Oranda.App.Features.DataCopy"
        xmlns:core="using:Oranda.Core.Transfer.Copy"
        xmlns:icons="using:Oranda.App.Shell.Icons"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        x:Class="Oranda.App.Features.DataCopy.DataCopyWindow"
        x:DataType="dc:DataCopyViewModel"
        Title="데이터 복사"
        Width="1240" Height="780" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <Style Selector="TextBlock.level.error"><Setter Property="Foreground" Value="{DynamicResource OrandaIconRedBrush}" /></Style>
    <Style Selector="TextBlock.level.confirm"><Setter Property="Foreground" Value="{DynamicResource OrandaIconOrangeBrush}" /></Style>
    <Style Selector="TextBlock.level.pass"><Setter Property="Foreground" Value="{DynamicResource OrandaIconGreenBrush}" /></Style>
  </Window.Styles>
  <DockPanel>
    <!-- 아래 상태 줄: 안내·오류와 바쁜 표시. -->
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Classes.error="{Binding StatusIsError}" AutomationProperties.Name="상태" />
        <ProgressBar Grid.Column="1" Width="120" Height="6" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="210,Auto,*">
      <!-- 내 작업 목록 -->
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="panel-toolbar">
          <StackPanel Orientation="Horizontal" Spacing="1">
            <Button x:Name="NewJobButton" Classes="toolbar" Focusable="False" Content="새 작업" icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="새 작업 만들기" />
            <Button x:Name="DuplicateJobButton" Classes="toolbar" Focusable="False" Content="복제" icons:ButtonIcon.Key="copy" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="선택한 작업 복제" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button x:Name="RenameJobButton" Classes="toolbar" Focusable="False" Content="이름 바꾸기" icons:ButtonIcon.Key="rename" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="이름 바꾸기" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Separator Classes="toolbar" />
            <Button x:Name="ExportJobButton" Classes="toolbar" Focusable="False" Content="내보내기" icons:ButtonIcon.Key="export" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="작업 파일로 내보내기" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button x:Name="ImportJobButton" Classes="toolbar" Focusable="False" Content="가져오기" icons:ButtonIcon.Key="import" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="작업 파일 가져오기" />
            <Separator Classes="toolbar" />
            <Button x:Name="DeleteJobButton" Classes="toolbar" Focusable="False" Content="삭제" icons:ButtonIcon.Key="delete" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="선택한 작업 삭제" IsEnabled="{Binding Jobs.Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
        <ListBox x:Name="JobList" ItemsSource="{Binding Jobs.Items}" SelectedItem="{Binding Jobs.Selected}" AutomationProperties.Name="내 작업">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="dc:JobListItem">
              <StackPanel Spacing="0" Margin="0,1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding LastRunText}" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.7"
                           IsVisible="{Binding LastRunText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="3" />

      <!-- 단계 화면 -->
      <DockPanel Grid.Column="2">
        <!-- 단계 표시줄 -->
        <Border DockPanel.Dock="Top" Classes="panel-toolbar">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="1. 규칙 편집" VerticalAlignment="Center" Classes.current-step="{Binding IsRuleEdit}" FontWeight="SemiBold" Opacity="0.55">
              <TextBlock.Styles>
                <Style Selector="TextBlock.current-step"><Setter Property="Opacity" Value="1" /></Style>
              </TextBlock.Styles>
            </TextBlock>
            <TextBlock Text="2. 사전 점검" VerticalAlignment="Center" Classes.current-step="{Binding IsPrecheck}" FontWeight="SemiBold" Opacity="0.55">
              <TextBlock.Styles>
                <Style Selector="TextBlock.current-step"><Setter Property="Opacity" Value="1" /></Style>
              </TextBlock.Styles>
            </TextBlock>
            <TextBlock Text="3. 실행·검증" VerticalAlignment="Center" Classes.current-step="{Binding IsRun}" FontWeight="SemiBold" Opacity="0.55">
              <TextBlock.Styles>
                <Style Selector="TextBlock.current-step"><Setter Property="Opacity" Value="1" /></Style>
              </TextBlock.Styles>
            </TextBlock>
            <TextBlock Text="{Binding Editor.Name}" VerticalAlignment="Center" Opacity="0.7" IsVisible="{Binding HasJob}" />
          </StackPanel>
        </Border>

        <!-- 끝나지 않은 지난 실행 -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasUnfinished}" Padding="8,6"
                Background="{DynamicResource OrandaToolbarBackgroundBrush}" BorderBrush="{DynamicResource OrandaIconAmberBrush}" BorderThickness="0,0,0,2">
          <ItemsControl ItemsSource="{Binding UnfinishedRuns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dc:UnfinishedRunItem">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="1">
                    <TextBlock Text="지난 실행이 끝나지 않았습니다. 대상 트리거·FK 상태를 확인하세요." FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Header}" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.75" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                          <TextBlock Text="{Binding}" FontSize="{DynamicResource OrandaFontSizeSmall}" FontFamily="{DynamicResource OrandaCodeFontFamily}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="tool" Content="다시 켜기" icons:ButtonIcon.Key="reset" VerticalAlignment="Top"
                          ToolTip.Tip="꺼 두었던 트리거와 FK 를 대상에서 다시 켭니다" Click="OnReenable" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- 1단계: 규칙 편집 -->
        <DockPanel IsVisible="{Binding IsRuleEdit}">
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
                <Button x:Name="ToPrecheckButton" Classes="tool" Content="사전 점검" icons:ButtonIcon.Key="plan" IsEnabled="{Binding CanGoToPrecheck}"
                        ToolTip.Tip="작업을 저장하고 원본·대상 세션을 열어 사전 점검을 시작합니다" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" DataContext="{Binding Editor}" x:DataType="dc:RuleEditorViewModel">
                <TextBox x:Name="AddTableBox" Classes="compact" Width="200" PlaceholderText="추가할 테이블 이름" AutomationProperties.Name="추가할 테이블 이름" />
                <Button x:Name="AddTableButton" Classes="toolbar" Focusable="False" Content="테이블 추가" icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="테이블 규칙 추가 (원본 소유자 기준)" />
                <Button x:Name="RemoveRuleButton" Classes="toolbar" Focusable="False" Content="규칙 제거" icons:ButtonIcon.Key="remove" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="선택한 규칙 제거" IsEnabled="{Binding SelectedRule, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </DockPanel>
          </Border>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding HasJob}">
            <StackPanel Spacing="6" Margin="8" DataContext="{Binding Editor}" x:DataType="dc:RuleEditorViewModel">
              <Grid ColumnDefinitions="Auto,200,Auto,*,Auto,200,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                <TextBlock Text="작업 이름" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Classes="compact" Text="{Binding Name}" AutomationProperties.Name="작업 이름" />
                <CheckBox Grid.Column="3" Grid.ColumnSpan="5" Content="모든 테이블을 같은 시점 기준으로 읽기" IsChecked="{Binding ConsistentRead}"
                          ToolTip.Tip="원본 세션을 읽기 전용 트랜잭션 하나로 열어 모든 테이블을 같은 시점으로 읽습니다. 끄면 테이블마다 따로 읽습니다." />

                <TextBlock Grid.Row="1" Text="원본 접속" VerticalAlignment="Center" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                  <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" ItemsSource="{Binding SourceOptions}"
                            SelectedItem="{Binding Source}" AutomationProperties.Name="원본 접속">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="dc:ConnectionOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Border Grid.Column="1" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                          ToolTip.Tip="원본 세션은 읽기 전용 트랜잭션으로 열립니다. 원본에는 아무것도 쓰지 않습니다.">
                    <TextBlock Text="읽기 전용" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.8" />
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="소유자" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="3" Classes="compact" Text="{Binding SourceOwner}" MaxWidth="180" HorizontalAlignment="Left" Width="180" AutomationProperties.Name="원본 소유자" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="대상 접속" VerticalAlignment="Center" />
                <ComboBox x:Name="TargetBox" Grid.Row="1" Grid.Column="5" HorizontalAlignment="Stretch" ItemsSource="{Binding TargetOptions}"
                          SelectedItem="{Binding Target}" AutomationProperties.Name="대상 접속">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="dc:ConnectionOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="6" Text="소유자" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="7" Classes="compact" Text="{Binding TargetOwner}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="대상 소유자" />

                <TextBlock Grid.Row="2" Text="기간" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PeriodKinds}" SelectedItem="{Binding PeriodChoice}"
                          AutomationProperties.Name="기간 종류">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="dc:PeriodKindOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="6" Orientation="Horizontal" Spacing="8">
                  <CalendarDatePicker SelectedDate="{Binding CustomFrom}" IsVisible="{Binding IsCustomPeriod}" AutomationProperties.Name="시작 날짜" />
                  <TextBlock Text="~" VerticalAlignment="Center" IsVisible="{Binding IsCustomPeriod}" />
                  <CalendarDatePicker SelectedDate="{Binding CustomTo}" IsVisible="{Binding IsCustomPeriod}" AutomationProperties.Name="끝 날짜(포함하지 않음)" />
                  <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="계산된 기간" />
                  <TextBlock Text="시작 포함 · 끝 제외" Opacity="0.6" VerticalAlignment="Center" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="배치 크기" VerticalAlignment="Center" />
                <NumericUpDown Minimum="1" Maximum="50000" Increment="500" FormatString="0" Value="{Binding BatchSize}" Width="110" AutomationProperties.Name="배치 크기" />
                <TextBlock Text="커밋 단위" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding CommitModes}" SelectedItem="{Binding Commit}" AutomationProperties.Name="커밋 단위">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:CommitMode"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.CommitText}}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="실패 행 상한" VerticalAlignment="Center" />
                <NumericUpDown Minimum="1" Maximum="100000" Increment="10" FormatString="0" Value="{Binding MaxFailedRows}" Width="100" AutomationProperties.Name="실패 행 상한" />
                <CheckBox Content="트리거 끄기를 기본으로" IsChecked="{Binding DisableTriggersByDefault}" />
              </StackPanel>

              <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Classes="error" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <Grid ColumnDefinitions="*,6,360" MinHeight="300">
                <!-- 규칙 표 -->
                <DockPanel>
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="170,110,*,170" Margin="6,2" ColumnSpacing="6">
                    <TextBlock Text="테이블" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="규칙" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="조건" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="대상 처리" FontWeight="SemiBold" />
                  </Grid>
                  <ListBox x:Name="RuleList" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutomationProperties.Name="테이블 규칙">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="dc:TableRuleViewModel">
                        <Grid ColumnDefinitions="170,110,*,170" ColumnSpacing="6">
                          <TextBlock Text="{Binding Table}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Kind, Converter={x:Static dc:DataCopyConverters.RuleKindText}}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding ConditionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConditionText}" />
                          <TextBlock Grid.Column="3" Text="{Binding Action, Converter={x:Static dc:DataCopyConverters.ActionText}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="3" />

                <!-- 선택한 규칙 편집 -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="1" Padding="8">
                  <ScrollViewer DataContext="{Binding SelectedRule}" x:DataType="dc:TableRuleViewModel" HorizontalScrollBarVisibility="Disabled"
                                IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Table}" FontWeight="SemiBold" />
                      <Button x:Name="LoadColumnsButton" Classes="tool" Content="열 정보 읽기" icons:ButtonIcon.Key="refresh" HorizontalAlignment="Left"
                              IsVisible="{Binding !HasColumns}" ToolTip.Tip="원본에서 이 테이블의 열 정보를 읽어 기간 열·마스킹·건너뛸 열을 고를 수 있게 합니다" />
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                        <TextBlock Text="규칙" VerticalAlignment="Center" />
                        <ComboBox x:Name="KindBox" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="규칙 종류">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:RuleKind"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.RuleKindText}}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="대상 처리" VerticalAlignment="Center" />
                        <ComboBox x:Name="ActionBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="대상 처리">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:TargetAction"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.ActionText}}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                      <TextBlock Text="원본에서 지워진 행은 MERGE 가 남깁니다" IsVisible="{Binding IsMerge}" Opacity="0.65" TextWrapping="Wrap" FontSize="{DynamicResource OrandaFontSizeSmall}" />

                      <!-- 기간 규칙 -->
                      <StackPanel Spacing="4" IsVisible="{Binding IsPeriod}">
                        <TextBlock Text="기간 열" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding PeriodColumnOptions}" SelectedItem="{Binding FirstColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="기간 열">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dc:PeriodColumnOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding StringFormats}" HorizontalAlignment="Stretch" IsVisible="{Binding FirstFormatVisible}"
                                  IsEditable="True" Text="{Binding FirstFormat}" PlaceholderText="문자열 날짜 형식" AutomationProperties.Name="문자열 날짜 형식" />
                        <StackPanel Spacing="4" IsVisible="{Binding HasSecondColumn}">
                          <TextBlock Text="또는 두 번째 기간 열" />
                          <ComboBox ItemsSource="{Binding PeriodColumnOptions}" SelectedItem="{Binding SecondColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="두 번째 기간 열">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="dc:PeriodColumnOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ComboBox ItemsSource="{Binding StringFormats}" HorizontalAlignment="Stretch" IsVisible="{Binding SecondFormatVisible}"
                                    IsEditable="True" Text="{Binding SecondFormat}" PlaceholderText="문자열 날짜 형식" AutomationProperties.Name="두 번째 문자열 날짜 형식" />
                          <Button x:Name="RemoveSecondColumnButton" Classes="tool" Content="두 번째 열 빼기" icons:ButtonIcon.Key="remove" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Button x:Name="AddSecondColumnButton" Classes="tool" Content="두 번째 기간 열 더하기(OR)" icons:ButtonIcon.Key="add" HorizontalAlignment="Left"
                                IsVisible="{Binding CanAddSecondColumn}" ToolTip.Tip="생성 시각 또는 수정 시각처럼 두 열 중 하나라도 기간 안이면 복사합니다" />
                      </StackPanel>

                      <!-- 부모 키 규칙 -->
                      <StackPanel Spacing="4" IsVisible="{Binding IsParentKey}">
                        <TextBlock Text="부모 테이블(FK)" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding ParentCandidates}" SelectedItem="{Binding Parent}" HorizontalAlignment="Stretch" AutomationProperties.Name="부모 키 연결">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ParentLink"><TextBlock Text="{Binding ParentTable}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>

                      <!-- 직접 조건 -->
                      <StackPanel Spacing="4" IsVisible="{Binding IsCustom}">
                        <TextBlock Text="WHERE 조건" FontWeight="SemiBold" />
                        <TextBox Classes="compact" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Text="{Binding CustomWhere}" PlaceholderText=":FROM_DT, :TO_DT 를 쓸 수 있습니다"
                                 AutomationProperties.Name="직접 조건" />
                      </StackPanel>

                      <!-- 마스킹 -->
                      <StackPanel Spacing="4">
                        <TextBlock Text="마스킹(대상에 넣기 전에 바꿉니다)" FontWeight="SemiBold" />
                        <TextBlock Text="같은 값이 여러 표의 조인 키면 해시를 쓰세요" Opacity="0.65" TextWrapping="Wrap" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                        <ItemsControl ItemsSource="{Binding Masks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dc:MaskRowViewModel">
                              <Grid ColumnDefinitions="*,*,60" ColumnSpacing="4" Margin="0,1">
                                <TextBlock Text="{Binding Column}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AllowedKinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" AutomationProperties.Name="마스킹 방법">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:MaskKind"><TextBlock Text="{Binding ., Converter={x:Static dc:DataCopyConverters.MaskKindText}}" /></DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="2" Classes="compact" Text="{Binding Value}" IsVisible="{Binding NeedsValue}" AutomationProperties.Name="고정값" />
                                <NumericUpDown Grid.Column="2" Minimum="0" Maximum="200" FormatString="0" Value="{Binding Count}" IsVisible="{Binding NeedsCount}"
                                               AutomationProperties.Name="남길 글자 수" ShowButtonSpinner="False" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ComboBox x:Name="AddMaskBox" HorizontalAlignment="Stretch" PlaceholderText="마스킹할 열 추가…" AutomationProperties.Name="마스킹할 열 추가" />
                      </StackPanel>

                      <!-- 건너뛸 열 -->
                      <StackPanel Spacing="2" IsVisible="{Binding HasColumns}">
                        <TextBlock Text="건너뛸 열" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Skips}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dc:SkipColumnViewModel">
                              <CheckBox IsChecked="{Binding IsSkipped}" MinHeight="22"><TextBlock Text="{Binding Column}" /></CheckBox>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- 2단계: 사전 점검 -->
        <DockPanel IsVisible="{Binding IsPrecheck}">
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
                <Button x:Name="RunButton" Classes="tool" Content="복사 실행" icons:ButtonIcon.Key="run" IsEnabled="{Binding CanStartRun}"
                        ToolTip.Tip="점검에 오류가 없을 때만 실행할 수 있습니다. 확인이 필요한 문장은 이 단추로 미리 확인한 것으로 봅니다." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="1">
                <Button x:Name="BackToRulesButton" Classes="tool" Content="규칙 편집" icons:ButtonIcon.Key="up" ToolTip.Tip="규칙 편집으로 돌아갑니다" />
                <Button x:Name="RecheckButton" Classes="toolbar" Focusable="False" Content="다시 점검" icons:ButtonIcon.Key="refresh" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="다시 점검" IsEnabled="{Binding CanGoToPrecheck}" />
                <Button x:Name="CancelCheckButton" Classes="toolbar" Focusable="False" Content="점검 취소" icons:ButtonIcon.Key="cancel" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="점검(예상 건수 세기 포함) 취소" IsEnabled="{Binding Precheck.CanCancel}" />
                <Separator Classes="toolbar" />
                <Button x:Name="OpenScriptButton" Classes="toolbar" Focusable="False" Content="편집기로 열기" icons:ButtonIcon.Key="newSql" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="SQL 미리 보기를 새 SQL 탭으로 열기" />
                <Button x:Name="SaveScriptButton" Classes="toolbar" Focusable="False" Content="SQL 스크립트로 저장" icons:ButtonIcon.Key="save" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="SQL 스크립트로 저장" />
                <TextBlock Text="{Binding Precheck.ProgressText}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Classes="panel-status" IsVisible="{Binding Precheck.NeedsRetype}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="테이블을 지우는 문장이 있습니다. 대상 접속 이름을 다시 입력하면 목록 전체를 확인한 것으로 봅니다." VerticalAlignment="Center" />
              <TextBox Classes="compact" Width="220" Text="{Binding Precheck.RetypeInput}" AutomationProperties.Name="대상 접속 이름 다시 입력" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,6,*" Margin="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="점검 결과" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Precheck.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dc:CheckItemViewModel">
                      <Border BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="0,0,0,1" Padding="2,4">
                        <StackPanel Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <ContentControl Content="{Binding IconKey, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" MinWidth="56" Classes="level" Classes.error="{Binding IsError}"
                                       Classes.confirm="{Binding IsConfirm}" Classes.pass="{Binding IsPass}" />
                            <TextBlock Text="{Binding Table}" Opacity="0.75" />
                          </StackPanel>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="dc:CheckChoiceViewModel">
                                <StackPanel>
                                  <CheckBox IsChecked="{Binding IsChosen}" IsVisible="{Binding IsVisible}" MinHeight="22"
                                            Click="OnChoiceClick"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></CheckBox>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="3" />
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="SQL 미리 보기(대상에서 실행할 문장과 원본 조회)" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Precheck.Preview}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dc:PreviewRowViewModel">
                      <StackPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding SideText}" FontSize="{DynamicResource OrandaFontSizeSmall}" Opacity="0.7" />
                          <TextBlock Text="확인 필요" FontSize="{DynamicResource OrandaFontSizeSmall}" IsVisible="{Binding IsConfirm}" Foreground="{DynamicResource OrandaIconAmberBrush}" />
                          <TextBlock Text="실행할 수 없음" FontSize="{DynamicResource OrandaFontSizeSmall}" IsVisible="{Binding IsDenied}" Foreground="{DynamicResource OrandaIconRedBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Sql}" TextWrapping="Wrap" FontFamily="{DynamicResource OrandaCodeFontFamily}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </DockPanel>

        <!-- 3단계: 실행·검증 -->
        <Panel IsVisible="{Binding IsRun}">
        <DockPanel DataContext="{Binding Run}" x:DataType="dc:RunViewModel">
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding ReadStartedText, StringFormat='읽기 시작 {0}'}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding ReadStartedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="1">
                <Button x:Name="BackFromRunButton" Classes="tool" Content="규칙 편집" icons:ButtonIcon.Key="up" IsEnabled="{Binding !IsRunning}"
                        ToolTip.Tip="규칙 편집으로 돌아갑니다(복사가 도는 동안에는 먼저 중지하세요)" />
                <Separator Classes="toolbar" />
                <Button x:Name="PauseButton" Classes="toolbar" Focusable="False" Content="일시 정지" icons:ButtonIcon.Key="timer" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="일시 정지(지금 배치가 끝난 뒤 멈춥니다)" IsEnabled="{Binding CanPause}" />
                <Button x:Name="ResumeButton" Classes="toolbar" Focusable="False" Content="계속" icons:ButtonIcon.Key="run" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="계속" IsEnabled="{Binding CanResume}" />
                <Button x:Name="StopButton" Classes="toolbar" Focusable="False" Content="중지" icons:ButtonIcon.Key="cancel" icons:ButtonIcon.IconOnly="True"
                        ToolTip.Tip="중지(현재 배치를 되돌리고 끈 트리거·FK 를 다시 켠 뒤 끝냅니다)" IsEnabled="{Binding CanStop}" />
                <Separator Classes="toolbar" />
                <Button x:Name="RetryButton" Classes="tool" Content="실패 행만 다시 넣기" icons:ButtonIcon.Key="reset" IsEnabled="{Binding CanRetry}" />
                <Button x:Name="CsvButton" Classes="tool" Content="CSV로 저장" icons:ButtonIcon.Key="exportFile" IsEnabled="{Binding HasFailedRows}"
                        ToolTip.Tip="실패 행의 키와 오류 메시지를 CSV 파일로 저장합니다(누를 때만 저장)" />
              </StackPanel>
              <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
            </DockPanel>
          </Border>
          <Grid RowDefinitions="*,6,*" Margin="8">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="180,*,120,150,*" ColumnSpacing="6" Margin="4,0,4,2">
                <TextBlock Text="테이블" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="진행" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="단계" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="원본 → 대상 건수" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="결과" FontWeight="SemiBold" />
              </Grid>
              <ListBox ItemsSource="{Binding Rows}" AutomationProperties.Name="테이블별 진행">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="dc:TableRunRowViewModel">
                    <Grid ColumnDefinitions="180,*,120,150,*" ColumnSpacing="6">
                      <TextBlock Text="{Binding Table}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="8" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Phase}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding CountsText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Message}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <GridSplitter Grid.Row="1" Height="3" />
            <DockPanel Grid.Row="2">
              <TextBlock DockPanel.Dock="Top" Text="실패한 행(키와 오류)" FontWeight="SemiBold" Margin="4,0,0,2" />
              <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Notices}" Margin="4,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.8" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox ItemsSource="{Binding FailedRows}" AutomationProperties.Name="실패한 행">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="dc:FailedRowViewModel">
                    <Grid ColumnDefinitions="140,*,*" ColumnSpacing="6">
                      <TextBlock Text="{Binding Table}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding KeyText}" FontFamily="{DynamicResource OrandaCodeFontFamily}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Error}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
