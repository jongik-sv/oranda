<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.Execution"
             xmlns:binds="using:Oranda.App.Features.Binds"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             x:Class="Oranda.App.Features.Execution.BindVariablesView"
             x:DataType="vm:BindVariablesViewModel">
  <UserControl.Styles>
    <!-- 표 칸: 입력 칸·콤보는 테두리 없이 칸을 채우고, 칸 사이는 가는 선으로 나눈다(오렌지 Bind Variable List 처럼). -->
    <!-- 격자 양식은 Styles/GridC(ListBox.grid-c·Border.grid-c-header·Border.grid-c-cell). 여기서는 입력 칸·콤보를 칸에 채우는 것만 더한다. -->
    <Style Selector="Border.grid-c-cell.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaDangerForegroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.cell">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource OrandaCodeFontFamily}" />
    </Style>
    <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="ComboBox.cell">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <!-- 오렌지 Bind Variable List: 번호 | 변수 | 값 | 형식, 오렌지 8.0 의 방향(IN/OUT). 실행은 묻지 않고 이 값을 쓴다. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <StackPanel Orientation="Horizontal" Spacing="1">
        <Button Classes="toolbar" Content="바인드 변수 더하기" Command="{Binding AddCommand}" icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Content="고른 변수 지우기" Command="{Binding DeleteCommand}" icons:ButtonIcon.Key="remove" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Content="목록 비우기" Command="{Binding ClearCommand}" icons:ButtonIcon.Key="eraser" icons:ButtonIcon.IconOnly="True" />
        <Separator Classes="toolbar" />
        <Button Classes="toolbar" Content="편집기에 값 붙여 넣기" Command="{Binding PasteIntoEditorCommand}" icons:ButtonIcon.Key="docEdit" icons:ButtonIcon.IconOnly="True" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
    <!-- 창이 표의 최소 폭보다 좁으면 방향 열을 자르지 않고 가로로 스크롤한다.
         열 폭은 표 폭(창 폭, 최소 232)에서 픽셀로 계산해 머리글과 모든 줄에 같은 값을 넣는다(코드 숨김 ApplyColumns).
         * 열을 줄마다 두면 처음 무한 폭으로 잰 줄이 글자 폭을 따라가 열이 어긋난다. -->
    <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <DockPanel x:Name="Table" MinWidth="232">
    <Border DockPanel.Dock="Top" Classes="grid-c-header">
      <Grid x:Name="HeaderGrid" Height="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="2*" MinWidth="44" />
          <ColumnDefinition Width="3.5*" MinWidth="48" />
          <ColumnDefinition Width="2*" MinWidth="64" />
          <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Classes="grid-c-cell" Padding="0"><TextBlock Classes="head" Text="#" HorizontalAlignment="Center" Margin="0" /></Border>
        <Border Grid.Column="1" Classes="grid-c-cell" Padding="0"><TextBlock Classes="head" Text="변수" /></Border>
        <Border Grid.Column="2" Classes="grid-c-cell" Padding="0"><TextBlock Classes="head" Text="값" /></Border>
        <Border Grid.Column="3" Classes="grid-c-cell" Padding="0"><TextBlock Classes="head" Text="자료형" /></Border>
        <Border Grid.Column="4" Classes="grid-c-cell" Padding="0"><TextBlock Classes="head" Text="방향" /></Border>
      </Grid>
    </Border>
    <!-- 목록 자체의 가로 스크롤을 끈다: 켜 두면 줄을 무한 폭으로 재서 * 열이 줄마다 글자 폭을 따라간다(가로 스크롤은 바깥 TableScroll 이 한다). -->
    <ListBox x:Name="RowList" Classes="grid-c" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             keymaps:EditKeyScope.Owns="True"
             AutomationProperties.Name="바인드 변수 목록">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="복사" InputGesture="Ctrl+C" Click="OnCopyClick" />
          <MenuItem Header="전체 복사" Click="OnCopyAllClick" />
          <MenuItem Header="머리글 포함 복사" Click="OnCopyWithHeaderClick" />
          <MenuItem Header="붙여 넣기" InputGesture="Ctrl+V" Click="OnPasteClick" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="binds:BindVariableRow">
          <Grid Classes="row" Loaded="OnRowGridLoaded">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="2*" MinWidth="44" />
              <ColumnDefinition Width="3.5*" MinWidth="48" />
              <ColumnDefinition Width="2*" MinWidth="64" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Classes="grid-c-cell row-head" Padding="0">
              <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
            </Border>
            <Border Grid.Column="1" Classes="grid-c-cell" Padding="0">
              <TextBox x:Name="NameBox" Classes="cell" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="이름"
                       AutomationProperties.Name="바인드 변수 이름" />
            </Border>
            <Border Grid.Column="2" Classes="grid-c-cell" Padding="0" Classes.invalid="{Binding HasValueError}"
                    ToolTip.Tip="{Binding ValueError}">
              <TextBox x:Name="ValueBox" Classes="cell" LostFocus="OnValueLostFocus" Text="{Binding Text, Mode=TwoWay}" PlaceholderText="NULL"
                       AutomationProperties.Name="바인드 변수 값" />
            </Border>
            <Border Grid.Column="3" Classes="grid-c-cell" Padding="0">
              <ComboBox Classes="cell" ItemsSource="{x:Static binds:BindTypeChoice.All}"
                        SelectedItem="{Binding TypeChoice, Mode=TwoWay}" AutomationProperties.Name="바인드 변수 형식">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="binds:BindTypeChoice">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Border>
            <Border Grid.Column="4" Classes="grid-c-cell" Padding="0">
              <ComboBox Classes="cell" ItemsSource="{x:Static binds:BindDirectionChoice.All}"
                        SelectedItem="{Binding DirectionChoice, Mode=TwoWay}" AutomationProperties.Name="바인드 변수 방향">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="binds:BindDirectionChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
