<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.Execution"
             x:Class="Oranda.App.Features.Execution.ResultTabsView"
             x:DataType="vm:ResultTabsViewModel">
  <UserControl.Styles>
    <!-- 고정한 결과 탭의 핀(GRID-06). 누르면 고정을 푼다. -->
    <Style Selector="Button.tab-pin">
      <Setter Property="Padding" Value="1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab-close">
      <Setter Property="Padding" Value="2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab-close:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 탭 머리 줄 오른쪽 끝을 Excel 단추 자리로 비워 둔다(탭이 많으면 탭 쪽이 줄어들어 단추는 가려지지 않는다). -->
    <Style Selector="TabControl#Tabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="0,0,34,0" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- 접속 라벨 띠(운영 = 빨강, ui-shell.md 4.2). 개발 접속이고 읽기 전용이 아니면 숨긴다. -->
    <Border x:Name="BannerBorder" DockPanel.Dock="Top" Padding="8,2" BorderThickness="0,3,0,0"
            IsVisible="{Binding HasBanner}">
      <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 AutomationProperties.Name="접속 라벨" />
    </Border>
    <Grid>
    <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected, Mode=TwoWay}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ResultTabItem">
          <StackPanel Orientation="Horizontal">
            <StackPanel.ContextMenu>
              <ContextMenu IsEnabled="{Binding IsClosable}">
                <MenuItem Header="결과 탭 닫기" Command="{Binding CloseTabCommand}" />
              </ContextMenu>
            </StackPanel.ContextMenu>
            <Button Classes="tab-pin" Content="결과 탭 고정 풀기" Focusable="False" IsVisible="{Binding IsPinned}"
                    Command="{Binding UnpinCommand}" icons:ButtonIcon.Key="pin" icons:ButtonIcon.IconOnly="True" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            <Button Classes="tab-close" Content="결과 탭 닫기" Focusable="False" IsVisible="{Binding IsClosable}"
                    Command="{Binding CloseTabCommand}" icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ResultTabItem">
          <Grid>
            <ContentControl Content="{Binding Pane}" IsVisible="{Binding HasPane}" />
            <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" IsVisible="{Binding HasMessage}"
                     FontFamily="{StaticResource OrandaCodeFontFamily}" />
          </Grid>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
    <!-- 선택한 결과 탭의 결과를 Excel 로 내보낸다(oranda.grid.exportExcel). 결과 그리드가 없는 탭이면 꺼진다. -->
    <Button x:Name="ExcelButton" Classes="toolbar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
            Focusable="False" Tag="oranda.grid.exportExcel" Content="Excel 로 내보내기"
            IsEnabled="{Binding Selected.HasPane, FallbackValue=False}"
            icons:ButtonIcon.Key="excel" icons:ButtonIcon.IconOnly="True" />
    <!-- 문장을 실행하는 동안(결과가 오기 전까지) 결과 영역 위쪽 가장자리에 겹치는 얇은 막대. 끝·오류·취소에 사라진다. -->
    <ProgressBar x:Name="RunBar" IsIndeterminate="True" IsVisible="{Binding IsRunBarVisible}" Height="2" MinHeight="2"
                 VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.Name="쿼리를 실행하는 중" />
    </Grid>
  </DockPanel>
</UserControl>
