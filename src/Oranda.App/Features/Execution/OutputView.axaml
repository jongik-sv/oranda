<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.Execution"
             x:Class="Oranda.App.Features.Execution.OutputView"
             x:DataType="vm:OutputViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="toolbar" Content="출력 지우기" Command="{Binding ClearCommand}"
                icons:ButtonIcon.Key="eraser" icons:ButtonIcon.IconOnly="True" />
        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Margin="6,0" Classes="panel-caption" />
      </DockPanel>
    </Border>
    <TextBox x:Name="OutputBox" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
             FontFamily="Cascadia Mono,Consolas,Menlo,monospace" TextWrapping="NoWrap"
             AutomationProperties.Name="DBMS 출력" />
  </DockPanel>
</UserControl>
