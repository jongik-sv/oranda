<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="using:Oranda.App.Features.Ai.Tuning"
        x:Class="Oranda.App.Features.Ai.Tuning.TuningStartDialog"
        x:DataType="t:TuningStartViewModel"
        Title="AI 튜닝 시작"
        Width="470" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <!-- AI 튜닝 시작 확인(시안 9): 대상 문장 · 공유 풀 · 먼저 보낼 것 / 요청 시 줄 것 / 보내지 않음 · 벤치마크·인덱스 문안·모델 · 취소/튜닝 시작. -->
  <StackPanel Margin="14" Spacing="10">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding Info.Title}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Info.StatementSummary}" Opacity="0.7" FontSize="{DynamicResource OrandaFontSizeSmall}"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Border x:Name="BlockedBanner" IsVisible="{Binding IsBlocked}" Padding="8,6" CornerRadius="4"
            BorderBrush="{DynamicResource OrandaUncommittedBrush}" BorderThickness="1">
      <TextBlock Text="{Binding BlockedMessage}" TextWrapping="Wrap" FontSize="{DynamicResource OrandaFontSizeSmall}" />
    </Border>

    <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
      <Grid.Styles>
        <Style Selector="TextBlock">
          <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Row="0" Text="공유 풀" Opacity="0.7" IsVisible="{Binding HasSharedPoolLine}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Info.SharedPoolLine}" TextWrapping="Wrap" IsVisible="{Binding HasSharedPoolLine}" />
      <TextBlock Grid.Row="1" Text="먼저 보낼 것" Opacity="0.7" />
      <TextBlock x:Name="SendFirstText" Grid.Row="1" Grid.Column="1" Text="{Binding Info.SendFirst}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Text="요청 시 줄 것" Opacity="0.7" />
      <TextBlock x:Name="SendOnRequestText" Grid.Row="2" Grid.Column="1" Text="{Binding Info.SendOnRequest}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="3" Text="보내지 않음" Opacity="0.7" />
      <TextBlock x:Name="NotSentText" Grid.Row="3" Grid.Column="1" Text="{Binding Info.NotSent}" TextWrapping="Wrap" />
    </Grid>

    <TextBlock x:Name="MaskLine" Text="리터럴 :vN 가림" IsVisible="{Binding MasksLiterals}" Opacity="0.7"
               FontSize="{DynamicResource OrandaFontSizeSmall}"
               ToolTip.Tip="문자열·숫자 값은 :v1, :v2 같은 자리표시로 바꿔 보내고, 제안을 편집기에 넣을 때 원래 값으로 되돌립니다." />
    <Border x:Name="ProductionBanner" IsVisible="{Binding IsProduction}" Padding="8,6" CornerRadius="4"
            BorderBrush="{DynamicResource OrandaUncommittedBrush}" BorderThickness="1">
      <TextBlock x:Name="ProductionNoticeText" Text="{Binding ProductionNotice}" TextWrapping="Wrap"
                 FontSize="{DynamicResource OrandaFontSizeSmall}" />
    </Border>

    <Border Height="1" Background="{DynamicResource OrandaSeparatorBrush}" />

    <StackPanel Spacing="6">
      <CheckBox x:Name="BenchmarkCheck" IsChecked="{Binding Benchmark}" IsEnabled="{Binding BenchmarkEnabled}"
                Content="후보를 벤치마크로 비교 (SELECT 3회, 결과 동일성 확인)"
                ToolTip.Tip="{Binding BenchmarkNote}" />
      <CheckBox x:Name="RiskyFunctionsCheck" IsChecked="{Binding RunRiskyFunctions}" IsEnabled="{Binding Benchmark}" Margin="24,0,0,0"
                Content="위험 함수도 실행 (자치 트랜잭션·외부 접근 함수가 든 후보도 읽기 전용으로 실측)"
                ToolTip.Tip="끄면 그런 후보는 실행하지 않고 운영 커서 실측을 씁니다. 켜도 자치 트랜잭션의 커밋은 막지 못합니다." />
      <CheckBox x:Name="IndexDdlCheck" IsChecked="{Binding IndexDdl}"
                Content="인덱스 후보 CREATE 문안도 받기 (새 탭에만 넣고 실행하지 않음)" />
      <Grid ColumnDefinitions="Auto,*,Auto,110" ColumnSpacing="10">
        <TextBlock Text="모델" VerticalAlignment="Center" Opacity="0.7" />
        <ComboBox x:Name="ModelCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" AutomationProperties.Name="모델">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="t:TuningModelOption">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="2" Text="effort" VerticalAlignment="Center" Opacity="0.7" />
        <ComboBox x:Name="EffortCombo" Grid.Column="3" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}" AutomationProperties.Name="effort"
                  ToolTip.Tip="추론 노력(claude --effort). 높을수록 오래 생각하고 느립니다. 기본 값은 설정 창 AI 쪽에서 바꿉니다.">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="t:TuningEffortOption">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="취소" IsCancel="True" />
      <Button x:Name="StartButton" Content="튜닝 시작" Command="{Binding StartCommand}" IsDefault="True" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
