<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ext="using:Oranda.App.Features.Ai.External.Editor"
             x:Class="Oranda.App.Features.Ai.External.Editor.AgentEditorBar"
             x:DataType="ext:AgentEditorBarViewModel"
             IsVisible="{Binding IsVisible}">
  <!-- 밖의 에이전트 띠(설계 agent-cli-control §6.1): 「Claude Code 가 편집을 제안했습니다 · 제목」 · 대기 N · [비교 보기] [받아들이기] [버리기]. 모달을 먼저 띄우지 않는다. -->
  <Border x:Name="AgentBarBorder" BorderThickness="4,1,1,1" CornerRadius="8" BorderBrush="{DynamicResource OrandaButtonAccentBrush}"
          Background="{DynamicResource OrandaToolbarBackgroundBrush}" Padding="10,5">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="AgentBarHeadline" Text="{Binding Headline}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="AgentBarQueue" Text="{Binding QueueText}" IsVisible="{Binding HasQueue}" Opacity="0.7"
                     FontSize="{DynamicResource OrandaFontSizeSmall}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="AgentBarDetail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" Opacity="0.85" />
        <TextBlock x:Name="AgentBarStatus" Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.8" FontSize="{DynamicResource OrandaFontSizeSmall}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="AgentBarCompare" Classes="tool" Content="비교 보기" Command="{Binding CompareCommand}" IsVisible="{Binding ShowsCompare}"
                ToolTip.Tip="바뀌는 곳을 봅니다(글은 바뀌지 않습니다)" AutomationProperties.Name="비교 보기" />
        <Button x:Name="AgentBarAccept" Classes="accent" Content="{Binding AcceptLabel}" Command="{Binding AcceptCommand}" IsVisible="{Binding ShowsAccept}"
                AutomationProperties.Name="{Binding AcceptLabel}" />
        <Button x:Name="AgentBarDiscard" Classes="tool" Content="{Binding DiscardLabel}" Command="{Binding DiscardCommand}"
                AutomationProperties.Name="{Binding DiscardLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
