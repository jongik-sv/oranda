<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.Ai.Chat"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             x:Class="Oranda.App.Features.Ai.Chat.AiChatView"
             x:DataType="vm:AiChatViewModel">
  <!-- AI 대화 창 최소판(시안 8): 제목 줄 · 사용자 글 / 도구 묶음 한 줄(펼치면 카드) / AI 글 · 제안 카드 · 이어 말하기 입력 · 상태 · 멈춤/보내기. -->
  <UserControl.Styles>
    <!-- 아이콘만 있는 작은 단추: 공통 최소 폭(84)을 쓰지 않는다. -->
    <Style Selector="Button.aiIconButton">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <!-- 도구 묶음 머리 줄: 펼친 채(:checked)에도 강조색으로 바뀌지 않는 옅은 회색 줄. -->
    <Style Selector="ToggleButton.toolGroup">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolGroup:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolGroup:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolGroup:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <!-- 이미지 첨부 단추가 꺼지면(이미지 미지원 프로필) 클립 그림도 흐리게. -->
    <Style Selector="Button#AttachButton:disabled Path">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- 실행 중 회전 표식. 움직이는 동안만 aiSpin 을 달아, 쉬는 동안에는 애니메이션이 화면을 다시 그리지 않게 한다. -->
    <Style Selector="Arc.aiSpinner">
      <Setter Property="StartAngle" Value="0" />
      <Setter Property="SweepAngle" Value="270" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Stroke" Value="{DynamicResource OrandaIconBlueBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Arc.aiSpinner.slow">
      <Setter Property="Stroke" Value="{DynamicResource OrandaWarningForegroundBrush}" />
    </Style>
    <Style Selector="Arc.aiSpin">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- 끝난 차례의 결과 줄 색: 완료는 초록, 오류는 경고색, 멈춤은 기본 글자색. -->
    <Style Selector="TextBlock.aiResult.completed">
      <Setter Property="Foreground" Value="{DynamicResource OrandaSuccessForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.aiResult.failed">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- 제목 줄: 제목 · 오른쪽 아이콘 단추 「튜닝 결과 레포트 저장」(튜닝 결과가 있고 실행 중이 아닐 때만 켜진다. 툴팁이 단추 이름). -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="10,4,4,4">
      <TextBlock x:Name="TitleText" Text="{Binding Title}" VerticalAlignment="Center" Opacity="0.8"
                 FontSize="{DynamicResource OrandaFontSizeSmall}" TextTrimming="CharacterEllipsis" />
      <!-- 지금 대화가 쓰는 모델(프로필 이름 또는 Claude Code). 설정을 모르면 비어 있다. -->
      <TextBlock x:Name="ModelLabelText" Grid.Column="1" Text="{Binding ModelLabel}" VerticalAlignment="Center" Opacity="0.65"
                 FontSize="{DynamicResource OrandaFontSizeSmall}" TextTrimming="CharacterEllipsis" MaxWidth="140" ToolTip.Tip="{Binding ModelLabel}" />
      <!-- 새 일반 대화로 되돌린다(앞 줄·이어 말하기 id 를 지운다). 실행 중에는 꺼진다. -->
      <Button x:Name="NewConversationButton" Grid.Column="2" Classes="toolbar" Focusable="False" Content="새 대화"
              Command="{Binding NewConversationCommand}" icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True" />
      <Button x:Name="SaveReportButton" Grid.Column="3" Classes="toolbar" Focusable="False" Content="튜닝 결과 레포트 저장"
              Command="{Binding SaveReportCommand}" icons:ButtonIcon.Key="save" icons:ButtonIcon.IconOnly="True" />
    </Grid>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="0,1,0,0" Padding="8">
      <StackPanel x:Name="InputPanel" Spacing="6">
        <!-- 입력은 처음부터 열려 있다: 튜닝 없이 묻고 요청할 수 있다. 줄이 없을 때만 안내하고, AI 를 쓸 수 없는 원인이 있으면 그것을 대신 보인다(입력은 그대로 받는다). -->
        <TextBlock x:Name="StartHint" Text="무엇이든 물어보세요. 문장 튜닝은 편집기에서 「AI 튜닝」 으로 시작합니다." IsVisible="{Binding ShowStartHint}"
                   TextWrapping="Wrap" Opacity="0.7" FontSize="{DynamicResource OrandaFontSizeSmall}" />
        <TextBlock x:Name="UnavailableHint" Text="{Binding UnavailableReason}" IsVisible="{Binding HasUnavailableReason}" TextWrapping="Wrap"
                   Foreground="{DynamicResource OrandaWarningForegroundBrush}" FontSize="{DynamicResource OrandaFontSizeSmall}" />
        <!-- 붙인 이미지: 축소 이미지와 ✕(빼기). 한 줄에 여러 장이 들어가고 넘치면 가로로 스크롤한다. -->
        <ScrollViewer x:Name="AttachmentScroll" IsVisible="{Binding HasAttachments}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="AttachmentList" ItemsSource="{Binding Attachments}" AutomationProperties.Name="붙인 이미지">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatImage">
                <Border Width="132" Height="84" CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                        BorderBrush="{DynamicResource OrandaSeparatorBrush}" Background="{DynamicResource OrandaToolbarBackgroundBrush}"
                        ToolTip.Tip="{Binding Description}">
                  <Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                    <Button x:Name="RemoveAttachmentButton" Classes="aiIconButton" Width="20" Height="20" MinHeight="0" Padding="0" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                            Background="{DynamicResource SystemControlForegroundBaseHighBrush}" BorderThickness="0"
                            Command="{Binding $parent[ItemsControl].((vm:AiChatViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="이미지 빼기" ToolTip.Tip="이미지 빼기">
                      <Path Data="M1 1l6 6M7 1 1 7" Stroke="{DynamicResource SystemControlBackgroundAltHighBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="None"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="AttachNoticeText" Text="{Binding AttachNotice}" IsVisible="{Binding HasAttachNotice}" TextWrapping="Wrap"
                   Foreground="{DynamicResource OrandaWarningForegroundBrush}" FontSize="{DynamicResource OrandaFontSizeSmall}" />
        <TextBox x:Name="DraftBox" Text="{Binding Draft, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="120"
                 PlaceholderText="AI 에게 묻거나 요청하세요. 이미지는 붙여 넣거나 끌어 놓으세요." IsEnabled="{Binding CanType}" AutomationProperties.Name="AI 에게 보낼 글">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
          <!-- 이미지 첨부(파일 선택). 활성 프로필이 이미지를 지원하지 않으면 꺼지고 툴팁이 이유를 알린다. -->
          <Button x:Name="AttachButton" Classes="aiIconButton" Width="30" Height="28" MinHeight="0" Padding="0" IsEnabled="{Binding CanAttach}" AutomationProperties.Name="이미지 첨부"
                  ToolTip.ShowOnDisabled="True">
            <ToolTip.Tip>
              <TextBlock x:Name="AttachTip" MaxWidth="260" TextWrapping="Wrap" Text="{Binding ImagesBlockedReason, TargetNullValue=이미지 첨부}" />
            </ToolTip.Tip>
            <Path Data="M13 7.5 8 12.5a3 3 0 0 1-4.3-4.3L9 3a2 2 0 0 1 2.8 2.8L6.6 11a1 1 0 0 1-1.4-1.4L10 5" Width="16" Height="16" Stretch="None"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
          </Button>
          <TextBlock x:Name="StatusLine" Grid.Column="1" Text="{Binding FooterText}" VerticalAlignment="Center" Opacity="0.7"
                     FontSize="{DynamicResource OrandaFontSizeSmall}" />
          <Button x:Name="StopButton" Grid.Column="2" Classes="tool" Content="멈춤" icons:ButtonIcon.Key="cancel" Command="{Binding StopCommand}" />
          <Button x:Name="SendButton" Grid.Column="3" Classes="tool" Content="보내기" icons:ButtonIcon.Key="run" Command="{Binding SendCommand}" />
        </Grid>
      </StackPanel>
    </Border>
    <!-- 복사 키(Ctrl/Cmd+C)는 이 영역이 스스로 처리한다(여러 문단에 걸친 선택 복사). 주 창 키맵·시스템 메뉴가 편집기 복사로 가져가지 않게 표시한다. -->
    <ScrollViewer x:Name="ConversationScroll" HorizontalScrollBarVisibility="Disabled" keymaps:EditKeyScope.Owns="True">
      <StackPanel x:Name="ConversationContent" Margin="8">
      <ItemsControl x:Name="EntryList" ItemsSource="{Binding Entries}" AutomationProperties.Name="대화">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- 간격은 항목마다 아래 여백으로 둔다: 접힌 묶음의 감춘 카드는 자리를 차지하지 않는다. -->
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>
          <DataTemplate x:DataType="vm:ChatUserEntry">
            <Border HorizontalAlignment="Right" MaxWidth="360" Padding="10,6" CornerRadius="8,8,2,8" Margin="0,0,0,10"
                    Background="{DynamicResource OrandaToolbarPressedBrush}">
              <StackPanel Spacing="6">
                <!-- 보낸 이미지: 축소 이미지만 보인다(메모리에만 있고 저장하지 않는다). -->
                <ItemsControl x:Name="SentImages" ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatImage">
                      <Border Width="132" Height="84" CornerRadius="6" BorderThickness="1" ClipToBounds="True" Margin="0,0,6,6"
                              BorderBrush="{DynamicResource OrandaSeparatorBrush}" Background="{DynamicResource OrandaToolbarBackgroundBrush}"
                              ToolTip.Tip="{Binding Description}">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 사용자 글도 AI 글처럼 드래그로 고르고 여러 문단과 함께 복사한다. -->
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding HasText}"
                                     SelectionBrush="{DynamicResource OrandaEditorSelectionBrush}" ContextFlyout="{x:Static vm:ChatTextSelection.CopyFlyout}" />
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate x:DataType="vm:ChatToolGroupEntry">
            <!-- 도구 묶음 머리 줄: 「도구 N개 실행 · 합계 초 · 모두 허용」. 누르면 아래 카드 목록을 펼치고 접는다. 실행 중엔 펼친 채, 끝나면 접힌다. -->
            <ToggleButton x:Name="ToolGroupToggle" Classes="toolGroup" Margin="0,0,0,6" IsChecked="{Binding Group.IsExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Group.Summary}">
              <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                <Arc x:Name="ToolGroupSpinner" Classes="aiSpinner" Classes.aiSpin="{Binding Group.IsToolRunning}" Width="10" Height="10" HorizontalAlignment="Left"
                     IsVisible="{Binding Group.IsToolRunning}" />
                <TextBlock Text="{Binding Group.Mark}" FontWeight="Bold" FontSize="{DynamicResource OrandaFontSizeSmall}"
                           Foreground="{DynamicResource OrandaSuccessForegroundBrush}" IsVisible="{Binding Group.ShowDoneMark}" />
                <TextBlock Text="{Binding Group.Mark}" FontWeight="Bold" FontSize="{DynamicResource OrandaFontSizeSmall}"
                           Foreground="{DynamicResource OrandaWarningForegroundBrush}" IsVisible="{Binding Group.ShowProblemMark}" />
                <TextBlock x:Name="ToolGroupSummary" Grid.Column="1" Text="{Binding Group.Summary}" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource OrandaFontSizeSmall}" ToolTip.Tip="{Binding Group.Summary}" />
                <TextBlock Grid.Column="2" Text="{Binding Group.ToggleText}" Opacity="0.65" FontSize="{DynamicResource OrandaFontSizeSmall}" />
              </Grid>
            </ToggleButton>
          </DataTemplate>
          <DataTemplate x:DataType="vm:ChatToolEntry">
            <!-- 도구 카드: 사람 말 한 줄(제목·핵심 인자) · 걸린 시간 · 응답 크기 · 판단, 거부·실패면 사유 한 줄. 펼치면 도구 이름·인자(가린 글 그대로)·사유 코드. 묶음이 접히면 감춘다. -->
            <Expander x:Name="ToolCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" Margin="12,0,0,4"
                      IsVisible="{Binding Group.IsExpanded, FallbackValue=True}" AutomationProperties.Name="{Binding Headline}">
              <Expander.Header>
                <Grid ColumnDefinitions="16,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" ClipToBounds="True">
                  <Arc x:Name="ToolCardSpinner" Classes="aiSpinner" Classes.aiSpin="{Binding IsSpinning}" Width="10" Height="10" HorizontalAlignment="Left"
                       IsVisible="{Binding IsSpinning}" />
                  <TextBlock Text="{Binding Mark}" Opacity="0.8" FontSize="{DynamicResource OrandaFontSizeSmall}" IsVisible="{Binding ShowMark}" />
                  <TextBlock Grid.Column="1" Text="{Binding Headline}" TextTrimming="CharacterEllipsis"
                             FontSize="{DynamicResource OrandaFontSizeSmall}" ToolTip.Tip="{Binding Headline}" />
                  <TextBlock Grid.Column="2" Text="{Binding Elapsed}" Opacity="0.6" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                  <TextBlock Grid.Column="3" Text="{Binding ResponseSize}" Opacity="0.6" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                  <TextBlock Grid.Column="4" Text="{Binding Verdict}" MinWidth="36" TextAlignment="Right" Opacity="0.8"
                             FontSize="{DynamicResource OrandaFontSizeSmall}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Reason}" IsVisible="{Binding HasReason}" TextWrapping="Wrap"
                             Foreground="{DynamicResource OrandaWarningForegroundBrush}" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                </Grid>
              </Expander.Header>
              <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFamily="{DynamicResource OrandaCodeFontFamily}" Opacity="0.85"
                                   FontSize="{DynamicResource OrandaFontSizeSmall}"
                                   SelectionBrush="{DynamicResource OrandaEditorSelectionBrush}" ContextFlyout="{x:Static vm:ChatTextSelection.CopyFlyout}" />
            </Expander>
          </DataTemplate>
          <DataTemplate x:DataType="vm:ChatProposalEntry">
            <!-- 재작성 제안 카드(c6·st-4): 「제안」 배지 · 이름 · 변화율(벤치마크 있을 때만) · 한 줄 요약 · 「비교 다시 보기」「적용」.
                 편집기 글은 비교 창에서 받아들일 때만 바뀐다(두 단추 모두 같은 비교 창을 연다. 「적용」 은 그 창의 받아들이기로 끝난다). 받아들인 제안은 「적용함」 과
                 「비교 보기」(원본과 적용한 글을 보기만 하는 비교 창). -->
            <Border Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource OrandaButtonAccentBrush}" Margin="0,0,0,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Border Padding="6,1" CornerRadius="4" Background="{DynamicResource OrandaButtonAccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="제안" FontWeight="Bold" Foreground="White" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                  </Border>
                  <TextBlock x:Name="ProposalLabel" Grid.Column="1" Text="{Binding Label}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding Headline}" />
                  <TextBlock x:Name="ProposalChange" Grid.Column="2" Text="{Binding Change}" IsVisible="{Binding HasChange}" VerticalAlignment="Center"
                             FontFamily="{DynamicResource OrandaCodeFontFamily}" Foreground="{DynamicResource OrandaIconBlueBrush}" />
                </Grid>
                <TextBlock Text="{Binding Summary}" Opacity="0.75" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding Summary}"
                           FontSize="{DynamicResource OrandaFontSizeSmall}" />
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Applied}">
                  <TextBlock x:Name="AppliedMark" Text="적용함" VerticalAlignment="Center"
                             Foreground="{DynamicResource OrandaSuccessForegroundBrush}" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                  <Button x:Name="ViewAppliedButton" Grid.Column="1" Content="비교 보기" MinHeight="30" IsVisible="{Binding CanView}"
                          Command="{Binding $parent[ItemsControl].((vm:AiChatViewModel)DataContext).ViewProposalCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="원본과 적용한 제안을 비교 창으로 봅니다" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding CanReview}">
                  <Button x:Name="ReviewButton" Content="비교 다시 보기" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="30"
                          Command="{Binding $parent[ItemsControl].((vm:AiChatViewModel)DataContext).ReviewProposalCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="제안 비교 창을 다시 엽니다" />
                  <Button x:Name="ApplyButton" Grid.Column="1" Classes="accent" Content="적용" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="30"
                          Command="{Binding $parent[ItemsControl].((vm:AiChatViewModel)DataContext).ReviewProposalCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="비교 창에서 확인하고 받아들이면 새 탭에 넣습니다" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate x:DataType="vm:ChatAssistantEntry">
            <!-- AI 글: Markdown 부분 집합으로 그린다. 글 선택·복사가 된다(SelectableTextBlock). -->
            <vm:MarkdownView Markdown="{Binding Text}" Margin="0,0,0,12" />
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
      <!-- 진행 줄(시안 A): 실행 중에만 대화 끝에 보인다. 지금 하는 일과 이번 차례 경과 시간. 새 소식이 오래 없으면 경고 색과 멈춤 안내로 바뀐다. -->
      <StackPanel x:Name="ProgressPanel" Spacing="4" Margin="0,2,0,4" IsVisible="{Binding IsRunning}">
        <Border x:Name="ProgressRow" Padding="10,8" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource OrandaTableSelectionBrush}" BorderBrush="{DynamicResource OrandaTableSelectionBrush}"
                IsVisible="{Binding ShowProgressNormal}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Arc x:Name="ProgressSpinner" Classes="aiSpinner" Classes.aiSpin="{Binding ShowProgressNormal}" Width="14" Height="14" />
            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="{Binding ProgressText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" ToolTip.Tip="{Binding ProgressText}" />
            <TextBlock x:Name="ProgressElapsed" Grid.Column="2" Text="{Binding ProgressElapsed}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border x:Name="ProgressSlowRow" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OrandaWarningForegroundBrush}"
                IsVisible="{Binding IsProgressSlow}">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Arc Classes="aiSpinner slow" Classes.aiSpin="{Binding IsProgressSlow}" Width="14" Height="14" />
              <TextBlock x:Name="ProgressSlowText" Grid.Column="1" Text="{Binding ProgressText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                         Foreground="{DynamicResource OrandaWarningForegroundBrush}" />
              <TextBlock Grid.Column="2" Text="{Binding ProgressElapsed}" VerticalAlignment="Center" Foreground="{DynamicResource OrandaWarningForegroundBrush}" />
            </Grid>
            <TextBlock x:Name="ProgressSlowHint" Text="계속 기다리거나 아래 「멈춤」 으로 끝낼 수 있습니다." TextWrapping="Wrap" Opacity="0.75"
                       FontSize="{DynamicResource OrandaFontSizeSmall}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <!-- 결과 줄: 끝난 차례가 어떻게 끝났는지. 다음 차례가 시작되면 사라진다. -->
      <Grid x:Name="ResultRow" ColumnDefinitions="16,*" ColumnSpacing="8" Margin="10,0,0,4" IsVisible="{Binding HasResult}">
        <TextBlock Text="{Binding ResultMark}" FontWeight="Bold" FontSize="{DynamicResource OrandaFontSizeSmall}" Classes="aiResult"
                   Classes.completed="{Binding ResultIsCompleted}" Classes.failed="{Binding ResultIsFailed}" />
        <TextBlock x:Name="ResultText" Grid.Column="1" Text="{Binding ResultText}" FontSize="{DynamicResource OrandaFontSizeSmall}" Classes="aiResult"
                   Classes.completed="{Binding ResultIsCompleted}" Classes.failed="{Binding ResultIsFailed}" />
      </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
