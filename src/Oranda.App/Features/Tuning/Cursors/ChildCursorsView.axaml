<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:ctl="using:Oranda.App.Shell.Controls"
             xmlns:mon="using:Oranda.App.Features.SessionMonitor"
             xmlns:vm="using:Oranda.App.Features.Tuning.Cursors"
             x:Class="Oranda.App.Features.Tuning.Cursors.ChildCursorsView"
             x:DataType="vm:ChildCursorsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.chip.warning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaWarningForegroundBrush}" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.note">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.note TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <!-- 비교 표 칸 폭(계획 창 비교 표와 같은 모양). -->
    <Style Selector=":is(Control).k-mark"><Setter Property="Width" Value="28" /></Style>
    <Style Selector=":is(Control).k-id"><Setter Property="Width" Value="40" /></Style>
    <Style Selector=":is(Control).k-op"><Setter Property="Width" Value="300" /></Style>
    <Style Selector=":is(Control).k-obj"><Setter Property="Width" Value="140" /></Style>
    <Style Selector=":is(Control).k-pair"><Setter Property="Width" Value="110" /></Style>
    <Style Selector=":is(Control).k-delta"><Setter Property="Width" Value="56" /></Style>
    <Style Selector="TextBlock.big">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mark">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBlock.mark.changed">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.mark.added">
      <Setter Property="Foreground" Value="{DynamicResource OrandaSuccessForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.mark.removed">
      <Setter Property="Foreground" Value="{DynamicResource OrandaDangerForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.compare-banner">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.compare-banner.differs">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- 툴바: sql_id · 인스턴스 · 새로 고침 | 두 자식 비교 · 실제 계획 · 통계 보기 | 복사 -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <WrapPanel>
        <TextBox x:Name="SqlIdBox" Classes="compact search" Width="150" Margin="0,0,6,0" VerticalAlignment="Center"
                 PlaceholderText="sql_id" Text="{Binding SqlIdText, Mode=TwoWay}" FontFamily="{DynamicResource OrandaGridFontFamily}"
                 AutomationProperties.Name="sql_id" ToolTip.Tip="자식 커서를 볼 sql_id. Enter 로 읽습니다" />
        <ComboBox x:Name="InstanceBox" Classes="compact" MinWidth="130" Margin="0,0,6,0" VerticalAlignment="Center"
                  ItemsSource="{Binding Instances}" SelectedIndex="{Binding SelectedInstanceIndex, Mode=TwoWay}" IsVisible="{Binding HasInstances}"
                  AutomationProperties.Name="인스턴스" />
        <Button x:Name="RefreshButton" Classes="tool" Content="새로 고침 (F5)" icons:ButtonIcon.Key="refresh" icons:ButtonIcon.IconOnly="True"
                IsEnabled="{Binding CanRefresh}" />
        <Separator Classes="toolbar" />
        <Button x:Name="CompareButton" Classes="tool" Content="두 자식 비교" icons:ButtonIcon.Key="diff" IsEnabled="{Binding CanCompare}"
                ToolTip.Tip="체크한 두 자식의 계획을 다시 읽어 비교합니다(체크가 두 개가 되면 자동으로 비교합니다)" />
        <Button x:Name="PlanButton" Classes="tool" Content="실제 계획" icons:ButtonIcon.Key="plan" IsEnabled="{Binding CanOpenPlan}"
                ToolTip.Tip="지금 행의 자식 계획을 계획 창에서 엽니다(DISPLAY_CURSOR, 읽기만)" />
        <Button x:Name="StatsButton" Classes="tool" Content="통계 보기" icons:ButtonIcon.Key="table" IsEnabled="{Binding CanOpenStats}"
                ToolTip.Tip="비교한 계획의 첫 표 통계를 엽니다" />
        <Separator Classes="toolbar" />
        <Button x:Name="CopyButton" Classes="tool" Content="복사" icons:ButtonIcon.Key="copy" IsEnabled="{Binding ShowContent}"
                ToolTip.Tip="자식 커서 표와 불일치 사유를 탭으로 나눈 글로 복사합니다" />
      </WrapPanel>
    </Border>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2"
                 AutomationProperties.Name="자식 커서를 읽는 중" />
    <mon:MonitorAccessBanner x:Name="AccessBanner" DockPanel.Dock="Top" DataContext="{Binding Access}" />

    <!-- 머리 줄: SQL 전문(줄임 + 툴팁) · 칩 -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding ShowContent}" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,5">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
          <Border Classes="chip"><TextBlock Text="{Binding ChildCountText}" /></Border>
          <Border Classes="chip" Classes.warning="{Binding PlanHashDiffers}" ToolTip.Tip="서로 다른 계획(plan_hash_value) 수">
            <TextBlock Text="{Binding PlanHashCountText}" />
          </Border>
          <Border Classes="chip"><TextBlock Text="{Binding BindAwareText}" /></Border>
        </StackPanel>
        <TextBlock x:Name="SqlLine" Classes="mono" Text="{Binding SqlText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding SqlText}" IsVisible="{Binding HasSqlText}" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{x:Static vm:ChildCursorsViewModel.SourceViews}" IsVisible="{Binding ShowContent}" />
        <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Panel>
      <StackPanel x:Name="Hint" IsVisible="{Binding ShowHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="560" Margin="16">
        <ContentControl HorizontalAlignment="Center" Opacity="0.55"
                        Content="{Binding HintIcon, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=32}" />
        <TextBlock x:Name="HintTitleText" HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding HintTitle}" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock HorizontalAlignment="Center" Classes="dim" Text="{Binding HintText}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>

      <Grid x:Name="ContentGrid" IsVisible="{Binding ShowContent}" RowDefinitions="Auto,4,*">
        <ctl:DetailTable x:Name="ChildTable" Grid.Row="0" MaxHeight="190" StatusLineVisible="False" AutomationProperties.Name="자식 커서" />
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource OrandaSplitterBrush}" />
        <Grid Grid.Row="2" ColumnDefinitions="0.8*,4,1.5*">
          <DockPanel Grid.Column="0" MinWidth="280">
            <Border DockPanel.Dock="Top" Classes="section">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="section-label" Text="불일치 사유" />
                <TextBlock Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" Text="gv$sql_shared_cursor 의 Y 열" />
              </StackPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="note" IsVisible="{Binding HasReasonFooter}">
              <TextBlock Text="{Binding ReasonFooter}" TextWrapping="Wrap" />
            </Border>
            <Panel>
              <TextBlock x:Name="ReasonsHintText" Classes="dim" Margin="10,8" Text="{Binding ReasonsHint}" IsVisible="{Binding HasReasonsHint}" TextWrapping="Wrap" />
              <ctl:DetailTable x:Name="ReasonTable" StatusLineVisible="False" AutomationProperties.Name="불일치 사유" />
            </Panel>
          </DockPanel>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource OrandaSplitterBrush}" />
          <DockPanel Grid.Column="2">
            <Border x:Name="CompareBanner" DockPanel.Dock="Top" Classes="compare-banner" Classes.differs="{Binding CompareDiffers}" IsVisible="{Binding IsComparing}">
              <DockPanel>
                <Panel DockPanel.Dock="Left" Margin="0,1,8,0" VerticalAlignment="Top">
                  <ContentControl IsVisible="{Binding CompareDiffers}"
                                  Content="{Binding Source='warn', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=16}" />
                  <ContentControl IsVisible="{Binding !CompareDiffers}"
                                  Content="{Binding Source='info', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=16}" />
                </Panel>
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding CompareTitle}" Classes.big="{Binding CompareDiffers}" />
                  <TextBlock Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" TextWrapping="Wrap" Text="{Binding CompareSummary}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="note" IsVisible="{Binding IsComparing}">
              <TextBlock Text="계획 창 「비교」와 같은 표 · 자식 커서 행을 두 번 누르면 계획 창에서 그 자식 계획을 엽니다" TextWrapping="Wrap" />
            </Border>
            <Panel>
              <StackPanel x:Name="CompareHintBox" IsVisible="{Binding HasCompareHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="16">
                <ContentControl HorizontalAlignment="Center" Opacity="0.5"
                                Content="{Binding Source='diff', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=24}" />
                <TextBlock Classes="dim" Text="{Binding CompareHint}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
              <ScrollViewer IsVisible="{Binding IsComparing}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Classes="grid-header">
                    <StackPanel Orientation="Horizontal" Classes="cells">
                      <TextBlock Classes="k-mark" Text="" />
                      <TextBlock Classes="k-id num" Text="Id" />
                      <TextBlock Classes="k-op" Text="연산" />
                      <TextBlock Classes="k-obj" Text="객체" />
                      <TextBlock Classes="k-pair num" Text="{Binding CostHeader}" />
                      <TextBlock Classes="k-delta num" Text="Δ" />
                      <TextBlock Classes="k-pair num" Text="{Binding RowsHeader}" />
                      <TextBlock Classes="k-delta num" Text="Δ" />
                    </StackPanel>
                  </Border>
                  <ListBox x:Name="CompareList" Classes="table" ItemsSource="{Binding CompareRows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           AutomationProperties.Name="두 자식 계획 비교">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChildCompareRow">
                        <Border Classes="diff" Classes.changed="{Binding Item.IsChanged}" Classes.added="{Binding Item.IsAdded}" Classes.removed="{Binding Item.IsRemoved}">
                          <StackPanel Orientation="Horizontal" Classes="cells">
                            <TextBlock Classes="k-mark mark" Classes.changed="{Binding Item.IsChanged}" Classes.added="{Binding Item.IsAdded}" Classes.removed="{Binding Item.IsRemoved}"
                                       Text="{Binding Item.KindMark}" ToolTip.Tip="{Binding Item.KindTip}" />
                            <TextBlock Classes="k-id num dim" Text="{Binding IdText}" />
                            <Border Classes="k-op" Padding="6,0,0,0">
                              <DockPanel>
                                <Border DockPanel.Dock="Left" Width="{Binding Item.IndentWidth}" />
                                <ContentControl DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                                Content="{Binding Item.IconKey, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" />
                                <TextBlock Text="{Binding Item.OperationText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Item.Operation}" />
                              </DockPanel>
                            </Border>
                            <TextBlock Classes="k-obj mono" Text="{Binding Item.ObjectText}" ToolTip.Tip="{Binding Item.ObjectText}" />
                            <TextBlock Classes="k-pair num" Text="{Binding Item.CostText}" Classes.big="{Binding Item.CostBig}" />
                            <TextBlock Classes="k-delta num" Text="{Binding Item.CostDeltaText}" Classes.big="{Binding Item.CostBig}" />
                            <TextBlock Classes="k-pair num" Text="{Binding Item.RowsText}" Classes.big="{Binding Item.RowsBig}" />
                            <TextBlock Classes="k-delta num" Text="{Binding Item.RowsDeltaText}" Classes.big="{Binding Item.RowsBig}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Grid>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
