<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:ctl="using:Oranda.App.Shell.Controls"
             xmlns:vm="using:Oranda.App.Features.Tuning.Stats"
             x:Class="Oranda.App.Features.Tuning.Stats.TableStatsView"
             x:DataType="vm:TableStatsViewModel">
  <UserControl.Styles>
    <!-- 요약 줄: 이름 dim + 값 고정폭. -->
    <Style Selector="StackPanel.kv">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.kv TextBlock.v">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="{DynamicResource OrandaGridFontFamily}" />
    </Style>
    <!-- 위험 칩(stale·통계 없음): 위험·경고 글자색, 바탕은 칩 그대로. -->
    <Style Selector="Border.chip.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OrandaDangerForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip.danger">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaDangerForegroundBrush}" />
    </Style>
    <Style Selector="Border.chip.warning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaWarningForegroundBrush}" />
    </Style>
    <!-- 통계가 없거나 stale 이면 스크립트 단추를 경고 글자로 강조. -->
    <Style Selector="Button.tool.emphasis">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tool.emphasis TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 구역 머리(열 통계 9열). -->
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <!-- 경고 안내(히스토그램 밑): 계획 비교 띠와 같은 바뀜 색. -->
    <Style Selector="Border.callout">
      <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <!-- 히스토그램 가로 막대: 테마 파랑, 바탕은 막대 바탕 브러시. -->
    <Style Selector="ProgressBar.hbar">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource OrandaBarTrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OrandaIconBlueBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- CF 막대: 계획 창 비중 막대와 같은 얇은 둥근 막대. 색 = 좋음 초록·보통 호박·나쁨 빨강(아이콘 브러시). -->
    <Style Selector="Border.bar-track">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource OrandaBarTrackBrush}" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource OrandaIconNeutralBrush}" />
    </Style>
    <Style Selector="Border.bar.good">
      <Setter Property="Background" Value="{DynamicResource OrandaIconGreenBrush}" />
    </Style>
    <Style Selector="Border.bar.fair">
      <Setter Property="Background" Value="{DynamicResource OrandaIconAmberBrush}" />
    </Style>
    <Style Selector="Border.bar.poor">
      <Setter Property="Background" Value="{DynamicResource OrandaIconRedBrush}" />
    </Style>
    <Style Selector="TextBlock.pct">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 보기 바꾸기(행 수·비율): 계획 창과 같은 붙은 단추 묶음. -->
    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarHoverBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- 툴바: 표 | 편집기 표 · 새로 고침 | 통계 수집 스크립트 만들기 | 복사 -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <WrapPanel>
        <TextBox x:Name="TargetBox" Classes="compact search" Width="240" Margin="0,0,6,0" VerticalAlignment="Center"
                 PlaceholderText="owner.table" Text="{Binding TargetText, Mode=TwoWay}"
                 FontFamily="{DynamicResource OrandaGridFontFamily}" AutomationProperties.Name="통계를 볼 표"
                 ToolTip.Tip="owner.table 또는 table(접속 계정의 표). Enter 로 읽습니다" />
        <Button x:Name="EditorTableButton" Classes="tool" Content="편집기 표" icons:ButtonIcon.Key="find"
                ToolTip.Tip="편집기 커서 아래 표의 통계를 읽습니다" />
        <Button x:Name="RefreshButton" Classes="tool" Content="새로 고침 (F5)" icons:ButtonIcon.Key="refresh" icons:ButtonIcon.IconOnly="True"
                IsEnabled="{Binding CanRefresh}" />
        <Separator Classes="toolbar" />
        <Button x:Name="ScriptButton" Classes="tool" Classes.emphasis="{Binding ScriptEmphasis}" Content="통계 수집 스크립트 만들기"
                icons:ButtonIcon.Key="docEdit" IsEnabled="{Binding CanGatherScript}"
                ToolTip.Tip="DBMS_STATS.GATHER_TABLE_STATS 문안을 새 편집기 탭에 넣습니다. 실행하지 않습니다(실행하면 DB 에 씁니다)." />
        <Separator Classes="toolbar" />
        <Button x:Name="CopyButton" Classes="tool" Content="복사" icons:ButtonIcon.Key="copy" IsEnabled="{Binding ShowContent}"
                ToolTip.Tip="요약·열 통계·인덱스 통계를 탭으로 나눈 글로 복사합니다" />
      </WrapPanel>
    </Border>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2"
                 AutomationProperties.Name="통계를 읽는 중" />

    <!-- 요약 줄: stale 칩 · 행 수 · 블록 · 평균 행 · 마지막 수집(나이) -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding ShowContent}" BorderBrush="{DynamicResource OrandaSeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,6">
      <WrapPanel x:Name="SummaryLine">
        <Border Classes="chip danger" Margin="0,2,16,2" IsVisible="{Binding IsStale}"
                ToolTip.Tip="all_tab_statistics.stale_stats = YES — 마지막 수집 뒤 바뀐 행이 많습니다">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ContentControl Content="{Binding Source='warn', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=12}" VerticalAlignment="Center" />
            <TextBlock Text="stale · 통계가 오래됨" />
          </StackPanel>
        </Border>
        <Border Classes="chip warning" Margin="0,2,16,2" IsVisible="{Binding HasNoStats}"
                ToolTip.Tip="한 번도 통계를 모으지 않은 표입니다. 「통계 수집 스크립트 만들기」로 문안을 만드세요">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ContentControl Content="{Binding Source='warn', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=12}" VerticalAlignment="Center" />
            <TextBlock Text="통계 없음" />
          </StackPanel>
        </Border>
        <StackPanel Classes="kv" Margin="0,2,20,2">
          <TextBlock Classes="dim" Text="행 수" />
          <TextBlock Classes="v" Text="{Binding NumRowsText}" />
        </StackPanel>
        <StackPanel Classes="kv" Margin="0,2,20,2">
          <TextBlock Classes="dim" Text="블록" />
          <TextBlock Classes="v" Text="{Binding BlocksText}" />
        </StackPanel>
        <StackPanel Classes="kv" Margin="0,2,20,2">
          <TextBlock Classes="dim" Text="평균 행" />
          <TextBlock Classes="v" Text="{Binding AvgRowLenText}" />
        </StackPanel>
        <StackPanel Classes="kv" Margin="0,2,20,2">
          <TextBlock Classes="dim" Text="마지막 수집" />
          <TextBlock Classes="v" Classes.warning-text="{Binding ScriptEmphasis}" Text="{Binding LastAnalyzedText}" />
          <TextBlock Classes="dim" Text="{Binding AgeText}" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{x:Static vm:TableStatsViewModel.SourceViews}" IsVisible="{Binding ShowContent}" />
        <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Panel>
      <!-- 상태 안내: 접속 없음·표 안 고름·읽는 중·권한·오류 -->
      <StackPanel x:Name="Hint" IsVisible="{Binding ShowHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="560" Margin="16">
        <ContentControl HorizontalAlignment="Center" Opacity="0.55"
                        Content="{Binding HintIcon, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=32}" />
        <TextBlock x:Name="HintTitleText" HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding HintTitle}" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock HorizontalAlignment="Center" Classes="dim" Text="{Binding HintText}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>

      <Grid x:Name="ContentGrid" IsVisible="{Binding ShowContent}" RowDefinitions="*,4,150">
        <Grid Grid.Row="0" ColumnDefinitions="1.55*,4,*" MinHeight="160">
          <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Classes="section">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="section-label" Text="열 통계" />
                <TextBlock x:Name="ColumnCount" Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" />
              </StackPanel>
            </Border>
            <ctl:DetailTable x:Name="ColumnTable" StatusLineVisible="False" AutomationProperties.Name="열 통계" />
          </DockPanel>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource OrandaSplitterBrush}" />
          <DockPanel Grid.Column="2" MinWidth="260">
            <Border DockPanel.Dock="Top" Classes="section">
              <DockPanel>
                <ListBox x:Name="ShareSwitch" DockPanel.Dock="Right" Classes="segmented" SelectedIndex="0" AutomationProperties.Name="히스토그램 수 표시">
                  <ListBoxItem><TextBlock Text="행 수" /></ListBoxItem>
                  <ListBoxItem><TextBlock Text="비율" /></ListBoxItem>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="section-label" Text="{Binding HistogramTitle}" />
                  <TextBlock Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" Text="{Binding HistogramCaption}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="10,8" Spacing="8">
                <TextBlock x:Name="HistogramHintText" Classes="dim" Text="{Binding HistogramHint}" IsVisible="{Binding HasHistogramHint}" TextWrapping="Wrap" />
                <ItemsControl x:Name="HistogramList" ItemsSource="{Binding HistogramBars}" Grid.IsSharedSizeScope="True"
                              AutomationProperties.Name="히스토그램">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistogramBarItem">
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="hl" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" SharedSizeGroup="hv" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Label}" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Label}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Classes="hbar" Minimum="0" Maximum="100" Value="{Binding Percent}" />
                        <TextBlock Grid.Column="2" Classes="num" Text="{Binding ValueText}" MinWidth="64" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="HistogramWarningBox" Classes="callout" IsVisible="{Binding HasHistogramWarning}">
                  <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Margin="0,1,6,0" VerticalAlignment="Top"
                                    Content="{Binding Source='warn', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" />
                    <TextBlock Text="{Binding HistogramWarning}" TextWrapping="Wrap" FontSize="{DynamicResource OrandaFontSizeSmall}" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Grid>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource OrandaSplitterBrush}" />
        <DockPanel Grid.Row="2">
          <Border DockPanel.Dock="Top" Classes="section">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="section-label" Text="인덱스 통계" />
              <TextBlock x:Name="IndexCount" Classes="dim" FontSize="{DynamicResource OrandaFontSizeSmall}" />
              <TextBlock x:Name="IndexStaleNoteText" Classes="dim warning-text" FontSize="{DynamicResource OrandaFontSizeSmall}"
                         Text="{Binding IndexStaleNote}" IsVisible="{Binding HasIndexStaleNote}" />
            </StackPanel>
          </Border>
          <Panel>
            <TextBlock x:Name="NoIndexText" Classes="dim" Margin="10,8" Text="인덱스가 없습니다" IsVisible="False" />
            <ctl:DetailTable x:Name="IndexTable" StatusLineVisible="False" AutomationProperties.Name="인덱스 통계" />
          </Panel>
        </DockPanel>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
