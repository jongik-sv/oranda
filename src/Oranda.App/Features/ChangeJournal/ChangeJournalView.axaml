<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:ctl="using:Oranda.App.Shell.Controls"
             xmlns:sqled="using:Oranda.App.Features.SqlEditor"
             xmlns:vm="using:Oranda.App.Features.ChangeJournal"
             x:Class="Oranda.App.Features.ChangeJournal.ChangeJournalView"
             x:DataType="vm:ChangeJournalViewModel">
  <UserControl.Styles>
    <!-- 아래 두 칸(DDL·차이)의 제목 띠 -->
    <Style Selector="Border.pane-title">
      <Setter Property="Background" Value="{DynamicResource OrandaPanelHeaderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.pane-title TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 묶음 안 문장 줄은 시간 칸을 들여 쓴다 -->
    <Style Selector="TextBlock.time">
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="TextBlock.time.child">
      <Setter Property="Padding" Value="20,0,6,0" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- 툴바 한 줄: 검색 · 이 접속만 · 보관된 것만 · (대상 칩) | 새로 고침 · 새 편집기에 열기 -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <WrapPanel>
        <TextBox x:Name="SearchBox" Classes="compact search" Width="240" Margin="0,0,6,0" VerticalAlignment="Center"
                 PlaceholderText="객체 이름·DDL 검색" Text="{Binding SearchText, Mode=TwoWay}">
          <TextBox.InnerLeftContent>
            <ContentControl Opacity="0.7" VerticalAlignment="Center"
                            Content="{Binding Source='find', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <ToggleButton Classes="tool" Content="이 접속만" icons:ButtonIcon.Key="connect" IsChecked="{Binding CurrentConnectionOnly, Mode=TwoWay}"
                      ToolTip.Tip="지금 접속의 변경만 보기" />
        <ToggleButton Classes="tool" Content="보관된 것만" icons:ButtonIcon.Key="filter" IsChecked="{Binding OnlySucceeded, Mode=TwoWay}"
                      ToolTip.Tip="보관에 실패한 줄은 숨기기" />
        <Border Classes="chip" Margin="4,0,6,0" IsVisible="{Binding HasObjectFilter}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding ObjectFilterText}" VerticalAlignment="Center" />
            <Button Classes="toolbar" x:Name="ClearFilterButton" Content="해제" Padding="1" icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="대상 거르기 해제" />
          </StackPanel>
        </Border>
        <ComboBox x:Name="CauseBox" Classes="compact" MinWidth="110" Margin="0,0,6,0" VerticalAlignment="Center"
                  ItemsSource="{Binding CauseChoices}" SelectedItem="{Binding SelectedCause, Mode=TwoWay}" AutomationProperties.Name="원인 거르기">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:JournalCauseChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Separator Classes="toolbar" />
        <Button Classes="toolbar" x:Name="RefreshButton" Content="새로 고침" icons:ButtonIcon.Key="refresh" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" x:Name="OpenButton" Content="이 DDL 을 새 편집기에 열기" icons:ButtonIcon.Key="docEdit" icons:ButtonIcon.IconOnly="True" />
        <!-- 되돌리기 지점 설계 11.1: 커밋 묶음을 고르면 켜진다. 원복 스크립트 탭(RB-43)·화면 3(RB-32)은 명령 id 로만 부른다. -->
        <Button Classes="toolbar" x:Name="OpenScriptButton" Content="원복 스크립트 열기" icons:ButtonIcon.Key="fileSql" IsEnabled="{Binding CanOpenScript}"
                ToolTip.Tip="고른 커밋 묶음의 원복 스크립트를 새 탭에 엽니다(자동으로 실행하지 않습니다)" />
        <Button Classes="toolbar" x:Name="CompareButton" Content="이 실행 전과 비교…" icons:ButtonIcon.Key="diff" IsEnabled="{Binding CanCompare}"
                ToolTip.Tip="기록한 실행 직전 시점과 지금 데이터를 비교해 되돌립니다" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid RowDefinitions="*,5,*">
      <!-- 표(되돌리기 지점 설계 11.1): 접기·아이콘 | 시간 | 객체 | 원인 | 요약 | 영향 행 | 시점 | 원복 스크립트.
           DDL 보관본·커밋 묶음·묶음 안 문장 줄이 같은 열을 쓴다(IJournalRow). 머리글 경계를 끌어 열 폭을 바꾼다(TableColumns). -->
      <DockPanel Grid.Row="0" ctl:TableColumns.Scope="change-journal">
        <Border DockPanel.Dock="Top" Classes="grid-header">
          <Grid x:Name="JournalHeader" ctl:TableColumns.Header="True" ColumnDefinitions="44,124,200,92,*,76,200,170">
            <TextBlock Grid.Column="1" Padding="6,0" Text="시간" />
            <TextBlock Grid.Column="2" Padding="6,0" Text="객체" />
            <TextBlock Grid.Column="3" Padding="6,0" Text="원인" />
            <TextBlock Grid.Column="4" Padding="6,0" Text="요약" />
            <TextBlock Grid.Column="5" Padding="6,0" Text="영향 행" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Padding="6,0" Text="시점" />
            <TextBlock Grid.Column="7" Padding="6,0" Text="원복 스크립트" />
          </Grid>
        </Border>
        <ListBox x:Name="List" Classes="table" ItemsSource="{Binding Rows}" SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="변경 일지">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:IJournalRow">
              <Grid ctl:TableColumns.Row="True" ColumnDefinitions="44,124,200,92,*,76,200,170" ToolTip.Tip="{Binding SummaryText}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Width="12" Classes="dim" Text="{Binding ExpandGlyph}" VerticalAlignment="Center" />
                  <ContentControl VerticalAlignment="Center" IsVisible="{Binding !IsChild}"
                                  Content="{Binding IconKey, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="mono dim time" Text="{Binding TimeText}"
                           Classes.child="{Binding IsChild}" />
                <TextBlock Grid.Column="2" Padding="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Text="{Binding ObjectText}" />
                <TextBlock Grid.Column="3" Padding="6,0" VerticalAlignment="Center" Text="{Binding CauseText}" />
                <TextBlock Grid.Column="4" Padding="6,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="mono"
                           Classes.danger-text="{Binding IsFailure}" Text="{Binding SummaryText}" />
                <TextBlock Grid.Column="5" Padding="6,0" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="mono" Text="{Binding RowsText}" />
                <TextBlock Grid.Column="6" Padding="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="mono dim" Text="{Binding PointText}" />
                <TextBlock Grid.Column="7" Padding="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Classes.warning-text="{Binding IsScriptWarning}" Text="{Binding ScriptText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />
      <Grid Grid.Row="2" ColumnDefinitions="*,5,*">
        <!-- 고른 항목의 보관된 DDL -->
        <DockPanel Grid.Column="0">
          <Border DockPanel.Dock="Top" Classes="pane-title">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                              Content="{Binding Source='fileSql', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=13}" />
              <TextBlock Text="{Binding DetailTitle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <sqled:SqlCodeView x:Name="DetailBox" Text="{Binding DetailText, Mode=OneWay}"
                             Background="{DynamicResource OrandaCodeBackgroundBrush}" AutomationProperties.Name="보관된 DDL" />
        </DockPanel>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
        <!-- 차이: + 새 쪽에만(초록) · − 옛 쪽에만(빨강) -->
        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Classes="pane-title">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                              Content="{Binding Source='diff', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=13}" />
              <TextBlock Text="{Binding DiffTitle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" Background="{DynamicResource OrandaCodeBackgroundBrush}">
            <ItemsControl x:Name="DiffList" ItemsSource="{Binding Diff}" Margin="0,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiffLine">
                  <Border Classes="diff" Padding="6,0" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}">
                    <Grid ColumnDefinitions="18,*">
                      <TextBlock Grid.Column="0" Classes="mono" Opacity="0.7" Text="{Binding Kind}"
                                 Classes.success-text="{Binding IsAdded}" Classes.danger-text="{Binding IsRemoved}" />
                      <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Text}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
