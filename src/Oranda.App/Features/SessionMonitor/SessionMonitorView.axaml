<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.SessionMonitor"
             x:Class="Oranda.App.Features.SessionMonitor.SessionMonitorView"
             keymaps:FocusSlot.Name="monitor"
             x:DataType="vm:SessionMonitorViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.account.production">
      <Setter Property="Foreground" Value="{DynamicResource OrandaEnvProductionBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- 툴바(Orange Session Monitor 의 Sub Toolbar): 새로 고침·자동·간격·델타 | 상세·KILL·DISCONNECT | 트레이스 -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <WrapPanel>
        <Button x:Name="RefreshButton" Classes="toolbar" Content="새로 고침 (F5)" IsEnabled="{Binding IsOpen}"
                icons:ButtonIcon.Key="refresh" icons:ButtonIcon.IconOnly="True" />
        <ToggleButton Classes="tool" Content="자동" IsEnabled="{Binding IsOpen}" IsChecked="{Binding AutoRefresh, Mode=TwoWay}"
                      icons:ButtonIcon.Key="timer" ToolTip.Tip="자동 새로 고침" />
        <NumericUpDown Width="96" Minimum="2" Maximum="60" Increment="1" FormatString="0' 초'" VerticalAlignment="Center"
                       Value="{Binding RefreshSeconds, Mode=TwoWay}" AutomationProperties.Name="새로 고침 간격" />
        <ToggleButton Classes="tool" Content="델타" IsChecked="{Binding DeltaMode, Mode=TwoWay}"
                      icons:ButtonIcon.Key="sort" ToolTip.Tip="직전 새로 고침과의 차이(델타)로 보기" />
        <Separator Classes="toolbar" />
        <Button x:Name="DetailButton" Classes="tool" Content="상세" IsEnabled="{Binding IsOpen}" icons:ButtonIcon.Key="sessionInfo"
                ToolTip.Tip="선택한 세션의 현재 SQL·계획·잠금·통계" />
        <Button x:Name="KillButton" Classes="tool" Content="세션 종료" IsEnabled="{Binding CanKill}" icons:ButtonIcon.Key="kill"
                ToolTip.Tip="ALTER SYSTEM KILL SESSION … IMMEDIATE" />
        <Button x:Name="DisconnectButton" Classes="tool" Content="연결 끊기" IsEnabled="{Binding CanKill}" icons:ButtonIcon.Key="disconnect"
                ToolTip.Tip="ALTER SYSTEM DISCONNECT SESSION … IMMEDIATE" />
        <Separator Classes="toolbar" />
        <Button x:Name="TraceOnButton" Classes="tool" Content="트레이스 켜기" IsEnabled="{Binding CanTrace}" icons:ButtonIcon.Key="bug" />
        <Button x:Name="TraceOffButton" Classes="tool" Content="끄기" IsEnabled="{Binding CanTrace}" icons:ButtonIcon.Key="clear" />
        <CheckBox Margin="4,0" Content="waits" IsChecked="{Binding TraceWaits, Mode=TwoWay}" VerticalAlignment="Center" />
        <CheckBox Content="binds" IsChecked="{Binding TraceBinds, Mode=TwoWay}" VerticalAlignment="Center" />
        <Separator Classes="toolbar" />
        <Button x:Name="OtherAccountButton" Classes="tool" Content="다른 접속…" icons:ButtonIcon.Key="connect"
                ToolTip.Tip="저장된 접속 중에서 골라 모니터 전용 세션을 그 접속으로 엽니다(작업 접속은 그대로)" />
        <TextBlock Classes="account" Classes.production="{Binding Access.IsProduction}" Text="{Binding Access.AccountText}"
                   IsVisible="{Binding Access.HasAccount}" VerticalAlignment="Center" Margin="6,0" FontWeight="SemiBold" />
      </WrapPanel>
    </Border>
    <vm:MonitorAccessBanner x:Name="AccessBanner" DockPanel.Dock="Top" DataContext="{Binding Access}" />
    <!-- 거르기 줄 -->
    <WrapPanel DockPanel.Dock="Top" Margin="4,4,4,2">
      <TextBox Classes="compact search" Width="140" Margin="0,0,6,0" PlaceholderText="사용자" Text="{Binding UsernameFilter, Mode=TwoWay}"
               AutomationProperties.Name="사용자 거르기" />
      <TextBox Classes="compact search" Width="220" Margin="0,0,10,0" PlaceholderText="머신·프로그램·모듈·SQL ID" Text="{Binding TextFilter, Mode=TwoWay}"
               AutomationProperties.Name="글 거르기" />
      <CheckBox Margin="0,0,10,0" Content="활성만" IsChecked="{Binding ActiveOnly, Mode=TwoWay}" />
      <CheckBox Content="백그라운드" IsChecked="{Binding IncludeBackground, Mode=TwoWay}" />
    </WrapPanel>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock x:Name="StatusLine" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid ColumnDefinitions="3*,4,2*">
      <!-- 조회 결과와 같은 그리드(MonitorGrid): 머리글 정렬·열 끌기·너비·열 필터·현재 행 ▶. 행은 코드(MonitorGridBinder)가 Sessions 에서 채운다. -->
      <vm:MonitorGrid x:Name="SessionList" Grid.Column="0" />
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource OrandaSplitterBrush}" />
      <TabControl Grid.Column="2">
        <TabItem Header="블로킹 트리">
          <TreeView ItemsSource="{Binding BlockingRoots}">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:BlockingItem" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource OrandaFixedFontFamily}" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </TabItem>
        <TabItem Header="상세">
          <DockPanel>
            <TextBox Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="{StaticResource OrandaFixedFontFamily}" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </DockPanel>
        </TabItem>
        <TabItem Header="튜닝 추천">
          <vm:SessionTuningHintsView DataContext="{Binding TuningHints}" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
