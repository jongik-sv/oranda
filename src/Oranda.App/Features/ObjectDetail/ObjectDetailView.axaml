<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.ObjectDetail"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:ctl="using:Oranda.App.Shell.Controls"
             xmlns:se="using:Oranda.App.Features.SqlEditor"
             x:Class="Oranda.App.Features.ObjectDetail.ObjectDetailView"
             x:DataType="vm:ObjectDetailViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
    <TabControl x:Name="Tabs">
      <TabItem Header="상세">
        <DockPanel>
          <!-- Orange Schema Browser 의 객체 정보처럼 왼쪽은 구역(열·인덱스·제약·권한…), 오른쪽은 표. -->
          <ListBox x:Name="SectionList" DockPanel.Dock="Left" Classes="log" MinWidth="120" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ObjectDetailSection">
                <TextBlock Text="{Binding Title}" Margin="4,3" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource OrandaSeparatorBrush}">
            <DockPanel>
              <!-- 「열」 탭: 열 순서 바꾸기 대화상자(TSK-13-01). 표에서만 보인다. -->
              <Border DockPanel.Dock="Top" Classes="panel-toolbar" IsVisible="{Binding CanReorderColumns}">
                <Button x:Name="ReorderColumnsButton" Classes="tool" Content="열 순서 바꾸기…" AutomationProperties.Name="열 순서 바꾸기" />
              </Border>
            <Panel>
              <!-- 구역 표(C안 격자, 행 선택·복사). 인덱스·제약 구역이면 아래에 고른 줄의 열 표(TSK-13-34). -->
              <Grid x:Name="SectionGrid" RowDefinitions="*,Auto,0" IsVisible="{Binding !IsDataSelected}">
                <ctl:DetailTable x:Name="SectionTable" Columns="{Binding SelectedSection.Columns}" Rows="{Binding SelectedSection.Rows}"
                                 RowNumbers="{Binding !SelectedSection.HasNumberColumn}" KeepSelectionOnSameShape="True" />
                <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" IsVisible="{Binding HasKeyColumns}" Background="{DynamicResource OrandaSeparatorBrush}" />
                <DockPanel Grid.Row="2" IsVisible="{Binding HasKeyColumns}">
                  <Border DockPanel.Dock="Top" Classes="panel-toolbar">
                    <TextBlock x:Name="KeyStatusText" Text="{Binding KeyStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                  </Border>
                  <ctl:DetailTable x:Name="KeyTable" Columns="{Binding KeyColumns.Columns}" Rows="{Binding KeyColumns.Rows}" RowNumbers="False" />
                </DockPanel>
              </Grid>
              <!-- 「데이터」 탭(표·뷰): 처음 고를 때 읽는다. 결과 영역은 편집기 결과와 같다(거르기·행 수·편집). -->
              <Panel IsVisible="{Binding IsDataSelected}">
                <vm:ObjectDataView x:Name="DataView" DataContext="{Binding Data}" />
              </Panel>
            </Panel>
            </DockPanel>
          </Border>
        </DockPanel>
      </TabItem>
      <TabItem Header="DDL" x:Name="DdlTab">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <WrapPanel>
              <Button x:Name="CopyButton" Classes="tool" Content="DDL 복사" icons:ButtonIcon.Key="copy" Margin="0,0,10,0" />
              <CheckBox Content="저장 속성(STORAGE)" IsChecked="{Binding IncludeStorage, Mode=TwoWay}" Margin="0,0,10,0" />
              <CheckBox Content="세그먼트 속성" IsChecked="{Binding IncludeSegmentAttributes, Mode=TwoWay}" Margin="0,0,10,0" />
              <CheckBox Content="테이블스페이스" IsChecked="{Binding IncludeTablespace, Mode=TwoWay}" Margin="0,0,10,0" />
              <CheckBox Content="종결자(;)" IsChecked="{Binding SqlTerminator, Mode=TwoWay}" Margin="0,0,10,0" />
              <CheckBox Content="종속 객체(인덱스·제약·권한 등)" IsChecked="{Binding IncludeDependentObjects, Mode=TwoWay}" />
            </WrapPanel>
          </Border>
          <!-- 편집기와 같은 강조·줄 번호(읽기 전용). 패키지·프로시저 소스도 여기서 본다. -->
          <se:SqlCodeView x:Name="DdlView" Text="{Binding DdlText}" />
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
