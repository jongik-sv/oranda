             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.ExecutionPlan"
             x:Class="Oranda.App.Features.ExecutionPlan.PlanPanelView"
             x:DataType="vm:PlanPanelViewModel">
