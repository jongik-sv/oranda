<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.ExecutionPlan"
             x:Class="Oranda.App.Features.ExecutionPlan.PlanView"
             x:DataType="vm:PlanViewModel">
  <UserControl.Styles>
    <!-- 가장 비싼 단계·비교 줄 바탕. 반투명이라 밝은·어두운 테마 모두에서 글자가 읽힌다. -->
    <Style Selector="Border.hot">
      <Setter Property="Background" Value="#38FF8C00" />
    </Style>
    <Style Selector="Border.changed">
      <Setter Property="Background" Value="#30FFC107" />
    </Style>
    <Style Selector="Border.added">
      <Setter Property="Background" Value="#3028A745" />
    </Style>
    <Style Selector="Border.removed">
      <Setter Property="Background" Value="#30DC3545" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="Foreground" Value="OrangeRed" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.bar-track">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Height" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.bar.total">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.bar.cost">
      <Setter Property="Background" Value="{DynamicResource OrandaIconBlueBrush}" />
    </Style>
    <Style Selector="Border.bar.actual">
      <Setter Property="Background" Value="{DynamicResource OrandaIconOrangeBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <WrapPanel>
      <ComboBox Width="110" Margin="0,0,6,4" ItemsSource="{x:Static vm:PlanViewModel.BaseFormats}" SelectedItem="{Binding BaseFormat, Mode=TwoWay}" />
      <CheckBox Margin="0,0,6,4" Content="LAST" IsChecked="{Binding LastOnly, Mode=TwoWay}" />
      <CheckBox Margin="0,0,6,4" Content="바인드 엿보기" IsChecked="{Binding PeekedBinds, Mode=TwoWay}" />
      <CheckBox Margin="0,0,6,4" Content="별칭" IsChecked="{Binding Alias, Mode=TwoWay}" />
      <CheckBox Margin="0,0,10,4" Content="아웃라인" IsChecked="{Binding Outline, Mode=TwoWay}" />
      <TextBox Width="150" Margin="0,0,10,4" PlaceholderText="sql_id" Text="{Binding SqlIdText, Mode=TwoWay}" />
      <Button x:Name="PinButton" Classes="tool" Margin="0,0,4,4" Content="이 계획 고정" icons:ButtonIcon.Key="lock"
              ToolTip.Tip="지금 계획을 비교 기준으로 고정" />
      <Button x:Name="CompareButton" Classes="tool" Margin="0,0,4,4" Content="비교" icons:ButtonIcon.Key="diff" IsEnabled="{Binding HasPinned}"
              ToolTip.Tip="고정한 계획과 지금 계획 비교" />
      <Button x:Name="UnpinButton" Classes="tool" Margin="0,0,6,4" Content="고정 해제" icons:ButtonIcon.Key="clear" IsEnabled="{Binding HasPinned}" />
      <TextBlock Margin="0,0,6,4" VerticalAlignment="Center" Opacity="0.75" Text="{Binding PinnedText}" />
    </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
      <TabItem Header="트리">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="6,2" ColumnDefinitions="40,44,300,160,80,100,90,90,70,70,100,110,*" Opacity="0.7">
            <TextBlock Grid.Column="0" Text="Id" />
            <TextBlock Grid.Column="1" Text="순서" ToolTip.Tip="실행 순서: 자식이 부모보다 먼저, 형제는 Id 순(보통의 규칙)" />
            <TextBlock Grid.Column="2" Text="연산" />
            <TextBlock Grid.Column="3" Text="객체" />
            <TextBlock Grid.Column="4" Text="비용" />
            <TextBlock Grid.Column="5" Text="비용 비중" ToolTip.Tip="옅은 막대: 누적 비용 비중, 진한 막대: 자체 비용 비중" />
            <TextBlock Grid.Column="6" Text="E-Rows" />
            <TextBlock Grid.Column="7" Text="A-Rows" />
            <TextBlock Grid.Column="8" Text="Starts" />
            <TextBlock Grid.Column="9" Text="시간(s)" />
            <TextBlock Grid.Column="10" Text="실제 비중" ToolTip.Tip="실제 계획: 누적·자체 A-Time 비중(시간 통계가 없으면 A-Rows)" />
            <TextBlock Grid.Column="11" Text="위험" />
            <TextBlock Grid.Column="12" Text="조건절" />
          </Grid>
          <ListBox x:Name="PlanList" ItemsSource="{Binding Rows}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlanRowItem">
                <Border Classes.hot="{Binding IsHottest}" ToolTip.Tip="{Binding HotTip}">
                  <Grid ColumnDefinitions="40,44,300,160,80,100,90,90,70,70,100,110,*">
                    <TextBlock Grid.Column="0" Text="{Binding Id}" />
                    <TextBlock Grid.Column="1" Text="{Binding ExecutionOrderText}" Opacity="0.75" />
                    <TextBlock Grid.Column="2" Text="{Binding Operation}" FontFamily="Consolas,Menlo,monospace" />
                    <TextBlock Grid.Column="3" Text="{Binding ObjectText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding CostText}" />
                    <Panel Grid.Column="5" Background="Transparent" ToolTip.Tip="{Binding CostTip}">
                      <Border Classes="bar-track" />
                      <Border Classes="bar cost total" Width="{Binding CostBarWidth}" />
                      <Border Classes="bar cost" Width="{Binding SelfCostBarWidth}" />
                      <TextBlock Margin="64,0,0,0" Text="{Binding CostShareText}" />
                    </Panel>
                    <TextBlock Grid.Column="6" Text="{Binding EstimatedText}" />
                    <TextBlock Grid.Column="7" Text="{Binding ActualText}" />
                    <TextBlock Grid.Column="8" Text="{Binding StartsText}" />
                    <TextBlock Grid.Column="9" Text="{Binding TimeText}" />
                    <Panel Grid.Column="10" Background="Transparent" ToolTip.Tip="{Binding ActualTip}">
                      <Border Classes="bar actual total" Width="{Binding ActualBarWidth}" />
                      <Border Classes="bar actual" Width="{Binding SelfActualBarWidth}" />
                      <TextBlock Margin="64,0,0,0" Text="{Binding ActualShareText}" />
                    </Panel>
                    <TextBlock Grid.Column="11" Text="{Binding RiskText}" Foreground="OrangeRed" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="12" Text="{Binding Predicates}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="텍스트">
        <TextBox Text="{Binding PlanText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,Menlo,monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
      </TabItem>
      <TabItem Header="비교">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="6,4">
            <TextBlock Text="{Binding CompareHashText}" Classes.big="{Binding CompareHashDiffers}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CompareSummaryText}" TextWrapping="Wrap" Opacity="0.85" />
          </StackPanel>
          <Grid DockPanel.Dock="Top" Margin="6,2" ColumnDefinitions="28,56,56,320,180,150,64,170,64,150,64" Opacity="0.7">
            <TextBlock Grid.Column="1" Text="기준 Id" ToolTip.Tip="고정한 계획의 Id" />
            <TextBlock Grid.Column="2" Text="지금 Id" ToolTip.Tip="지금 계획의 Id" />
            <TextBlock Grid.Column="3" Text="연산 (← 기준)" />
            <TextBlock Grid.Column="4" Text="객체 (← 기준)" />
            <TextBlock Grid.Column="5" Text="비용 기준 → 지금" />
            <TextBlock Grid.Column="6" Text="변화" />
            <TextBlock Grid.Column="7" Text="E-Rows 기준 → 지금" />
            <TextBlock Grid.Column="8" Text="변화" />
            <TextBlock Grid.Column="9" Text="A-Rows 기준 → 지금" />
            <TextBlock Grid.Column="10" Text="변화" />
          </Grid>
          <ListBox ItemsSource="{Binding CompareRows}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlanCompareRowItem">
                <Border Classes.changed="{Binding IsChanged}" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}">
                  <Grid ColumnDefinitions="28,56,56,320,180,150,64,170,64,150,64">
                    <TextBlock Grid.Column="0" Text="{Binding KindMark}" ToolTip.Tip="{Binding KindTip}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding PinnedIdText}" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentIdText}" />
                    <TextBlock Grid.Column="3" Text="{Binding Operation}" FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding ObjectText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="5" Text="{Binding CostText}" Classes.big="{Binding CostBig}" />
                    <TextBlock Grid.Column="6" Text="{Binding CostDeltaText}" Classes.big="{Binding CostBig}" />
                    <TextBlock Grid.Column="7" Text="{Binding RowsText}" Classes.big="{Binding RowsBig}" />
                    <TextBlock Grid.Column="8" Text="{Binding RowsDeltaText}" Classes.big="{Binding RowsBig}" />
                    <TextBlock Grid.Column="9" Text="{Binding ActualRowsText}" Classes.big="{Binding ActualRowsBig}" />
                    <TextBlock Grid.Column="10" Text="{Binding ActualRowsDeltaText}" Classes.big="{Binding ActualRowsBig}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
