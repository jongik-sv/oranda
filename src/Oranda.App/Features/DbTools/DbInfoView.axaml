<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.DbTools"
             xmlns:md="using:Oranda.Core.Metadata"
             x:Class="Oranda.App.Features.DbTools.DbInfoView"
             x:DataType="vm:DbInfoViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="6,2" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Opacity="0.7" />
    <Border DockPanel.Dock="Bottom" Padding="6" BorderThickness="0,1,0,0" BorderBrush="Gray">
      <StackPanel Spacing="4">
        <TextBlock Text="파라미터 변경 DDL 미리보기 (실행하지 않는다)" FontWeight="SemiBold" />
        <WrapPanel>
          <TextBox x:Name="ParameterNameBox" Width="200" Margin="0,0,6,4" PlaceholderText="파라미터 이름" Text="{Binding ParameterName, Mode=TwoWay}" />
          <TextBox Width="200" Margin="0,0,6,4" PlaceholderText="새 값" Text="{Binding ParameterValue, Mode=TwoWay}" />
          <ComboBox x:Name="ScopeBox" Width="110" Margin="0,0,6,4" />
          <Button x:Name="CopyDdlButton" Margin="0,0,6,4" Content="DDL 복사" />
        </WrapPanel>
        <TextBox Text="{Binding PreviewDdl}" IsReadOnly="True" FontFamily="Consolas,Menlo,monospace" />
        <TextBlock Text="{Binding PreviewError}" Foreground="OrangeRed" />
      </StackPanel>
    </Border>
    <DockPanel>
      <StackPanel DockPanel.Dock="Left" MinWidth="120" Margin="4" Spacing="4">
        <Button x:Name="RefreshButton" Content="새로 고침" IsEnabled="{Binding !IsBusy}" />
        <ListBox x:Name="SectionList" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="md:DetailSection">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Margin="4" PlaceholderText="이 구역에서 찾기" Text="{Binding FilterText, Mode=TwoWay}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock Margin="8,4" Text="{Binding SectionText}" FontFamily="Consolas,Menlo,monospace" />
        </ScrollViewer>
      </DockPanel>
    </DockPanel>
  </DockPanel>
</UserControl>
