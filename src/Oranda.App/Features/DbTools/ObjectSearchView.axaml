<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.DbTools"
             x:Class="Oranda.App.Features.DbTools.ObjectSearchView"
             x:DataType="vm:ObjectSearchViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
    <TabControl x:Name="Tabs">
      <TabItem Header="검색">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <WrapPanel>
            <TextBox Width="110" Margin="0,0,6,4" PlaceholderText="스키마" Text="{Binding Owner, Mode=TwoWay}" />
            <TextBox x:Name="NameBox" Width="170" Margin="0,0,6,4" PlaceholderText="이름 (* 와일드카드)" Text="{Binding NameText, Mode=TwoWay}" />
            <ComboBox x:Name="TypeBox" Width="150" Margin="0,0,6,4" PlaceholderText="모든 유형" SelectedItem="{Binding TypeFilter, Mode=TwoWay}" />
            <CheckBox Margin="0,0,10,4" Content="INVALID 만" IsChecked="{Binding InvalidOnly, Mode=TwoWay}" />
            <CalendarDatePicker Margin="0,0,6,4" PlaceholderText="생성일 이후" SelectedDate="{Binding CreatedAfter, Mode=TwoWay}" />
            <CalendarDatePicker Margin="0,0,6,4" PlaceholderText="변경일 이후" SelectedDate="{Binding ModifiedAfter, Mode=TwoWay}" />
            <NumericUpDown Width="130" Margin="0,0,6,4" Minimum="0" Increment="64" PlaceholderText="최소 KB" FormatString="0" Value="{Binding MinSizeKb, Mode=TwoWay}" />
            <NumericUpDown Width="130" Margin="0,0,6,4" Minimum="0" Increment="64" PlaceholderText="최대 KB" FormatString="0" Value="{Binding MaxSizeKb, Mode=TwoWay}" />
            <Button Classes="tool" icons:ButtonIcon.Key="find" x:Name="SearchButton" Margin="0,0,6,4" Content="검색" IsEnabled="{Binding !IsBusy}" />
          </WrapPanel>
          </Border>
          <Grid ColumnDefinitions="3*,4,2*">
            <DockPanel Grid.Column="0">
              <Grid DockPanel.Dock="Top" Margin="6,2" ColumnDefinitions="*,110,70,130,130,80" Opacity="0.7">
                <TextBlock Grid.Column="0" Text="이름" />
                <TextBlock Grid.Column="1" Text="유형" />
                <TextBlock Grid.Column="2" Text="상태" />
                <TextBlock Grid.Column="3" Text="생성일" />
                <TextBlock Grid.Column="4" Text="변경일" />
                <TextBlock Grid.Column="5" Text="크기" />
              </Grid>
              <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ObjectSearchItem">
                    <Grid ColumnDefinitions="*,110,70,130,130,80">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding ObjectType}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}" />
                      <TextBlock Grid.Column="3" Text="{Binding Created}" />
                      <TextBlock Grid.Column="4" Text="{Binding Modified}" />
                      <TextBlock Grid.Column="5" Text="{Binding Size}" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Margin="8,4" Text="{Binding ReferencesText}" FontFamily="{StaticResource OrandaFixedFontFamily}" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="소스 검색">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <WrapPanel>
            <TextBox Width="110" Margin="0,0,6,4" PlaceholderText="스키마" Text="{Binding Owner, Mode=TwoWay}" />
            <TextBox x:Name="SourceTextBox" Width="220" Margin="0,0,6,4" PlaceholderText="찾을 글자" Text="{Binding SourceText, Mode=TwoWay}" />
            <ComboBox x:Name="SourceTypeBox" Width="150" Margin="0,0,6,4" PlaceholderText="모든 소스 유형" SelectedItem="{Binding SourceTypeFilter, Mode=TwoWay}" />
            <CheckBox Margin="0,0,10,4" Content="대소문자 구분" IsChecked="{Binding SourceMatchCase, Mode=TwoWay}" />
            <CheckBox Margin="0,0,10,4" Content="단어 단위" IsChecked="{Binding SourceWholeWord, Mode=TwoWay}" />
            <CheckBox Margin="0,0,10,4" Content="정규식" IsChecked="{Binding SourceRegex, Mode=TwoWay}" />
            <Button Classes="tool" icons:ButtonIcon.Key="find" x:Name="SourceSearchButton" Margin="0,0,6,4" Content="검색" IsEnabled="{Binding !IsBusy}" />
          </WrapPanel>
          </Border>
          <Grid DockPanel.Dock="Top" Margin="6,2" ColumnDefinitions="220,110,60,*" Opacity="0.7">
            <TextBlock Grid.Column="0" Text="객체" />
            <TextBlock Grid.Column="1" Text="유형" />
            <TextBlock Grid.Column="2" Margin="0,0,10,0" HorizontalAlignment="Right" Text="줄" />
            <TextBlock Grid.Column="3" Text="내용" />
          </Grid>
          <ListBox x:Name="SourceList" ItemsSource="{Binding SourceHits}" SelectedItem="{Binding SelectedSourceHit, Mode=TwoWay}"
                   ToolTip.Tip="두 번 누르면 PL/SQL 편집기에서 그 줄을 연다">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceSearchItem">
                <Grid ColumnDefinitions="220,110,60,*">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding ObjectType}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Margin="0,0,10,0" HorizontalAlignment="Right" Text="{Binding LineText}" />
                  <TextBlock Grid.Column="3" Text="{Binding Text}" FontFamily="{StaticResource OrandaFixedFontFamily}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="열 이름 검색">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <WrapPanel>
            <TextBox Width="110" Margin="0,0,6,4" PlaceholderText="스키마" Text="{Binding Owner, Mode=TwoWay}" />
            <TextBox x:Name="ColumnNameBox" Width="200" Margin="0,0,6,4" PlaceholderText="열 이름 (* 와일드카드)" Text="{Binding ColumnNameText, Mode=TwoWay}" />
            <Button Classes="tool" icons:ButtonIcon.Key="find" x:Name="ColumnSearchButton" Margin="0,0,6,4" Content="검색" IsEnabled="{Binding !IsBusy}" />
          </WrapPanel>
          </Border>
          <Grid DockPanel.Dock="Top" Margin="6,2" ColumnDefinitions="*,130,*,170,50" Opacity="0.7">
            <TextBlock Grid.Column="0" Text="테이블" />
            <TextBlock Grid.Column="1" Text="유형" />
            <TextBlock Grid.Column="2" Text="열" />
            <TextBlock Grid.Column="3" Text="데이터 형식" />
            <TextBlock Grid.Column="4" Text="NULL 허용" TextTrimming="CharacterEllipsis" />
          </Grid>
          <ListBox x:Name="ColumnList" ItemsSource="{Binding ColumnHits}" SelectedItem="{Binding SelectedColumnHit, Mode=TwoWay}"
                   ToolTip.Tip="두 번 누르면 객체 상세를 연다">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ColumnSearchItem">
                <Grid ColumnDefinitions="*,130,*,170,50">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding ObjectType}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Column}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding DataType}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="4" Text="{Binding Nullable}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="INVALID 컴파일">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <WrapPanel>
            <TextBox Width="110" Margin="0,0,6,4" PlaceholderText="스키마" Text="{Binding Owner, Mode=TwoWay}" />
            <Button Classes="tool" icons:ButtonIcon.Key="compileInvalid" x:Name="CompileButton" Margin="0,0,6,4" Content="INVALID 객체 일괄 컴파일" IsEnabled="{Binding CanChange}" />
          </WrapPanel>
          </Border>
          <ListBox ItemsSource="{Binding CompileResults}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CompileResultItem">
                <TextBlock Text="{Binding Line}" FontFamily="{StaticResource OrandaFixedFontFamily}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="휴지통">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-toolbar">
            <WrapPanel>
            <Button Classes="tool" icons:ButtonIcon.Key="refresh" x:Name="RecycleRefreshButton" Margin="0,0,6,4" Content="새로 고침" />
            <TextBox Width="150" Margin="0,0,6,4" PlaceholderText="되살릴 때 새 이름(선택)" Text="{Binding FlashbackName, Mode=TwoWay}" />
            <Button Classes="tool" icons:ButtonIcon.Key="reset" x:Name="FlashbackButton" Margin="0,0,6,4" Content="되살리기" IsEnabled="{Binding CanChange}" />
            <Button Classes="tool" icons:ButtonIcon.Key="recycle" x:Name="PurgeButton" Margin="0,0,6,4" Content="비우기(Purge)" IsEnabled="{Binding CanChange}" />
            <Button Classes="tool" icons:ButtonIcon.Key="delete" x:Name="PurgeAllButton" Margin="0,0,6,4" Content="전체 비우기" IsEnabled="{Binding CanChange}" />
          </WrapPanel>
          </Border>
          <ListBox ItemsSource="{Binding RecycleBin}" SelectedItem="{Binding SelectedRecycle, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RecycleBinRow">
                <Grid ColumnDefinitions="*,160,150">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Dropped}" />
                  <TextBlock Grid.Column="2" Text="{Binding Flags}" Opacity="0.7" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
