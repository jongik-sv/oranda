<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:vm="using:Oranda.App.Features.SqlEditor"
             x:Class="Oranda.App.Features.SqlEditor.SqlEditorView"
             keymaps:FocusSlot.Name="sqlText"
             x:DataType="vm:SqlEditorViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </UserControl.Styles>

  <!-- 위: 찾기 패널 / 아래: 편집기. 결과 영역은 아래 도구 창 「조회 결과」가 활성 탭의 ResultPane 을 보인다. -->
  <!-- 결과 행 높이는 code-behind 가 정한다(결과가 없으면 0, 있으면 편집기와 3:2 로 나눈다). -->
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
    <Border Grid.Row="0" Name="FindPanel" Classes="panel-toolbar" IsVisible="{Binding IsFindPanelOpen}">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBox Name="FindBox" Classes="compact search" Width="260" PlaceholderText="찾기"
                   Text="{Binding FindText, Mode=TwoWay}" AutomationProperties.Name="찾을 글" />
          <Button Classes="tool" icons:ButtonIcon.Key="up" Name="PrevButton" Content="이전" />
          <Button Classes="tool" icons:ButtonIcon.Key="down" Name="NextButton" Content="다음" />
          <ToggleButton Classes="toolbar" Content="Aa" ToolTip.Tip="대소문자 구분" IsChecked="{Binding MatchCase, Mode=TwoWay}" />
          <ToggleButton Classes="toolbar" Content="단어" ToolTip.Tip="단어 단위" IsChecked="{Binding WholeWord, Mode=TwoWay}" />
          <ToggleButton Classes="toolbar" Content=".*" ToolTip.Tip="정규식" IsChecked="{Binding UseRegex, Mode=TwoWay}" />
          <TextBlock Text="{Binding FindStatus}" VerticalAlignment="Center" Opacity="0.7" />
          <Button Name="CloseFindButton" Classes="toolbar" Content="찾기 닫기" icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsReplaceMode}">
          <TextBox Name="ReplaceBox" Classes="compact" Width="260" PlaceholderText="바꿀 글"
                   Text="{Binding ReplaceText, Mode=TwoWay}" AutomationProperties.Name="바꿀 글" />
          <Button Classes="tool" icons:ButtonIcon.Key="swap" Name="ReplaceButton" Content="바꾸기" />
          <Button Classes="tool" icons:ButtonIcon.Key="swap" Name="ReplaceAllButton" Content="모두 바꾸기" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ae:TextEditor Grid.Row="1" Name="Editor"
                   ShowLineNumbers="True"
                   FontFamily="{DynamicResource OrandaEditorFontFamily}"
                   FontSize="{DynamicResource OrandaEditorFontSize}"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="SQL 편집기" />

  </Grid>
</UserControl>
