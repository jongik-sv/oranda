<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.SqlEditor"
             x:Class="Oranda.App.Features.SqlEditor.SqlWorkspaceView"
             x:DataType="vm:SqlWorkspaceViewModel">
  <UserControl.Styles>
    <!-- 작업 공간 안의 SQL 탭 줄(오렌지 SQL Tool 의 SQL1 | SQL2 | SQL3). 문서 탭보다 작고 촘촘하게. -->
    <Style Selector="Border.sql-tabs">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="2,2,2,0" />
    </Style>
    <Style Selector="ListBox#SqlTabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox#SqlTabs ListBoxItem">
      <Setter Property="Padding" Value="8,3,2,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="3,3,0,0" />
    </Style>
    <Style Selector="ListBox#SqlTabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
    </Style>
    <Style Selector="ListBox#SqlTabs ListBoxItem:selected TextBlock.tab-title">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 끌어서 순서 바꾸기: 놓일 자리를 대상 탭 머리의 왼쪽/오른쪽 굵은 선으로 보인다. -->
    <Style Selector="ListBox#SqlTabs ListBoxItem.drop-before">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaFocusBrush}" />
      <Setter Property="BorderThickness" Value="3,1,1,0" />
    </Style>
    <Style Selector="ListBox#SqlTabs ListBoxItem.drop-after">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaFocusBrush}" />
      <Setter Property="BorderThickness" Value="1,1,3,0" />
    </Style>
    <Style Selector="Button.tab-close">
      <Setter Property="Padding" Value="2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.tab-close:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="sql-tabs">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="toolbar" Content="새 SQL 탭" Command="{Binding NewTabCommand}"
                VerticalAlignment="Center" icons:ButtonIcon.Key="tabAdd" icons:ButtonIcon.IconOnly="True" />
        <!-- 탭이 줄에 다 들어가지 않을 때만 보이는 탭 목록(고르면 그 탭으로 옮겨 가고 줄이 그 탭까지 스크롤된다). -->
        <Button x:Name="TabListButton" DockPanel.Dock="Right" Classes="toolbar" Content="SQL 탭 목록" IsVisible="False"
                VerticalAlignment="Center" icons:ButtonIcon.Key="down" icons:ButtonIcon.IconOnly="True"
                AutomationProperties.Name="SQL 탭 목록" />
        <!-- 탭은 한 줄. 넘치면 마우스 휠(가로)로 스크롤하고, 고른 탭은 늘 보이게 스크롤한다. 스크롤 막대는 숨긴다. -->
        <ListBox x:Name="SqlTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="SQL 탭">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SqlEditorViewModel">
              <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding FilePath}">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="이름 바꾸기" InputGesture="F2"
                              IsVisible="{Binding $parent[UserControl].((vm:SqlWorkspaceViewModel)DataContext).IsTabRenameAllowed}"
                              Command="{Binding $parent[UserControl].((vm:SqlWorkspaceViewModel)DataContext).BeginRenameTabCommand}"
                              CommandParameter="{Binding}" />
                    <Separator IsVisible="{Binding $parent[UserControl].((vm:SqlWorkspaceViewModel)DataContext).IsTabRenameAllowed}" />
                    <MenuItem Header="닫기"
                              Command="{Binding $parent[UserControl].((vm:SqlWorkspaceViewModel)DataContext).CloseTabCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="다른 탭 닫기"
                              Command="{Binding $parent[UserControl].((vm:SqlWorkspaceViewModel)DataContext).CloseOtherTabsCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="오른쪽 탭 닫기"
                              Command="{Binding $parent[UserControl].((vm:SqlWorkspaceViewModel)DataContext).CloseRightTabsCommand}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <!-- MyBatis 문서의 문장 종류 표시 자리(비어 있으면 보이지 않는다). -->
                <vm:SqlTabBadgeSlot VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Classes="tab-title" Text="{Binding DisplayTitle}" VerticalAlignment="Center"
                           IsVisible="{Binding !IsRenaming}" />
                <TextBox Classes="tab-rename" Text="{Binding EditTitle, Mode=TwoWay}" IsVisible="{Binding IsRenaming}"
                         MinWidth="80" Padding="2,0" MinHeight="0" VerticalAlignment="Center"
                         AutomationProperties.Name="탭 이름 편집" />
                <Button Classes="tab-close" Content="SQL 탭 닫기" Focusable="False"
                        Command="{Binding $parent[UserControl].((vm:SqlWorkspaceViewModel)DataContext).CloseTabCommand}"
                        CommandParameter="{Binding}" icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid>
      <!-- 보이는 SQL 탭의 편집기. 탭마다 View 를 하나씩 두고 바꿔 끼운다(되돌리기 기록·접기·스크롤을 잃지 않게). -->
      <ContentControl x:Name="EditorHost" />
      <TextBlock x:Name="EmptyHint" Text="SQL 탭이 없습니다. 「새 SQL」이나 탭 줄의 + 로 SQL 탭을 엽니다."
                 IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
    </Grid>
  </DockPanel>
</UserControl>
