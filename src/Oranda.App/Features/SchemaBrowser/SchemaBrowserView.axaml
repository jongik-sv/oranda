<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             xmlns:vm="using:Oranda.App.Features.SchemaBrowser"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:controls="using:Oranda.App.Shell.Controls"
             x:Class="Oranda.App.Features.SchemaBrowser.SchemaBrowserView"
             keymaps:FocusSlot.Name="schema"
             x:DataType="vm:SchemaBrowserViewModel">
  <UserControl.Styles>
    <!-- 저장 필터가 걸려 있으면 필터 단추를 눌린 토글처럼 보인다(ToggleButton.toolbar:checked 와 같은 모양). -->
    <Style Selector="Button.toolbar.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaIconBlueBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- 패널 툴바(Orange Schema Browser 처럼 아이콘 단추 한 줄): 유형 고르기 · 저장 필터 ▾ · INVALID 만 · 즐겨찾기만 · 새로 고침 -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
          <Button x:Name="SavedFilterButton" Classes="toolbar" Classes.on="{Binding HasSavedFilter}"
                  ToolTip.Tip="저장 필터 (고르기·편집)" AutomationProperties.Name="저장 필터" />
          <ToggleButton x:Name="InvalidToggle" Classes="toolbar" IsChecked="{Binding InvalidOnly, Mode=TwoWay}"
                        ToolTip.Tip="INVALID 객체만" AutomationProperties.Name="INVALID 객체만" />
          <ToggleButton x:Name="FavoritesToggle" Classes="toolbar" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                        ToolTip.Tip="즐겨찾기만" AutomationProperties.Name="즐겨찾기만" />
          <Button x:Name="RefreshButton" Classes="toolbar" ToolTip.Tip="새로 고침 (F5)" AutomationProperties.Name="새로 고침" />
        </StackPanel>
        <controls:TypeChoiceDropDown x:Name="TypeBox" DataContext="{Binding Types}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
      </DockPanel>
    </Border>
    <!-- 읽는 동안 필터 칸 아래 여백에 가는 막대를 겹쳐 보인다(트리가 밀리지 않게 자리를 따로 차지하지 않는다). -->
    <Panel DockPanel.Dock="Top" Margin="4,4,4,0">
      <TextBox x:Name="FilterBox" Classes="compact search" Margin="0,0,0,3"
               PlaceholderText="이름 필터 (* 와일드카드)" Text="{Binding FilterText, Mode=TwoWay}" AutomationProperties.Name="이름 필터" />
      <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" MinHeight="2"
                   VerticalAlignment="Bottom" AutomationProperties.Name="객체 목록을 읽는 중" />
    </Panel>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
    <!-- 위: 객체 트리 / 아래: 고른 객체의 속성(오렌지 Property 창). 나누기 막대로 높이를 바꾼다. -->
    <Grid RowDefinitions="*,Auto,240">
    <TreeView x:Name="Tree" Grid.Row="0" Classes="compact" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:SchemaNode">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:SchemaNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ContentControl Content="{Binding IconKey, Converter={x:Static icons:IconKeyConverter.Instance}}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" Classes.invalid="{Binding IsInvalid}" VerticalAlignment="Center" />
            <ContentControl Content="{Binding Source='star', Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=11}"
                            IsVisible="{Binding IsFavorite}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Detail}" Opacity="0.55" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                  Background="{DynamicResource OrandaSplitterBrush}" AutomationProperties.Name="트리와 속성 나누기" />
    <vm:SchemaPropertiesView Grid.Row="2" MinHeight="0" DataContext="{Binding Properties}" />
    </Grid>
  </DockPanel>
</UserControl>
