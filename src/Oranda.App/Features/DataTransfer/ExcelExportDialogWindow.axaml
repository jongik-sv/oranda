<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dt="using:Oranda.App.Features.DataTransfer"
        x:Class="Oranda.App.Features.DataTransfer.ExcelExportDialogWindow"
        x:DataType="dt:ExcelExportDialogViewModel"
        Title="Excel 로 내보내기"
        Width="460" SizeToContent="Height" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="내보낼 범위" FontWeight="SemiBold" />
    <StackPanel Spacing="6" Margin="8,0,0,0">
      <RadioButton GroupName="Scope" Content="전체 행(서버에서 다시 실행)" IsChecked="{Binding IsAllRows}" IsEnabled="{Binding CanAllRows}"
                   AutomationProperties.Name="전체 행" />
      <RadioButton GroupName="Scope" Content="{Binding LoadedLabel}" IsChecked="{Binding IsLoadedRows}" AutomationProperties.Name="그리드에 불러온 행" />
      <RadioButton GroupName="Scope" Content="{Binding FetchedLabel}" IsChecked="{Binding IsFetchedAll}" IsVisible="{Binding HasFetchedAll}"
                   AutomationProperties.Name="가져온 전체" />
      <RadioButton GroupName="Scope" Content="{Binding SelectionLabel}" IsChecked="{Binding IsSelection}" IsEnabled="{Binding CanSelection}"
                   AutomationProperties.Name="선택한 셀" />
    </StackPanel>
    <CheckBox Content="내보낸 뒤 열기" IsChecked="{Binding OpenAfter}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="SaveButton" Content="저장" Command="{Binding SaveCommand}" IsDefault="True" />
      <Button x:Name="CloseButton" Content="취소" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
