<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cm="using:Oranda.App.Features.ConnectionManager"
             xmlns:cp="using:Avalonia.Controls.Primitives"
             x:Class="Oranda.App.Features.ConnectionManager.ProfileEditorView"
             x:DataType="cm:ProfileEditorViewModel">
  <UserControl.Styles>
    <!-- 라벨 열은 모든 묶음이 같은 폭(SharedSizeGroup)이고 오른쪽에 붙인다(Orange 로그온 창처럼 칸 시작이 한 줄로 맞는다). -->
    <Style Selector="Grid > TextBlock">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 한 줄에 칸 둘을 놓을 때 둘째 라벨(포트·라벨 색·인증)은 글자 폭만 쓴다. -->
    <Style Selector="Grid > TextBlock.inline">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <!-- 구역 머리글(일반·접속·인증): 굵은 글자 + 아래 구분선. -->
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.section > TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 접속 방식 단추 묶음: 폼 안에서는 툴바보다 큰 본문 글자와 넉넉한 여백을 쓴다. -->
    <Style Selector="ListBox.segmented.form ListBoxItem">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeBase}" />
      <Setter Property="Padding" Value="10,3" />
    </Style>
    <!-- 라벨 자리의 작은 고르기(서비스 이름/SID): 테두리·바탕 없이 라벨처럼 보이고 ▾ 로 바꾼다. -->
    <Style Selector="ComboBox.label-choice">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,2,0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <!-- 비어 있는 필수 칸: 라벨 글자와 칸 테두리를 빨강으로(접속·시험 단추도 꺼진다). -->
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource OrandaIconRedBrush}" />
    </Style>
    <Style Selector="TextBox.missing /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaIconRedBrush}" />
    </Style>
    <Style Selector="ComboBox.missing /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaIconRedBrush}" />
    </Style>
    <!-- 라벨 색 견본 단추: 작은 색 칸(앱 공통 단추 크기·여백을 쓰지 않는다). -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaIconBlueBrush}" />
    </Style>
    <!-- 색 고르기(스펙트럼·밝기 막대) 테마는 이 화면에서만 읽는다(앱 시작 경로에 넣지 않는다). -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  </UserControl.Styles>
  <!-- 900×640 창에서 고급 설정을 접은 채로 스크롤 없이 보이도록 구역(일반·접속·인증·고급)으로 나누고, 짧은 칸은 한 줄에 둘씩 놓는다. -->
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <Border Classes="section">
      <TextBlock Text="일반" />
    </Border>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Text="이름" Classes.error="{Binding NameMissing}" />
      <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Classes.missing="{Binding NameMissing}" AutomationProperties.Name="이름" />
      <TextBlock Grid.Row="1" Text="그룹" />
      <!-- 기존 폴더를 고르거나 「부모/자식」 형태로 직접 입력한다. -->
      <AutoCompleteBox x:Name="GroupBox" Grid.Row="1" Grid.Column="1" Text="{Binding Group}" ItemsSource="{Binding KnownGroups}"
                       MinimumPrefixLength="0" FilterMode="Contains" PlaceholderText="폴더 경로(선택, 하위는 부모/자식)" AutomationProperties.Name="그룹" />
      <TextBlock Grid.Row="2" Text="환경" />
      <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
        <ComboBox x:Name="EnvironmentBox" Grid.Column="0" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Environments}" SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Environment}" AutomationProperties.Name="환경" />
        <TextBlock Grid.Column="1" Classes="inline" Text="라벨 색" />
        <!-- 견본 + 값 단추. 펼침 창: 빨강이 아닌 견본, 기본 색, 사용자 지정 색(스펙트럼 + 밝기), #RRGGBB 입력. 빨강 판정은 저장 때(TryBuild)와 같다. -->
        <DropDownButton x:Name="ColorButton" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        MinHeight="28" Padding="6,2" IsEnabled="{Binding CanPickColor}"
                        ToolTip.Tip="#RRGGBB (운영은 항상 빨강)" AutomationProperties.Name="라벨 색">
          <DockPanel>
            <Border x:Name="ColorSwatch" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" CornerRadius="3" BorderThickness="1"
                    BorderBrush="{DynamicResource OrandaSeparatorBrush}" Background="{Binding EffectiveColor}" VerticalAlignment="Center" />
            <TextBlock x:Name="ColorLabelText" Text="{Binding ColorLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="226" Spacing="8">
                <ItemsControl x:Name="ColorPresetList" ItemsSource="{Binding ColorPresets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="4" LineSpacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="cm:LabelColorPreset">
                      <Button Classes="swatch" Background="{Binding Hex}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ColorDefaultButton" Classes="tool" Content="기본 색" HorizontalAlignment="Left"
                        ToolTip.Tip="환경 기본색으로 되돌립니다" AutomationProperties.Name="기본 색" />
                <cp:ColorSpectrum x:Name="ColorSpectrum" Height="110" Components="HueSaturation" Shape="Box"
                                  AutomationProperties.Name="사용자 지정 색" />
                <cp:ColorSlider x:Name="ColorValueSlider" Orientation="Horizontal" ColorModel="Hsva" IsAlphaVisible="False"
                                ColorComponent="{Binding #ColorSpectrum.ThirdComponent}" HsvColor="{Binding #ColorSpectrum.HsvColor}"
                                AutomationProperties.Name="밝기" />
                <TextBox x:Name="ColorBox" Text="{Binding ColorText}" PlaceholderText="#RRGGBB" AutomationProperties.Name="색 코드" />
                <TextBlock x:Name="ColorWarningText" Classes="error" Text="{Binding ColorWarning}" TextWrapping="Wrap"
                           IsVisible="{Binding ColorWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </Grid>
      <!-- 접속 설명(여러 줄, 2줄 높이에서 3줄까지 늘고 그 뒤는 스크롤). 접속 목록 줄 도움말·찾기에 쓰인다. -->
      <TextBlock Grid.Row="3" Text="설명" VerticalAlignment="Top" Margin="0,5,0,0" />
      <TextBox x:Name="CommentBox" Grid.Row="3" Grid.Column="1" Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="44" MaxHeight="64" PlaceholderText="이 접속에 대한 메모(선택, 여러 줄)" AutomationProperties.Name="설명" />
    </Grid>

    <Border Classes="section">
      <TextBlock Text="접속" />
    </Border>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="접속 방식" />
      <!-- SQL Developer·DBeaver·Toad 처럼 방식을 붙은 단추로 고른다(호스트·포트 = Basic/Direct, TNS, 접속 문자열 = Custom). -->
      <ListBox x:Name="ModeBox" Grid.Column="1" Classes="segmented form" HorizontalAlignment="Left"
               ItemsSource="{Binding Modes}" SelectedValueBinding="{ReflectionBinding Value}"
               SelectedValue="{Binding Mode}" AutomationProperties.Name="접속 방식">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{ReflectionBinding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid IsVisible="{Binding IsHostPortMode}" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Text="호스트" Classes.error="{Binding HostMissing}" />
      <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Text="{Binding Host}" Classes.missing="{Binding HostMissing}" AutomationProperties.Name="호스트" />
      <TextBlock Grid.Row="0" Grid.Column="2" Classes="inline" Text="포트" />
      <TextBox x:Name="PortBox" Grid.Row="0" Grid.Column="3" Width="80" Text="{Binding Port}" AutomationProperties.Name="포트" />
      <!-- SQL Developer·DBeaver 처럼 서비스 이름과 SID 를 고른다. 줄을 늘리지 않게 라벨 자리에 둔다(SID 는 접속 기술자로 저장). -->
      <ComboBox x:Name="ServiceKindBox" Grid.Row="1" Classes="label-choice" HorizontalAlignment="Right"
                SelectedIndex="{Binding ServiceKindIndex}" AutomationProperties.Name="서비스 이름 또는 SID">
        <ComboBoxItem Content="서비스 이름" />
        <ComboBoxItem Content="SID" />
      </ComboBox>
      <TextBox x:Name="ServiceBox" Grid.Row="1" Grid.Column="1" Text="{Binding Service}" Classes.missing="{Binding ServiceMissing}" AutomationProperties.Name="서비스" />
      <CheckBox x:Name="TlsBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="TLS(tcps)" IsChecked="{Binding UseTls}" />
    </Grid>

    <Grid IsVisible="{Binding IsEasyConnectMode}" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="접속 문자열" Classes.error="{Binding EasyConnectMissing}" />
      <!-- 접속 기술자((DESCRIPTION=…))는 길어서 접어 보인다: 두 줄에서 시작해 세 줄까지 늘어난다(Enter 는 넣지 않는다). -->
      <TextBox x:Name="EasyConnectBox" Grid.Column="1" Text="{Binding EasyConnect}" Classes.missing="{Binding EasyConnectMissing}"
               TextWrapping="Wrap" AcceptsReturn="False" MinHeight="52" MaxHeight="76" VerticalContentAlignment="Top"
               FontFamily="{StaticResource OrandaCodeFontFamily}"
               PlaceholderText="host:1521/service?connect_timeout=5, tcps://… 또는 (DESCRIPTION=…)" AutomationProperties.Name="접속 문자열" />
    </Grid>

    <!-- 폴더 칸은 직접 입력하거나 「찾아보기…」 로 폴더 선택 창에서 고른다. 방식이 쓰지 않는 칸은 숨긴다(TNS 디렉터리 = TNS 별칭만, 지갑 = TLS 를 쓸 수 있을 때). -->
    <Grid IsVisible="{Binding IsTnsMode}" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="TNS 디렉터리" />
      <TextBox x:Name="TnsAdminBox" Grid.Column="1" Text="{Binding TnsAdmin}" PlaceholderText="tnsnames.ora 가 있는 폴더(선택)" AutomationProperties.Name="TNS 디렉터리" />
      <Button x:Name="TnsAdminBrowseButton" Grid.Column="2" Content="찾아보기…" AutomationProperties.Name="TNS 디렉터리 찾아보기" />
    </Grid>

    <Grid IsVisible="{Binding IsTnsMode}" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="TNS 별칭" Classes.error="{Binding TnsAliasMissing}" />
      <!-- 입력되는 콤보: ▾ 로 TNS 디렉터리 tnsnames.ora 의 별칭 전체를 펼쳐 고르고, 목록에 없는 별칭도 직접 친다. 아래 줄은 고른 별칭의 host:port/service. -->
      <ComboBox x:Name="TnsAliasBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                Text="{Binding TnsAlias, Mode=TwoWay}" ItemsSource="{Binding TnsAliases}" Classes.missing="{Binding TnsAliasMissing}"
                PlaceholderText="TNS 디렉터리를 넣으면 tnsnames.ora 의 별칭이 나옵니다" AutomationProperties.Name="TNS 별칭" />
      <TextBlock x:Name="TnsAliasDetail" Grid.Row="1" Grid.Column="1" Text="{Binding TnsAliasDetail}" Opacity="0.7"
                 FontSize="{DynamicResource OrandaFontSizeSmall}" IsVisible="{Binding TnsAliasDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>

    <Grid IsVisible="{Binding UsesWallet}" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="지갑 폴더" />
      <TextBox x:Name="WalletBox" Grid.Column="1" Text="{Binding WalletLocation}" PlaceholderText="cwallet.sso 가 있는 폴더(선택)" AutomationProperties.Name="지갑 폴더" />
      <Button x:Name="WalletBrowseButton" Grid.Column="2" Content="찾아보기…" AutomationProperties.Name="지갑 폴더 찾아보기" />
    </Grid>

    <Border Classes="section">
      <TextBlock Text="인증" />
    </Border>
    <Grid RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Text="사용자" Classes.error="{Binding UserMissing}" />
      <TextBox x:Name="UserBox" Grid.Row="0" Grid.Column="1" Text="{Binding User}" Classes.missing="{Binding UserMissing}" AutomationProperties.Name="사용자" />
      <TextBlock Grid.Row="0" Grid.Column="2" Classes="inline" Text="인증" />
      <ComboBox x:Name="AuthBox" Grid.Row="0" Grid.Column="3" MinWidth="130"
                ItemsSource="{Binding AuthModes}" SelectedValueBinding="{ReflectionBinding Value}"
                SelectedValue="{Binding Auth}" AutomationProperties.Name="인증 모드" />
      <TextBlock Grid.Row="1" Text="비밀번호" />
      <TextBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Text="{Binding Password}" PasswordChar="●"
               PlaceholderText="비워 두면 저장된 값을 씁니다" AutomationProperties.Name="비밀번호" />
      <CheckBox x:Name="SavePasswordBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="비밀번호 저장"
                ToolTip.Tip="비밀번호 저장(안전 저장소). 끄면 접속할 때마다 묻습니다." IsChecked="{Binding SavePassword}" />
    </Grid>

    <Expander x:Name="AdvancedExpander" Header="고급 설정(프록시·읽기 전용·NLS·시간 제한)" IsExpanded="False" HorizontalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="프록시 사용자" />
        <TextBox x:Name="ProxyBox" Grid.Row="0" Grid.Column="1" Text="{Binding ProxyUser}" PlaceholderText="비워 두면 프록시를 쓰지 않습니다" AutomationProperties.Name="프록시 사용자" />
        <CheckBox x:Name="ReadOnlyBox" Grid.Row="1" Grid.Column="1" Content="읽기 전용 접속(쓰기 문장 차단)" IsChecked="{Binding ReadOnly}" />
        <TextBlock Grid.Row="2" Text="관리 팩" />
        <ComboBox x:Name="PackBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Packs}" SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding LicensePack}" AutomationProperties.Name="관리 팩" />
        <TextBlock Grid.Row="3" Text="접속 제한(초)" />
        <NumericUpDown x:Name="TimeoutBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                       Minimum="1" Maximum="3600" FormatString="0" Value="{Binding ConnectTimeoutSeconds}" />
        <TextBlock Grid.Row="4" Text="연결 유지(초)" />
        <NumericUpDown x:Name="KeepAliveBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                       Minimum="0" Maximum="86400" FormatString="0" Value="{Binding KeepAliveSeconds}" />
        <TextBlock Grid.Row="5" Text="NLS 날짜 형식" />
        <TextBox x:Name="NlsDateBox" Grid.Row="5" Grid.Column="1" Text="{Binding NlsDateFormat}" PlaceholderText="NLS_DATE_FORMAT" />
        <TextBlock Grid.Row="6" Text="NLS 타임스탬프" />
        <TextBox x:Name="NlsTimestampBox" Grid.Row="6" Grid.Column="1" Text="{Binding NlsTimestampFormat}" PlaceholderText="NLS_TIMESTAMP_FORMAT" />
        <TextBlock Grid.Row="7" Text="NLS 언어" />
        <TextBox x:Name="NlsLanguageBox" Grid.Row="7" Grid.Column="1" Text="{Binding NlsLanguage}" PlaceholderText="NLS_LANGUAGE" />
        <TextBlock Grid.Row="8" Text="NLS 지역" />
        <TextBox x:Name="NlsTerritoryBox" Grid.Row="8" Grid.Column="1" Text="{Binding NlsTerritory}" PlaceholderText="NLS_TERRITORY" />
        <TextBlock Grid.Row="9" Text="NLS 정렬" />
        <TextBox x:Name="NlsSortBox" Grid.Row="9" Grid.Column="1" Text="{Binding NlsSort}" PlaceholderText="NLS_SORT" />
      </Grid>
    </Expander>
  </StackPanel>
</UserControl>
