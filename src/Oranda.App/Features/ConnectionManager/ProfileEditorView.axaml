<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cm="using:Oranda.App.Features.ConnectionManager"
             x:Class="Oranda.App.Features.ConnectionManager.ProfileEditorView"
             x:DataType="cm:ProfileEditorViewModel">
  <StackPanel Spacing="8">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="이름" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Text="{Binding Name}" AutomationProperties.Name="이름" />
        <TextBlock Grid.Row="1" Text="그룹" VerticalAlignment="Center" />
        <TextBox x:Name="GroupBox" Grid.Row="1" Grid.Column="1" Text="{Binding Group}" PlaceholderText="폴더 이름(선택)" AutomationProperties.Name="그룹" />
        <TextBlock Grid.Row="2" Text="환경" VerticalAlignment="Center" />
        <ComboBox x:Name="EnvironmentBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Environments}" SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Environment}" AutomationProperties.Name="환경" />
        <TextBlock Grid.Row="3" Text="라벨 색" VerticalAlignment="Center" />
        <TextBox x:Name="ColorBox" Grid.Row="3" Grid.Column="1" Text="{Binding ColorText}" PlaceholderText="#RRGGBB (운영은 항상 빨강)"
                 IsEnabled="{Binding CanPickColor}" AutomationProperties.Name="라벨 색" />
        <TextBlock Grid.Row="4" Text="접속 방식" VerticalAlignment="Center" />
        <ComboBox x:Name="ModeBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Modes}" SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Mode}" AutomationProperties.Name="접속 방식" />
      </Grid>
  
      <Grid IsVisible="{Binding IsHostPortMode}" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="호스트" VerticalAlignment="Center" />
        <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Text="{Binding Host}" AutomationProperties.Name="호스트" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="포트" VerticalAlignment="Center" />
        <TextBox x:Name="PortBox" Grid.Row="0" Grid.Column="3" Width="80" Text="{Binding Port}" AutomationProperties.Name="포트" />
        <TextBlock Grid.Row="1" Text="서비스" VerticalAlignment="Center" />
        <TextBox x:Name="ServiceBox" Grid.Row="1" Grid.Column="1" Text="{Binding Service}" AutomationProperties.Name="서비스" />
        <CheckBox x:Name="TlsBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="TLS(tcps)" IsChecked="{Binding UseTls}" />
      </Grid>
  
      <Grid IsVisible="{Binding IsEasyConnectMode}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Text="접속 문자열" VerticalAlignment="Center" />
        <TextBox x:Name="EasyConnectBox" Grid.Column="1" Text="{Binding EasyConnect}"
                 PlaceholderText="host:1521/service?connect_timeout=5 또는 tcps://…" AutomationProperties.Name="접속 문자열" />
      </Grid>
  
      <Grid IsVisible="{Binding IsTnsMode}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Text="TNS 별칭" VerticalAlignment="Center" />
        <TextBox x:Name="TnsAliasBox" Grid.Column="1" Text="{Binding TnsAlias}" AutomationProperties.Name="TNS 별칭" />
      </Grid>
  
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="TNS 디렉터리" VerticalAlignment="Center" />
        <TextBox x:Name="TnsAdminBox" Grid.Row="0" Grid.Column="1" Text="{Binding TnsAdmin}" PlaceholderText="tnsnames.ora 가 있는 폴더(선택)" AutomationProperties.Name="TNS 디렉터리" />
        <TextBlock Grid.Row="1" Text="지갑 폴더" VerticalAlignment="Center" />
        <TextBox x:Name="WalletBox" Grid.Row="1" Grid.Column="1" Text="{Binding WalletLocation}" PlaceholderText="cwallet.sso 가 있는 폴더(선택)" AutomationProperties.Name="지갑 폴더" />
        <TextBlock Grid.Row="2" Text="사용자" VerticalAlignment="Center" />
        <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Text="{Binding User}" AutomationProperties.Name="사용자" />
        <TextBlock Grid.Row="3" Text="비밀번호" VerticalAlignment="Center" />
        <TextBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Text="{Binding Password}" PasswordChar="●"
                 PlaceholderText="비워 두면 저장된 값을 씁니다" AutomationProperties.Name="비밀번호" />
        <CheckBox x:Name="SavePasswordBox" Grid.Row="4" Grid.Column="1" Content="비밀번호 저장(안전 저장소). 끄면 접속할 때마다 묻습니다."
                  IsChecked="{Binding SavePassword}" />
        <TextBlock Grid.Row="5" Text="인증" VerticalAlignment="Center" />
        <ComboBox x:Name="AuthBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding AuthModes}" SelectedValueBinding="{ReflectionBinding Value}"
                  SelectedValue="{Binding Auth}" AutomationProperties.Name="인증 모드" />
      </Grid>
  
      <Expander Header="고급" IsExpanded="False">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8" Margin="0,8,0,0">
          <TextBlock Grid.Row="0" Text="프록시 사용자" VerticalAlignment="Center" />
          <TextBox x:Name="ProxyBox" Grid.Row="0" Grid.Column="1" Text="{Binding ProxyUser}" PlaceholderText="비워 두면 프록시를 쓰지 않습니다" AutomationProperties.Name="프록시 사용자" />
          <CheckBox x:Name="ReadOnlyBox" Grid.Row="1" Grid.Column="1" Content="읽기 전용 접속(쓰기 문장 차단)" IsChecked="{Binding ReadOnly}" />
          <TextBlock Grid.Row="2" Text="관리 팩" VerticalAlignment="Center" />
          <ComboBox x:Name="PackBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Packs}" SelectedValueBinding="{ReflectionBinding Value}"
                    SelectedValue="{Binding LicensePack}" AutomationProperties.Name="관리 팩" />
          <TextBlock Grid.Row="3" Text="접속 제한(초)" VerticalAlignment="Center" />
          <NumericUpDown x:Name="TimeoutBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                         Minimum="1" Maximum="3600" FormatString="0" Value="{Binding ConnectTimeoutSeconds}" />
          <TextBlock Grid.Row="4" Text="연결 유지(초)" VerticalAlignment="Center" />
          <NumericUpDown x:Name="KeepAliveBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" MinWidth="120"
                         Minimum="0" Maximum="86400" FormatString="0" Value="{Binding KeepAliveSeconds}" />
          <TextBlock Grid.Row="5" Text="NLS 날짜 형식" VerticalAlignment="Center" />
          <TextBox x:Name="NlsDateBox" Grid.Row="5" Grid.Column="1" Text="{Binding NlsDateFormat}" PlaceholderText="NLS_DATE_FORMAT" />
          <TextBlock Grid.Row="6" Text="NLS 타임스탬프" VerticalAlignment="Center" />
          <TextBox x:Name="NlsTimestampBox" Grid.Row="6" Grid.Column="1" Text="{Binding NlsTimestampFormat}" PlaceholderText="NLS_TIMESTAMP_FORMAT" />
          <TextBlock Grid.Row="7" Text="NLS 언어" VerticalAlignment="Center" />
          <TextBox x:Name="NlsLanguageBox" Grid.Row="7" Grid.Column="1" Text="{Binding NlsLanguage}" PlaceholderText="NLS_LANGUAGE" />
          <TextBlock Grid.Row="8" Text="NLS 지역" VerticalAlignment="Center" />
          <TextBox x:Name="NlsTerritoryBox" Grid.Row="8" Grid.Column="1" Text="{Binding NlsTerritory}" PlaceholderText="NLS_TERRITORY" />
          <TextBlock Grid.Row="9" Text="NLS 정렬" VerticalAlignment="Center" />
          <TextBox x:Name="NlsSortBox" Grid.Row="9" Grid.Column="1" Text="{Binding NlsSort}" PlaceholderText="NLS_SORT" />
        </Grid>
      </Expander>
    </StackPanel>
</UserControl>
