<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cm="using:Oranda.App.Features.ConnectionManager"
        xmlns:icons="using:Oranda.App.Shell.Icons"
        x:Class="Oranda.App.Features.ConnectionManager.ConnectionManagerWindow"
        x:DataType="cm:ConnectionManagerViewModel"
        Title="접속 관리자"
        Width="960" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        DragDrop.AllowDrop="True"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <!-- 실패한 상태 글과 비어 있는 필수 칸은 빨강(테마별 리소스 색). -->
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource OrandaIconRedBrush}" />
    </Style>
  </Window.Styles>
  <!-- 고정 크기 칸을 쓰지 않는다: 왼쪽 목록은 비율, 오른쪽 폼은 스크롤. 단추 줄은 항상 아래에 고정. -->
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <!-- 시험(SQL Developer 의 Test)은 왼쪽 끝: 시험하는 동안에는 「시험 취소」 로 바뀐다. 상태 글은 시험 오른쪽 남는 칸. -->
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button x:Name="TestButton" Content="시험" Command="{Binding TestCommand}" IsVisible="{Binding !TestCommand.IsRunning}"
                ToolTip.Tip="지금 값으로 임시 연결을 열어 서버 버전과 걸린 시간을 보이고 바로 닫습니다" />
        <Button x:Name="CancelTestButton" Content="시험 취소" Command="{Binding TestCancelCommand}" IsVisible="{Binding TestCommand.IsRunning}" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"
                 Classes.error="{Binding StatusIsError}" AutomationProperties.Name="상태" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="SaveButton" Content="저장" Command="{Binding SaveCommand}" />
        <Button x:Name="ConnectButton" Content="접속" Command="{Binding ConnectCommand}" IsDefault="True" Classes="accent" />
        <Button x:Name="CloseButton" Content="닫기" Command="{Binding CloseCommand}" IsCancel="True" />
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FileNotice}" IsVisible="{Binding FileNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" Margin="0,8,0,0" />

    <!-- 왼쪽 목록과 오른쪽 폼 사이의 GridSplitter 로 목록 폭을 바꾼다. -->
    <Grid x:Name="BodyGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="220" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="3*" MinWidth="380" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Classes="panel-toolbar" Margin="0,0,0,4">
          <!-- 아이콘만 한 줄(Orange Sub Toolbar). 이름은 도움말·낭독기 이름으로 옮긴다. 줄을 바꾸지 않는다(최소 폭에서도 들어간다). -->
          <StackPanel x:Name="ListToolbar" Orientation="Horizontal" Spacing="2">
            <Button x:Name="AddButton" Classes="toolbar" Content="새 접속" Command="{Binding AddNewCommand}"
                    icons:ButtonIcon.Key="add" icons:ButtonIcon.IconOnly="True" />
            <Button x:Name="NewFolderButton" Classes="toolbar" Content="새 폴더" Command="{Binding NewFolderCommand}"
                    icons:ButtonIcon.Key="folderAdd" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="폴더를 만듭니다(폴더를 고르면 그 안에). 접속을 폴더 위로 끌어 놓아 옮길 수 있습니다" />
            <Button x:Name="DuplicateButton" Classes="toolbar" Content="복제" Command="{Binding DuplicateCommand}"
                    icons:ButtonIcon.Key="copy" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="고른 접속을 복제합니다(비밀번호는 복사하지 않습니다)" />
            <Button x:Name="DeleteButton" Classes="toolbar" Content="삭제" Command="{Binding DeleteCommand}"
                    icons:ButtonIcon.Key="delete" icons:ButtonIcon.IconOnly="True" />
            <Button x:Name="ImportButton" Classes="toolbar" Content="가져오기" Command="{Binding ImportCommand}"
                    icons:ButtonIcon.Key="import" icons:ButtonIcon.IconOnly="True"
                    ToolTip.Tip="SQL Developer·tnsnames.ora·Orange 접속 목록에서 가져옵니다" />
          </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
          <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="찾기(이름·사용자·호스트·서비스·그룹·설명)"
                   AutomationProperties.Name="접속 찾기" />
          <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="110" ItemsSource="{Binding SortOrders}" SelectedValueBinding="{ReflectionBinding Value}"
                    SelectedValue="{Binding SortOrder}" AutomationProperties.Name="정렬" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="{DynamicResource OrandaFontSizeSmall}"
                   Text="ADB 지갑(Wallet_*.zip)을 이 창에 끌어 놓으면 접속이 만들어집니다." />
        <!-- Enter·두 번 누르기 = 접속, Delete = 삭제, F2 = 이름 칸으로(창 코드). 오른쪽 클릭은 누른 줄을 먼저 고른다. -->
        <TreeView x:Name="ConnectionTree" Classes="compact" ItemsSource="{Binding Tree}" SelectedItem="{Binding Selected}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="접속 목록">
          <TreeView.ContextMenu>
            <ContextMenu x:Name="TreeMenu">
              <MenuItem x:Name="MenuConnect" Header="접속" Command="{Binding ConnectCommand}" InputGesture="Enter" />
              <MenuItem x:Name="MenuDuplicate" Header="복제" Command="{Binding DuplicateCommand}" />
              <MenuItem x:Name="MenuDelete" Header="삭제" Command="{Binding DeleteCommand}" InputGesture="Delete" />
              <Separator />
              <MenuItem x:Name="MenuNewFolder" Header="새 폴더" Command="{Binding NewFolderCommand}" />
              <MenuItem x:Name="MenuRenameFolder" Header="폴더 이름 바꾸기" Command="{Binding RenameFolderCommand}" InputGesture="F2" />
              <MenuItem x:Name="MenuMoveToFolder" Header="폴더로 이동…" Command="{Binding MoveToFolderCommand}" />
              <Separator />
              <MenuItem x:Name="MenuCopyConnectString" Header="연결 문자열 복사" Command="{Binding CopyConnectionStringCommand}" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="cm:ConnectionTreeNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
            <!-- 줄 내용을 목록 폭에 맞춘다(가로 스크롤 없이): user@접속은 말줄임, 마지막 접속 시각은 오른쪽 끝에 남는다. -->
            <!-- 끌어 놓을 폴더 줄 강조. -->
            <Style Selector="Grid.drop">
              <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
            </Style>
            <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="cm:ConnectionTreeNode" ItemsSource="{Binding Children}">
              <!-- 칩 · 이름 · 변경 표시 · user@접속(남는 폭, 말줄임) · 마지막 접속 시각(오른쪽). -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" AutomationProperties.Name="{Binding AccessibleName}"
                    Classes.drop="{Binding IsDropTarget}" ToolTip.Tip="{Binding Tip}">
                <Border Grid.Column="0" IsVisible="{Binding HasChip}" Background="{Binding EnvironmentColor}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding EnvironmentLabel}" Foreground="White" FontSize="12" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}" />
                <!-- 폴더 이름 편집: Enter 확정, Esc 취소(창 코드). -->
                <TextBox x:Name="FolderNameBox" Grid.Column="1" Text="{Binding EditText}" IsVisible="{Binding IsEditing}"
                         MinWidth="140" MaxWidth="280" HorizontalAlignment="Left" Padding="4,0" MinHeight="22" AutomationProperties.Name="폴더 이름" />
                <TextBlock Grid.Column="2" Text="●" IsVisible="{Binding IsModified}" VerticalAlignment="Center" FontSize="10"
                           Foreground="{DynamicResource OrandaUncommittedBrush}" ToolTip.Tip="저장하지 않은 변경" />
                <TextBlock Grid.Column="3" Text="{Binding Subtitle}" VerticalAlignment="Center" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding LastConnectedText}" ToolTip.Tip="{Binding LastConnectedTip}" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="12" Margin="0,0,4,0" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter x:Name="ListSplitter" Grid.Column="1" ResizeDirection="Columns" Width="5" HorizontalAlignment="Center"
                    Background="{DynamicResource OrandaSplitterBrush}" AutomationProperties.Name="목록 폭 조절" />

      <TextBlock Grid.Column="2" Text="왼쪽 목록에서 접속을 고르거나 「새 접속」을 누르세요." TextWrapping="Wrap" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}" />
      <DockPanel Grid.Column="2" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
        <!-- 연결 문자열 미리보기(읽기 전용, 비밀번호는 넣지 않는다): 폼을 스크롤해도 늘 보이게 아래에 붙인다. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,8,12,0">
          <TextBlock Grid.Column="0" Text="연결 문자열" MinWidth="96" TextAlignment="Right" VerticalAlignment="Center" />
          <TextBox x:Name="PreviewBox" Grid.Column="1" Text="{Binding Editor.ConnectionStringPreview, Mode=OneWay}" IsReadOnly="True"
                   FontFamily="Consolas,Menlo,monospace" AutomationProperties.Name="연결 문자열 미리보기" />
          <Button x:Name="CopyPreviewButton" Grid.Column="2" Classes="tool" Content="복사" Command="{Binding CopyPreviewCommand}"
                  icons:ButtonIcon.Key="copy" ToolTip.Tip="연결 문자열을 클립보드에 복사합니다(비밀번호는 넣지 않습니다)" />
        </Grid>
        <ScrollViewer x:Name="EditorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <cm:ProfileEditorView x:Name="EditorView" DataContext="{Binding Editor}" Margin="0,0,12,0" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
