<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cm="using:Oranda.App.Features.ConnectionManager"
        xmlns:icons="using:Oranda.App.Shell.Icons"
        x:Class="Oranda.App.Features.ConnectionManager.ConnectionManagerWindow"
        x:DataType="cm:ConnectionManagerViewModel"
        Title="접속 관리자"
        Width="900" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        DragDrop.AllowDrop="True"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <!-- 실패한 상태 글과 비어 있는 필수 칸은 빨강(테마별 리소스 색). -->
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource OrandaIconRedBrush}" />
    </Style>
  </Window.Styles>
  <!-- 고정 크기 칸을 쓰지 않는다: 왼쪽 목록은 비율, 오른쪽 폼은 스크롤. 단추 줄은 항상 아래에 고정. -->
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Classes.error="{Binding StatusIsError}" AutomationProperties.Name="상태" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
        <Button x:Name="SaveButton" MinWidth="80" Content="저장" Command="{Binding SaveCommand}" />
        <Button x:Name="ConnectButton" MinWidth="80" Content="접속" Command="{Binding ConnectCommand}" IsDefault="True" Classes="accent" />
        <Button x:Name="CloseButton" MinWidth="80" Content="닫기" Command="{Binding CloseCommand}" IsCancel="True" />
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FileNotice}" IsVisible="{Binding FileNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" Margin="0,8,0,0" />

    <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Classes="panel-toolbar" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="AddButton" Classes="tool" Content="새 접속" Command="{Binding AddNewCommand}" icons:ButtonIcon.Key="add" />
            <Button x:Name="DuplicateButton" Classes="tool" Content="복제" Command="{Binding DuplicateCommand}" icons:ButtonIcon.Key="copy"
                    ToolTip.Tip="고른 접속을 복제합니다(비밀번호는 복사하지 않습니다)" />
            <Button x:Name="DeleteButton" Classes="tool" Content="삭제" Command="{Binding DeleteCommand}" icons:ButtonIcon.Key="delete" />
            <Button x:Name="ImportButton" Classes="tool" Content="가져오기" Command="{Binding ImportCommand}" icons:ButtonIcon.Key="import"
                    ToolTip.Tip="SQL Developer·tnsnames.ora·Orange 접속 목록에서 가져옵니다" />
          </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
          <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="찾기(이름·사용자·호스트·서비스·그룹)"
                   AutomationProperties.Name="접속 찾기" />
          <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="110" ItemsSource="{Binding SortOrders}" SelectedValueBinding="{ReflectionBinding Value}"
                    SelectedValue="{Binding SortOrder}" AutomationProperties.Name="정렬" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="{DynamicResource OrandaFontSizeSmall}"
                   Text="ADB 지갑(Wallet_*.zip)을 이 창에 끌어 놓으면 접속이 만들어집니다." />
        <!-- Enter·두 번 누르기 = 접속, Delete = 삭제, F2 = 이름 칸으로(창 코드). 오른쪽 클릭은 누른 줄을 먼저 고른다. -->
        <TreeView x:Name="ConnectionTree" Classes="compact" ItemsSource="{Binding Tree}" SelectedItem="{Binding Selected}"
                  AutomationProperties.Name="접속 목록">
          <TreeView.ContextMenu>
            <ContextMenu x:Name="TreeMenu">
              <MenuItem x:Name="MenuConnect" Header="접속" Command="{Binding ConnectCommand}" InputGesture="Enter" />
              <MenuItem x:Name="MenuDuplicate" Header="복제" Command="{Binding DuplicateCommand}" />
              <MenuItem x:Name="MenuDelete" Header="삭제" Command="{Binding DeleteCommand}" InputGesture="Delete" />
              <Separator />
              <MenuItem x:Name="MenuCopyConnectString" Header="연결 문자열 복사" Command="{Binding CopyConnectionStringCommand}" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="cm:ConnectionTreeNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="cm:ConnectionTreeNode" ItemsSource="{Binding Children}">
              <!-- 칩 · 이름 · 변경 표시 · user@접속(남는 폭, 말줄임) · 마지막 접속 시각(오른쪽). -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                <Border Grid.Column="0" IsVisible="{Binding HasChip}" Background="{Binding EnvironmentColor}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding EnvironmentLabel}" Foreground="White" FontSize="12" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="●" IsVisible="{Binding IsModified}" VerticalAlignment="Center" FontSize="10"
                           Foreground="{DynamicResource OrandaUncommittedBrush}" ToolTip.Tip="저장하지 않은 변경" />
                <TextBlock Grid.Column="3" Text="{Binding Subtitle}" VerticalAlignment="Center" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding LastConnectedText}" ToolTip.Tip="{Binding LastConnectedTip}" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="12" Margin="0,0,4,0" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
        <cm:ProfileEditorView x:Name="EditorView" DataContext="{Binding Editor}" Margin="0,0,12,0" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
