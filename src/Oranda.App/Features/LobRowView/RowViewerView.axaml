<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.LobRowView"
             x:Class="Oranda.App.Features.LobRowView.RowViewerView"
             x:DataType="vm:RowViewerViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="6" Spacing="4">
      <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="PrevButton" Content="이전 행" />
        <Button x:Name="NextButton" Content="다음 행" />
      </StackPanel>
      <TextBox PlaceholderText="열 이름·값 찾기" Text="{Binding FilterText, Mode=TwoWay}" />
    </StackPanel>
    <ListBox x:Name="FieldList" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RowField">
          <Grid ColumnDefinitions="140,*" Margin="0,2">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TypeName}" Opacity="0.6" FontSize="11" />
            </StackPanel>
            <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
