<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.ResultGrid"
             x:Class="Oranda.App.Features.ResultGrid.SqlResultPaneView"
             x:DataType="vm:SqlResultPaneViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0">
    <!-- 결과 안에서 거르기 칸(oranda.grid.toggleQuickFilter, TSK-13-26): 서버에 다시 조회하지 않고 가져온 행만 바로 거른다.
         Esc 는 글을 지우고, 빈 칸이면 칸을 닫는다(걸어 둔 열 필터는 그대로). -->
    <Border Classes="panel-toolbar" IsVisible="{Binding IsQuickFilterVisible}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox x:Name="QuickFilterBox" Classes="compact" Width="240" Text="{Binding QuickFilterText}"
                 PlaceholderText="결과 안에서 거르기" AutomationProperties.Name="결과 안에서 거르기" />
        <ComboBox x:Name="QuickFilterColumnBox" Classes="compact" MinWidth="130" ItemsSource="{Binding QuickFilterColumns}"
                  SelectedItem="{Binding SelectedQuickFilterColumn}" AutomationProperties.Name="거를 열" />
        <Button x:Name="QuickFilterClearButton" Classes="toolbar" Focusable="False" Content="결과 안 거르기 모두 지우기"
                IsEnabled="{Binding HasLocalFilter}" icons:ButtonIcon.Key="filterClear" icons:ButtonIcon.IconOnly="True" />
        <Button x:Name="QuickFilterCloseButton" Classes="toolbar" Focusable="False" Content="닫기"
                icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True" />
      </StackPanel>
    </Border>
    <!-- 찾기 줄(oranda.grid.find) -->
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4"
                IsVisible="{Binding IsFindVisible}">
      <TextBox x:Name="FindBox" Classes="compact" Width="220" Text="{Binding FindText}" PlaceholderText="결과에서 찾기" />
      <Button x:Name="FindNextButton" Classes="tool" Content="다음" icons:ButtonIcon.Key="down" />
      <Button x:Name="FindCloseButton" Classes="toolbar" Content="닫기" icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True" />
      <TextBlock Text="{Binding FindMessage}" VerticalAlignment="Center" />
    </StackPanel>
    </StackPanel>
    <!-- 결과 거르기 줄(oranda.grid.toggleFilterBar, GRID-10): 결과를 만든 질의를 WHERE·ORDER BY 로 감싸 같은 바인드로 다시 실행한다.
         Enter 적용, Esc 는 칸을 비우고 빈 칸이면 줄을 닫는다. 실패·취소는 아래 상태 줄에 보인다. -->
    <Border Grid.Row="1" Classes="panel-toolbar" IsVisible="{Binding IsFilterBarVisible}">
      <Grid ColumnDefinitions="Auto,3*,Auto,Auto,2*,Auto">
        <TextBlock Grid.Column="0" Text="WHERE" VerticalAlignment="Center" Margin="4,0,6,0" FontWeight="SemiBold" />
        <TextBox x:Name="WhereBox" Grid.Column="1" Classes="compact" MinWidth="120" Text="{Binding WhereText}"
                 PlaceholderText="거를 조건(예: DEPTNO = 10)" AutomationProperties.Name="거를 조건" />
        <Button x:Name="FilterHistoryButton" Grid.Column="2" Classes="toolbar" Focusable="False" Content="최근 조건"
                IsEnabled="{Binding HasFilterHistory}" icons:ButtonIcon.Key="history" icons:ButtonIcon.IconOnly="True" />
        <TextBlock Grid.Column="3" Text="ORDER BY" VerticalAlignment="Center" Margin="8,0,6,0" FontWeight="SemiBold" />
        <TextBox x:Name="OrderByBox" Grid.Column="4" Classes="compact" MinWidth="80" Text="{Binding OrderByText}"
                 PlaceholderText="정렬(예: SAL DESC)" AutomationProperties.Name="정렬" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="1" Margin="4,0,0,0">
          <Button x:Name="FilterApplyButton" Classes="toolbar" Focusable="False" Content="거르기 적용"
                  IsEnabled="{Binding CanApplyFilter}" icons:ButtonIcon.Key="filter" icons:ButtonIcon.IconOnly="True" />
          <Button x:Name="FilterCancelButton" Classes="toolbar" Focusable="False" Content="거르기 취소"
                  IsVisible="{Binding IsFiltering}" icons:ButtonIcon.Key="cancel" icons:ButtonIcon.IconOnly="True" />
          <Button x:Name="FilterClearButton" Classes="toolbar" Focusable="False" Content="거르기 지우기"
                  IsEnabled="{Binding CanApplyFilter}" icons:ButtonIcon.Key="filterClear" icons:ButtonIcon.IconOnly="True" />
          <Button x:Name="FilterCloseButton" Classes="toolbar" Focusable="False" Content="거르기 줄 닫기"
                  icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- 편집할 수 없는 결과를 고치려 할 때의 안내(읽기 전용이면 편집 모드로 다시 실행, 키가 없으면 그 이유). -->
    <Border Grid.Row="2" IsVisible="{Binding HasEditHint}" Background="{DynamicResource OrandaPanelHeaderBrush}"
            BorderBrush="{DynamicResource OrandaIconAmberBrush}" BorderThickness="3,0,0,0" Padding="6,3">
      <DockPanel>
        <Button x:Name="EditHintClose" DockPanel.Dock="Right" Classes="toolbar" Content="안내 닫기" Focusable="False"
                icons:ButtonIcon.Key="clear" icons:ButtonIcon.IconOnly="True" />
        <!-- 단추는 안내 글 바로 뒤에 둔다(넓은 창에서 오른쪽 끝으로 떨어지지 않게). -->
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{Binding EditHint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
          <Button x:Name="EditHintRerun" Padding="8,2" MinHeight="0" Focusable="False" Content="편집 모드로 다시 실행"
                  IsVisible="{Binding OffersRerunForEdit}" icons:ButtonIcon.Key="tableEdit" />
          <Button x:Name="EditHintRowId" Padding="8,2" MinHeight="0" Focusable="False" Content="ROWID 추가 후 다시 실행"
                  IsVisible="{Binding OffersRowIdRerun}" icons:ButtonIcon.Key="tableEdit" />
        </WrapPanel>
      </DockPanel>
    </Border>
    <!-- 결과 툴바: 편집 모드에서만 보인다. 오렌지 결과 그리드처럼 행 추가·복제·붙여넣기·삭제·반영·되돌리기를
         아이콘으로 바로 쓴다(오른쪽 클릭 메뉴와 같은 명령). Excel 단추는 결과 탭 줄(ResultTabsView)에 있다. -->
    <Border Grid.Row="3" Classes="panel-toolbar" IsVisible="{Binding IsEditMode}">
      <StackPanel Orientation="Horizontal" Spacing="1">
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.addRow" Content="행 추가"
                icons:ButtonIcon.Key="rowAdd" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.duplicateRow" Content="행 복제"
                icons:ButtonIcon.Key="rowDuplicate" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.pasteRows" Content="행 붙여넣기"
                icons:ButtonIcon.Key="rowPaste" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.deleteRow" Content="행 삭제"
                icons:ButtonIcon.Key="rowDelete" icons:ButtonIcon.IconOnly="True" />
        <Separator Classes="toolbar" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.previewDml" Content="반영할 DML 미리보기"
                IsEnabled="{Binding IsEditDirty}" icons:ButtonIcon.Key="objView" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.apply" Content="반영(커밋 안 함)"
                IsEnabled="{Binding IsEditDirty}" icons:ButtonIcon.Key="save" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.applyAndCommit" Content="반영 후 커밋"
                IsEnabled="{Binding IsEditDirty}" icons:ButtonIcon.Key="commit" icons:ButtonIcon.IconOnly="True" />
        <Separator Classes="toolbar" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.resetRow" Content="행 되돌리기"
                IsEnabled="{Binding IsEditDirty}" icons:ButtonIcon.Key="reset" icons:ButtonIcon.IconOnly="True" />
        <Button Classes="toolbar" Focusable="False" Tag="oranda.grid.edit.resetAll" Content="모두 되돌리기"
                IsEnabled="{Binding IsEditDirty}" icons:ButtonIcon.Key="eraser" icons:ButtonIcon.IconOnly="True" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
      <vm:ResultGridControl x:Name="GridControl" Grid.Row="0" Grid.Column="0" />
      <!-- 열 머리글 ▾ 자동 필터 팝업(TSK-13-26): 내용은 눌렀을 때 코드로 채운다(ColumnFilterPanel). -->
      <Popup x:Name="ColumnFilterHost" Grid.Row="0" Grid.Column="0" IsLightDismissEnabled="True"
             Placement="BottomEdgeAlignedLeft" PlacementTarget="{Binding #GridControl}" />
      <!-- 셀 편집기(편집 모드에서 두 번 누르기·F2): 셀 위에 겹쳐 띄운다. Enter 반영·Esc 취소. -->
      <TextBox x:Name="CellEditor" Grid.Row="0" Grid.Column="0" IsVisible="False" MinHeight="0" Padding="4,0"
               HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
               FontFamily="Cascadia Mono,Consolas,Menlo,monospace" AutomationProperties.Name="셀 편집" />
      <ScrollBar x:Name="VBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical" AllowAutoHide="False" />
      <ScrollBar x:Name="HBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" AllowAutoHide="False" />
    </Grid>
    <Border Grid.Row="5" Classes="panel-status">
      <DockPanel>
        <!-- 여러 칸을 고르면 개수·합계·평균·최소·최대(가져온 행만). 누르면 이 글을 복사한다. -->
        <TextBlock x:Name="SelectionSummaryText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                   Cursor="Hand" Background="Transparent" Text="{Binding SelectionSummary}"
                   IsVisible="{Binding HasSelectionSummary}" ToolTip.Tip="눌러서 집계 복사" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <!-- 전체 행 수를 세는 동안(oranda.grid.countRows)만 보이는 취소 단추. -->
        <Button x:Name="CountCancelButton" DockPanel.Dock="Left" Classes="tool" Padding="4,0" Margin="6,0,0,0" Focusable="False"
                Content="행 수 세기 취소" IsVisible="{Binding IsCountingRows}" icons:ButtonIcon.Key="cancel" />
        <!-- 거르고 남은 행이 가져온 일부뿐일 때(TSK-13-26): 상태 줄의 「거름: 보이는 N / 가져온 M행 (전체 아님)」 옆에 보인다. -->
        <Button x:Name="FilterFetchAllButton" DockPanel.Dock="Left" Classes="tool" Padding="4,0" Margin="6,0,0,0" Focusable="False"
                Content="모두 가져오기" IsVisible="{Binding CanFetchAllForFilter}" icons:ButtonIcon.Key="down" />
        <!-- 머리글 정렬하는 동안(TSK-13-17)만 보이는 진행 글과 취소 단추(Esc 도 같다). -->
        <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding SortStatusText}"
                   IsVisible="{Binding IsSorting}" />
        <Button x:Name="SortCancelButton" DockPanel.Dock="Left" Classes="tool" Padding="4,0" Margin="6,0,0,0" Focusable="False"
                Content="정렬 취소" IsVisible="{Binding IsSorting}" icons:ButtonIcon.Key="cancel" />
        <Panel />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
