<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.SqlMonitor"
             xmlns:mon="using:Oranda.App.Features.SessionMonitor"
             x:Class="Oranda.App.Features.SqlMonitor.TuningRecommendationsView"
             x:DataType="vm:TuningRecommendationsViewModel">
  <!-- SQL 모니터 「튜닝 추천」 탭(TSK-14-17): 왼쪽 점수순 목록(조회 결과 그리드), 오른쪽 이유·근거·SQL. 새로 고침은 수동. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <WrapPanel>
        <Button x:Name="RecRefreshButton" Classes="tool" Content="새로 고침" IsEnabled="{Binding CanRefresh}" icons:ButtonIcon.Key="refresh"
                ToolTip.Tip="공유 풀(v$sqlstats) 상위 SQL 을 다시 읽어 규칙으로 점수 매깁니다(자동 새로 고침 없음)" />
        <CheckBox Margin="6,0" VerticalAlignment="Center" Content="내부 스키마 제외" IsChecked="{Binding ExcludeInternal, Mode=TwoWay}"
                  ToolTip.Tip="SYS·SYSTEM 같은 Oracle 내부 스키마와 옵티마이저 재귀 SQL 을 뺍니다" />
        <Separator Classes="toolbar" />
        <Button x:Name="RecAssistantButton" Classes="tool" Content="튜닝 도우미로 열기" icons:ButtonIcon.Key="star"
                IsEnabled="{Binding HasSelection}" IsVisible="{Binding CanOpenAssistant}" />
        <Button x:Name="RecChildCursorsButton" Classes="tool" Content="자식 커서" icons:ButtonIcon.Key="diff"
                IsEnabled="{Binding HasSelection}" IsVisible="{Binding CanOpenChildCursors}" />
        <Button x:Name="RecEditorButton" Classes="tool" Content="편집기로 열기" icons:ButtonIcon.Key="docEdit" IsEnabled="{Binding HasSelection}" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock x:Name="StatusLine" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid ColumnDefinitions="3*,4,2*">
      <mon:MonitorGrid x:Name="RecommendList" Grid.Column="0" />
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource OrandaSplitterBrush}" />
      <TextBox Grid.Column="2" Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               FontFamily="{StaticResource OrandaFixedFontFamily}" AutomationProperties.Name="추천 이유와 SQL" />
    </Grid>
  </DockPanel>
</UserControl>
