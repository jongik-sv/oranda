<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             xmlns:vm="using:Oranda.App.Features.SqlMonitor"
             x:Class="Oranda.App.Features.SqlMonitor.SqlMonitorView"
             keymaps:FocusSlot.Name="monitor"
             x:DataType="vm:SqlMonitorViewModel">
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="4">
      <ComboBox x:Name="PresetBox" Width="250" Margin="0,0,6,4" ItemsSource="{x:Static vm:SqlMonitorViewModel.Presets}"
                SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
      <TextBox Width="90" Margin="0,0,6,4" PlaceholderText="소요 시간(초)" Text="{Binding MinElapsedText, Mode=TwoWay}" />
      <TextBox Width="100" Margin="0,0,6,4" PlaceholderText="읽은 블록" Text="{Binding MinBlocksText, Mode=TwoWay}" />
      <TextBox Width="90" Margin="0,0,6,4" PlaceholderText="실행 횟수" Text="{Binding MinExecutionsText, Mode=TwoWay}" />
      <TextBox Width="180" Margin="0,0,6,4" PlaceholderText="SQL 텍스트·SQL ID" Text="{Binding TextFilter, Mode=TwoWay}" />
      <TextBox Width="100" Margin="0,0,6,4" PlaceholderText="스키마" Text="{Binding SchemaFilter, Mode=TwoWay}" />
      <TextBox Width="100" Margin="0,0,6,4" PlaceholderText="최근 N분" Text="{Binding ActiveMinutesText, Mode=TwoWay}" />
      <ComboBox x:Name="OrderBox" Width="140" Margin="0,0,6,4" ItemsSource="{x:Static vm:SqlMonitorViewModel.Orders}" />
      <NumericUpDown Width="110" Margin="0,0,10,4" Minimum="1" Maximum="1000" Increment="10" Value="{Binding Top, Mode=TwoWay}" />
      <Button x:Name="SearchButton" Margin="0,0,6,4" Content="검색" IsEnabled="{Binding IsOpen}" />
      <Button x:Name="PlanButton" Margin="0,0,6,4" Content="실제 계획" IsEnabled="{Binding IsOpen}" />
      <Button x:Name="BindsButton" Margin="0,0,6,4" Content="전문·바인드" IsEnabled="{Binding IsOpen}" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="6,2" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
    <Grid RowDefinitions="3*,4,2*">
      <DockPanel Grid.Row="0">
        <Grid DockPanel.Dock="Top" Margin="6,2" ColumnDefinitions="120,40,70,70,90,90,80,100,*" Opacity="0.7">
          <TextBlock Grid.Column="0" Text="SQL ID" />
          <TextBlock Grid.Column="1" Text="자식" />
          <TextBlock Grid.Column="2" Text="소요(s)" />
          <TextBlock Grid.Column="3" Text="CPU(s)" />
          <TextBlock Grid.Column="4" Text="실행" />
          <TextBlock Grid.Column="5" Text="읽은 블록" />
          <TextBlock Grid.Column="6" Text="디스크" />
          <TextBlock Grid.Column="7" Text="스키마" />
          <TextBlock Grid.Column="8" Text="SQL" />
        </Grid>
        <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedSql, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TopSqlItem">
              <Grid ColumnDefinitions="120,40,70,70,90,90,80,100,*">
                <TextBlock Grid.Column="0" Text="{Binding SqlId}" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Grid.Column="1" Text="{Binding ChildText}" />
                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" />
                <TextBlock Grid.Column="3" Text="{Binding CpuText}" />
                <TextBlock Grid.Column="4" Text="{Binding ExecutionsText}" />
                <TextBlock Grid.Column="5" Text="{Binding BlocksText}" />
                <TextBlock Grid.Column="6" Text="{Binding DiskText}" />
                <TextBlock Grid.Column="7" Text="{Binding Schema}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="8" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
      <TabControl Grid.Row="2">
        <TabItem Header="전문·바인드">
          <TextBox Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Consolas,Menlo,monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </TabItem>
        <TabItem Header="실제 계획">
          <TextBox Text="{Binding PlanText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Consolas,Menlo,monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
