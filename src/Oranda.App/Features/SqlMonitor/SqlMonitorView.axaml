<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.SqlMonitor"
             x:Class="Oranda.App.Features.SqlMonitor.SqlMonitorView"
             keymaps:FocusSlot.Name="monitor"
             x:DataType="vm:SqlMonitorViewModel">
  <DockPanel>
    <!-- 툴바(Orange SQL Monitor): 프리셋·정렬·Top N 과 검색 | 실제 계획·전문·바인드 -->
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <WrapPanel>
        <ComboBox x:Name="PresetBox" Classes="compact" Width="250" Margin="0,0,6,0" ItemsSource="{x:Static vm:SqlMonitorViewModel.Presets}"
                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" AutomationProperties.Name="프리셋" />
        <ComboBox x:Name="OrderBox" Classes="compact" Width="140" Margin="0,0,6,0" ItemsSource="{x:Static vm:SqlMonitorViewModel.Orders}"
                  AutomationProperties.Name="정렬" />
        <NumericUpDown Width="110" Margin="0,0,6,0" Minimum="1" Maximum="1000" Increment="10" Value="{Binding Top, Mode=TwoWay}"
                       FormatString="'Top '0" VerticalAlignment="Center" AutomationProperties.Name="상위 개수" />
        <Button x:Name="SearchButton" Classes="tool" Content="검색" IsEnabled="{Binding IsOpen}" icons:ButtonIcon.Key="find" />
        <Separator Classes="toolbar" />
        <Button x:Name="PlanButton" Classes="tool" Content="실제 계획" IsEnabled="{Binding IsOpen}" icons:ButtonIcon.Key="plan" />
        <Button x:Name="BindsButton" Classes="tool" Content="전문·바인드" IsEnabled="{Binding IsOpen}" icons:ButtonIcon.Key="binds" />
      </WrapPanel>
    </Border>
    <!-- 거르기 줄: 값이 있는 칸만 조건이 된다. -->
    <WrapPanel DockPanel.Dock="Top" Margin="4,4,4,2">
      <TextBox Classes="compact search" Width="220" Margin="0,0,6,0" PlaceholderText="SQL 텍스트·SQL ID" Text="{Binding TextFilter, Mode=TwoWay}" />
      <TextBox Classes="compact" Width="100" Margin="0,0,6,0" PlaceholderText="스키마" Text="{Binding SchemaFilter, Mode=TwoWay}" />
      <TextBox Classes="compact" Width="100" Margin="0,0,6,0" PlaceholderText="소요 시간(초) ≥" Text="{Binding MinElapsedText, Mode=TwoWay}" />
      <TextBox Classes="compact" Width="100" Margin="0,0,6,0" PlaceholderText="읽은 블록 ≥" Text="{Binding MinBlocksText, Mode=TwoWay}" />
      <TextBox Classes="compact" Width="100" Margin="0,0,6,0" PlaceholderText="실행 횟수 ≥" Text="{Binding MinExecutionsText, Mode=TwoWay}" />
      <TextBox Classes="compact" Width="100" Margin="0,0,6,0" PlaceholderText="최근 N분" Text="{Binding ActiveMinutesText, Mode=TwoWay}" />
    </WrapPanel>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid RowDefinitions="3*,4,2*">
      <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <DockPanel MinWidth="820">
        <Border DockPanel.Dock="Top" Classes="grid-header">
        <Grid Margin="6,0" ColumnDefinitions="120,40,70,70,90,90,80,100,*">
          <TextBlock Grid.Column="0" Text="SQL ID" />
          <TextBlock Grid.Column="1" Text="자식" />
          <TextBlock Grid.Column="2" Text="소요(s)" />
          <TextBlock Grid.Column="3" Text="CPU(s)" />
          <TextBlock Grid.Column="4" Text="실행" />
          <TextBlock Grid.Column="5" Text="읽은 블록" />
          <TextBlock Grid.Column="6" Text="디스크" />
          <TextBlock Grid.Column="7" Text="스키마" />
          <TextBlock Grid.Column="8" Text="SQL" />
        </Grid>
        </Border>
        <ListBox x:Name="ResultList" Classes="log" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedSql, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TopSqlItem">
              <Grid ColumnDefinitions="120,40,70,70,90,90,80,100,*">
                <TextBlock Grid.Column="0" Text="{Binding SqlId}" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Grid.Column="1" Text="{Binding ChildText}" />
                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" />
                <TextBlock Grid.Column="3" Text="{Binding CpuText}" />
                <TextBlock Grid.Column="4" Text="{Binding ExecutionsText}" />
                <TextBlock Grid.Column="5" Text="{Binding BlocksText}" />
                <TextBlock Grid.Column="6" Text="{Binding DiskText}" />
                <TextBlock Grid.Column="7" Text="{Binding Schema}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="8" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      </ScrollViewer>
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource OrandaSplitterBrush}" />
      <TabControl Grid.Row="2">
        <TabItem Header="전문·바인드">
          <TextBox Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Consolas,Menlo,monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </TabItem>
        <TabItem Header="실제 계획">
          <TextBox Text="{Binding PlanText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Consolas,Menlo,monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
