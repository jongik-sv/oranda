<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keymaps="using:Oranda.App.Shell.Keymaps"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             xmlns:vm="using:Oranda.App.Features.PlsqlEditor"
             xmlns:se="using:Oranda.App.Features.SqlEditor"
             xmlns:diff="using:Oranda.App.Features.MyBatisWorkspace.Save"
             x:Class="Oranda.App.Features.PlsqlEditor.PlsqlEditorView"
             x:DataType="vm:PlsqlEditorViewModel">
  <!-- 위: 저장 도구줄·충돌 알림 / 본문: SQL 편집기 + 오른쪽 차이 보기(열렸을 때) / 맨 아래: 상태 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button x:Name="CompileButton" Classes="tool" Content="컴파일(저장)" IsEnabled="{Binding !IsBusy}" icons:ButtonIcon.Key="compile" />
        <Button x:Name="DiffButton" Classes="tool" Content="서버와 차이" icons:ButtonIcon.Key="diff" />
        <Button x:Name="SiblingButton" Classes="tool" Content="명세/본문" IsVisible="{Binding IsPackageDoc}" icons:ButtonIcon.Key="swap" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="6,4" IsVisible="{Binding HasConflictBanner}"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Spacing="4">
        <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="ForceButton" Classes="tool" Content="무시하고 덮어쓰기" icons:ButtonIcon.Key="warn" />
          <Button x:Name="ReloadButton" Classes="tool" Content="서버 소스 다시 읽기" icons:ButtonIcon.Key="refresh" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="panel-status">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
    <!-- 편집기 | 끌어 옮기는 세로 경계 | 차이 보기(열렸을 때만, 왼쪽 = 서버·오른쪽 = 내 소스 나란히). 칸 너비는 코드에서 연다·닫는다. -->
    <Grid x:Name="BodyGrid" ColumnDefinitions="*,Auto,0">
      <se:SqlEditorView x:Name="EditorView" keymaps:FocusSlot.Name="plsql" />
      <GridSplitter x:Name="DiffSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" IsVisible="False"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <DockPanel x:Name="DiffPanel" Grid.Column="2" IsVisible="False">
        <!-- 머리 글자는 나란히 보기 두 반쪽 위에(MyBatis 「차이 보고 고르기」 창과 같은 들여쓰기) -->
        <Panel DockPanel.Dock="Top">
          <Grid x:Name="DiffHeads" ColumnDefinitions="*,*" Margin="46,0,0,0">
            <TextBlock Text="서버" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="내 소스" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
          <Button x:Name="CloseDiffButton" Classes="tool" Content="차이 닫기" HorizontalAlignment="Right" Margin="4,2" icons:ButtonIcon.Key="clear" />
        </Panel>
        <Panel>
          <diff:MapperDiffView x:Name="DiffView" />
          <ScrollViewer x:Name="DiffTextScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding DiffText}" Margin="8,2" FontFamily="Consolas,Menlo,monospace" />
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
