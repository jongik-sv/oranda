<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oranda.App.Features.PlsqlEditor"
             xmlns:icons="using:Oranda.App.Shell.Icons"
             x:Class="Oranda.App.Features.PlsqlEditor.CompileErrorsView"
             x:DataType="vm:CompileErrorsViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel-toolbar">
      <TextBlock Text="{Binding Header}" Classes="panel-caption" Margin="2,2" />
    </Border>
    <ListBox Classes="log" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             AutomationProperties.Name="컴파일 오류 목록">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CompileErrorItem">
          <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="두 번 누르면 그 줄로 이동">
            <ContentControl Content="{Binding IconKey, Converter={x:Static icons:IconKeyConverter.Instance}, ConverterParameter=14}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Kind}" MinWidth="28" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Position}" MinWidth="56" FontFamily="Consolas,Menlo,monospace" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
