<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:dockctl="using:Dock.Avalonia.Controls"
             xmlns:aedit="using:AvaloniaEdit.Editing"
             x:Class="Oranda.App.App"
             xmlns:local="using:Oranda.App"
             Name="Oranda"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant 는 OS 테마를 따른다(설정 창·보기 메뉴에서 밝게/어둡게로 바꾸면 ThemeService 가 바꾼다). -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <dock:DockFluentTheme />

        <!-- 앱 전체 밀도: Fluent 기본(32 DIP)보다 조금 촘촘하게(Orange·SQL Developer 수준). -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3,0,3" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <!-- 일반 단추(Dock 의 머리·탭 단추는 PART_* 이름으로 제외한다): macOS 풍 — 높이 30·모서리 6·1 DIP 테두리·아주 옅은 아래 그림자, 좌우 여백 16·최소 폭 84(대화상자 단추 줄이 들쭉날쭉하지 않게).
             툴바·도구 단추·팔레트 칸·시작 목록은 아래 자기 클래스 규칙이 따로 정한다. hover = 바탕 한 단계, pressed = 두 단계 어둡게.
             쓸 수 없을 때도 바탕·테두리 상자는 그대로 두고 글자만 흐리게 한다(단추처럼 안 보이는 결함 방지). 기본 단추(accent)는 앱 강조 파랑 채움·흰 글자·테두리 없음(상자 크기는 같게 투명 테두리). -->
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton)">
            <Setter Property="Background" Value="{DynamicResource OrandaButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="16,3" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton):not(.accent) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 1 1 0 #18000000" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton):not(.accent):pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaButtonBorderBrush}" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton):not(.accent):pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaButtonPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaButtonBorderBrush}" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton):not(.accent):disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaButtonDisabledBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OrandaButtonDisabledForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton).accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaButtonAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton).accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaButtonAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton).accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaButtonAccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button:not(.toolbar):not(.tool):not(.palette-box):not(.start-item):not(#PART_CloseButton):not(#PART_PinButton):not(#PART_MenuButton):not(#PART_ToolCloseButton):not(#PART_ToolPinButton):not(#PART_ToolMenuButton):not(#PART_MaximizeButton):not(#PART_MaximizeRestoreButton):not(#PART_MinimizeButton):not(#PART_PopoverCloseButton):not(#PART_PopoverFullScreenButton).accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- 문서 탭 줄 안의 Dock 단추(탭 닫기 ×, 새 문서 +)는 이름 없이 Dock 테마가 만든 것이라 위 :not 이름 제외로 걸러지지 않는다.
             일반 단추 규칙이 입힌 상자(흰 바탕·테두리·그림자·최소 크기)를 되돌려 평평한 아이콘 단추로 둔다(hover·pressed 는 툴바 단추와 같은 색). -->
        <Style Selector="dockctl|DocumentTabStrip Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="dockctl|DocumentTabStrip Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="dockctl|DocumentTabStrip Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="dockctl|DocumentTabStrip Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="dockctl|DocumentTabStrip Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- 편집기 선택 색: 기본값(시스템 강조색 채움)은 너무 진해 문법 색이 묻히므로 옅은 파랑으로 바꾸고, 선택 글자색·테두리는 두지 않아 문법 색이 그대로 보이게 한다.
             편집기가 포커스를 잃으면(다른 창·다른 칸) 선택 색을 회색조로 더 옅게 한다. SQL 편집기·코드 보기 등 앱 안의 AvaloniaEdit 모두에 걸린다. -->
        <Style Selector="aedit|TextArea">
            <Setter Property="SelectionBrush" Value="{DynamicResource OrandaEditorSelectionBrush}" />
            <Setter Property="SelectionForeground" Value="{x:Null}" />
            <Setter Property="SelectionBorder" Value="{x:Null}" />
            <Setter Property="SelectionCornerRadius" Value="2" />
        </Style>
        <Style Selector="aedit|TextArea:not(:focus)">
            <Setter Property="SelectionBrush" Value="{DynamicResource OrandaEditorSelectionInactiveBrush}" />
        </Style>

        <!-- 증감 칸: Fluent 템플릿은 ▲▼ 를 가로로 놓고 단추가 칸보다 커서, 같은 PART 이름(PART_SpinnerPanel·PART_IncreaseButton·PART_DecreaseButton)을
             유지한 템플릿으로 바꾼다. ▲▼ 는 칸 오른쪽에 위아래로 쌓여 칸 높이 안에 들어가고, 한계값에서 꺼진 단추는 바탕 없이 흐린 글리프만 남는다. -->
        <Style Selector="ButtonSpinner">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                MinHeight="{TemplateBinding MinHeight}" ClipToBounds="True">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter Name="PART_ContentPresenter" Grid.Column="0"
                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Padding="{TemplateBinding Padding}" />
                                <Grid Name="PART_SpinnerPanel" Grid.Column="1" RowDefinitions="*,*" Width="22" IsVisible="{TemplateBinding ShowButtonSpinner}">
                                    <RepeatButton Name="PART_IncreaseButton" Grid.Row="0" Classes="spin" Focusable="{TemplateBinding AllowSpin}">
                                        <PathIcon Width="8" Height="5" Data="{DynamicResource ButtonSpinnerIncreaseButtonIcon}" />
                                    </RepeatButton>
                                    <RepeatButton Name="PART_DecreaseButton" Grid.Row="1" Classes="spin" Focusable="{TemplateBinding AllowSpin}">
                                        <PathIcon Width="8" Height="5" Data="{DynamicResource ButtonSpinnerDecreaseButtonIcon}" />
                                    </RepeatButton>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RepeatButton.spin">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="RepeatButton.spin /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="RepeatButton.spin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarHoverBrush}" />
        </Style>
        <Style Selector="RepeatButton.spin:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
        </Style>
        <Style Selector="RepeatButton.spin:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.3" />
        </Style>

        <!-- 키보드 포커스 표시(7.5 접근성): 어떤 컨트롤이든 Tab 으로 포커스가 오면 2 DIP 테두리가 보인다. 색은 OrandaFocusBrush. -->
        <Style Selector=":is(Control)">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderThickness="2" CornerRadius="2" BorderBrush="{DynamicResource OrandaFocusBrush}" />
                </FocusAdornerTemplate>
            </Setter>
        </Style>

        <!-- 환경 라벨 틀(ui-shell.md 4.2): 운영 = 빨강 테두리 + 상태 표시줄 바탕 빨강. 색은 아래 테마 리소스에서만 받는다. -->
        <Style Selector="Border.env-frame.env-production">
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaEnvProductionBrush}" />
        </Style>
        <Style Selector="Border.env-frame.env-test">
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaEnvTestBrush}" />
        </Style>
        <Style Selector="Border.env-frame.env-development">
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaEnvDevelopmentBrush}" />
        </Style>
        <Style Selector="Border.statusbar">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="TextElement.FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
        </Style>
        <Style Selector="Border.status-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Border.statusbar.env-production">
            <Setter Property="Background" Value="{DynamicResource OrandaEnvProductionBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OrandaEnvProductionForegroundBrush}" />
        </Style>

        <!-- 툴바: 평평한 아이콘 단추(Orange·SQL Developer). 마우스를 올리면 옅은 바탕, 쓸 수 없으면 흐리게. -->
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbar-text">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarHoverBrush}" />
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
        </Style>
        <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Separator.toolbar">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.palette-box">
            <Setter Property="Background" Value="{DynamicResource OrandaSearchBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
        </Style>
        <Style Selector="ToggleButton.toolbar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaIconBlueBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 아이콘 + 짧은 글자 단추(도구 창·문서 안 Sub Toolbar). ButtonIcon.Key 로 아이콘을 붙인다. -->
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarHoverBrush}" />
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarPressedBrush}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.start-item">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeBase}" />
        </Style>
        <Style Selector="TextBlock.panel-caption">
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- 도구 창 안의 작은 툴바 띠와 아래 상태 줄(Orange 의 Sub Toolbar·Tool Statusbar). -->
        <Style Selector="Border.panel-toolbar">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Border.panel-status">
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.panel-status TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!-- 촘촘한 입력 칸·목록(Fluent 기본 32 DIP 줄 높이 → 24~26). -->
        <Style Selector="TextBox.compact">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeBase}" />
        </Style>
        <Style Selector="TextBox.search /template/ ContentPresenter#PART_InnerLeftContent">
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="ComboBox.compact">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,2,0,2" />
        </Style>
        <Style Selector="TreeView.compact TreeViewItem">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- 목록 머리글 띠(결과 그리드 머리글과 같은 색). -->
        <Style Selector="Border.grid-header">
            <Setter Property="Background" Value="{DynamicResource OrandaPanelHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style Selector="Border.grid-header TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
        </Style>
        <Style Selector="Border.detail-row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.detail-row-alt">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
        </Style>
        <Style Selector="TextBlock.invalid">
            <Setter Property="Foreground" Value="{DynamicResource OrandaIconRedBrush}" />
        </Style>

        <!-- 표 모양 목록(계획 트리·비교, 실행 이력, 변경 일지, 메시지, 컴파일 오류 — TSK-13-14·15).
             줄은 24 DIP·줄 폭을 채우고(배경이 끝까지), 짝수 줄은 옅은 줄무늬. 칸 글자는 결과 그리드와 같은 크기. -->
        <Style Selector="ListBox.table">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaGridFontSize}" />
        </Style>
        <Style Selector="ListBox.table ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.table ListBoxItem:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource OrandaRowAltBrush}" />
        </Style>
        <!-- 고른 줄: Fluent 기본(진한 강조색)보다 옅은 파랑. 줄 안의 색 글자·막대가 묻히지 않는다. -->
        <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.table ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OrandaTableSelectionBrush}" />
        </Style>
        <!-- 표 칸: 가로로 늘어놓은 고정 폭 칸(머리글과 줄이 같은 클래스·폭을 쓴다). 숫자 칸은 오른쪽 맞춤 고정폭 글꼴(자릿수가 세로로 맞는다). -->
        <Style Selector="StackPanel.cells > TextBlock">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{DynamicResource OrandaGridFontFamily}" />
        </Style>
        <Style Selector="Border.grid-header TextBlock.num">
            <Setter Property="FontFamily" Value="{x:Static FontFamily.Default}" />
        </Style>
        <Style Selector=":is(TextBlock).mono">
            <Setter Property="FontFamily" Value="{DynamicResource OrandaGridFontFamily}" />
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector=":is(TextBlock).warning-text">
            <Setter Property="Foreground" Value="{DynamicResource OrandaWarningForegroundBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).danger-text">
            <Setter Property="Foreground" Value="{DynamicResource OrandaDangerForegroundBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).success-text">
            <Setter Property="Foreground" Value="{DynamicResource OrandaSuccessForegroundBrush}" />
        </Style>
        <!-- 상세 칸의 작은 제목·조건절·DDL 같은 코드 상자, 짧은 표시 칩. -->
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.code">
            <Setter Property="Background" Value="{DynamicResource OrandaCodeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <!-- 읽기 전용 코드 보기(계획 텍스트·이력 문장·보관된 DDL): 테두리 없이 고정폭 글자. -->
        <Style Selector="TextBox.code-view">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="{DynamicResource OrandaGridFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource OrandaGridFontSize}" />
        </Style>
        <Style Selector="TextBox.code-view:focus /template/ Border#PART_BorderElement, TextBox.code-view:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource OrandaToolbarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 차이 줄(계획 비교·변경 일지 차이 보기): 추가 초록·빠짐 빨강·바뀜 노랑. -->
        <Style Selector="Border.diff.added">
            <Setter Property="Background" Value="{DynamicResource OrandaDiffAddedBrush}" />
        </Style>
        <Style Selector="Border.diff.removed">
            <Setter Property="Background" Value="{DynamicResource OrandaDiffRemovedBrush}" />
        </Style>
        <Style Selector="Border.diff.changed">
            <Setter Property="Background" Value="{DynamicResource OrandaDiffChangedBrush}" />
        </Style>

        <Style Selector="MenuItem:disabled Viewbox.shell-icon">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- 아래 도구 창 묶음은 탭이 많다(조회 결과·DBMS 출력·메시지·실행 계획·이력·컴파일 오류). 창이 좁으면 탭 줄을 두 줄로 꺾어
             마지막 탭이 창 밖으로 밀려나지 않게 한다(배율 250 %·영어에서도). -->
        <!-- Dock 테마는 문서·도구 탭 머리글 글자를 12 로 고정한다. 화면 글자 배율을 따르도록 탭 머리글 크기 리소스로 되돌린다. -->
        <Style Selector="dockctl|DocumentTabStripItem, dockctl|ToolTabStripItem">
            <Setter Property="FontSize" Value="{DynamicResource TabItemHeaderFontSize}" />
        </Style>
        <Style Selector="dockctl|ToolTabStrip">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="dockctl|ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- 앱 색은 Light·Dark 두 벌에 리소스 키로만 둔다(코드에 색 값 직접 쓰기 금지, ui-shell.md 6장). -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OrandaEnvProductionBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="OrandaEnvProductionForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OrandaEnvTestBrush" Color="#B65A00" />
                    <SolidColorBrush x:Key="OrandaEnvDevelopmentBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="OrandaEnvChipForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OrandaUncommittedBrush" Color="#B65A00" />
                    <SolidColorBrush x:Key="OrandaSeparatorBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="OrandaButtonBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OrandaButtonBorderBrush" Color="#D1D1D6" />
                    <SolidColorBrush x:Key="OrandaButtonHoverBrush" Color="#F2F2F7" />
                    <SolidColorBrush x:Key="OrandaButtonPressedBrush" Color="#E5E5EA" />
                    <SolidColorBrush x:Key="OrandaButtonDisabledBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OrandaButtonDisabledForegroundBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="OrandaButtonAccentBrush" Color="#0A64C8" />
                    <SolidColorBrush x:Key="OrandaButtonAccentHoverBrush" Color="#0956AD" />
                    <SolidColorBrush x:Key="OrandaButtonAccentPressedBrush" Color="#074A95" />
                    <SolidColorBrush x:Key="OrandaEditorSelectionBrush" Color="#ADD6FF" />
                    <SolidColorBrush x:Key="OrandaEditorSelectionInactiveBrush" Color="#E5EBF1" />
                    <SolidColorBrush x:Key="OrandaToolbarBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="OrandaToolbarHoverBrush" Color="#DCE6F4" />
                    <SolidColorBrush x:Key="OrandaToolbarPressedBrush" Color="#C3D5EE" />
                    <SolidColorBrush x:Key="OrandaPanelHeaderBrush" Color="#EAEAEA" />
                    <SolidColorBrush x:Key="OrandaSearchBoxBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OrandaSplitterBrush" Color="#D6D6D6" />
                    <!-- 아이콘 색(ShellIcons 의 Tone). Orange·SQL Developer 처럼 동작 종류마다 색을 나눈다. -->
                    <SolidColorBrush x:Key="OrandaIconGreenBrush" Color="#1E8E3E" />
                    <SolidColorBrush x:Key="OrandaIconRedBrush" Color="#D13438" />
                    <SolidColorBrush x:Key="OrandaIconBlueBrush" Color="#1F6FD0" />
                    <SolidColorBrush x:Key="OrandaIconAmberBrush" Color="#D99A16" />
                    <SolidColorBrush x:Key="OrandaIconOrangeBrush" Color="#E8710A" />
                    <SolidColorBrush x:Key="OrandaIconPurpleBrush" Color="#8250DF" />
                    <SolidColorBrush x:Key="OrandaIconTealBrush" Color="#0F7B8A" />
                    <SolidColorBrush x:Key="OrandaIconNeutralBrush" Color="#5F6368" />
                    <SolidColorBrush x:Key="OrandaFocusBrush" Color="#005FB8" />
                    <!-- 결과 그리드: 현재 행 띠(반투명, 선택 색보다 옅게)·행 머리 ▶·복제한 새 행의 바꿔야 할 키 칸. -->
                    <SolidColorBrush x:Key="OrandaGridCurrentRowBrush" Color="#1A2F6FDE" />
                    <SolidColorBrush x:Key="OrandaGridRowMarkerBrush" Color="#2F6FDE" />
                    <SolidColorBrush x:Key="OrandaGridNeedsChangeBrush" Color="#FFD8A8" />
                    <!-- 표 모양 목록(계획·이력·변경 일지·메시지·컴파일 오류): 줄무늬·강조 줄·차이 줄 바탕은 반투명이라 어떤 바탕 위에서도 글자가 읽힌다. -->
                    <SolidColorBrush x:Key="OrandaRowAltBrush" Color="#08000000" />
                    <SolidColorBrush x:Key="OrandaTableSelectionBrush" Color="#D3E5FA" />
                    <SolidColorBrush x:Key="OrandaHotRowBrush" Color="#1FE8710A" />
                    <SolidColorBrush x:Key="OrandaDiffAddedBrush" Color="#2E1E8E3E" />
                    <SolidColorBrush x:Key="OrandaDiffRemovedBrush" Color="#2ED13438" />
                    <SolidColorBrush x:Key="OrandaDiffChangedBrush" Color="#33D99A16" />
                    <SolidColorBrush x:Key="OrandaBarTrackBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="OrandaTreeGuideBrush" Color="#B4B4B4" />
                    <SolidColorBrush x:Key="OrandaCodeBackgroundBrush" Color="#F7F7F8" />
                    <!-- 글자색: 아이콘 색보다 진해 흰 바탕에서도 읽힌다. -->
                    <SolidColorBrush x:Key="OrandaWarningForegroundBrush" Color="#B65A00" />
                    <SolidColorBrush x:Key="OrandaDangerForegroundBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="OrandaSuccessForegroundBrush" Color="#107C10" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OrandaEnvProductionBrush" Color="#FF6B5E" />
                    <SolidColorBrush x:Key="OrandaEnvProductionForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="OrandaEnvTestBrush" Color="#F0A04B" />
                    <SolidColorBrush x:Key="OrandaEnvDevelopmentBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="OrandaEnvChipForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="OrandaUncommittedBrush" Color="#F0A04B" />
                    <SolidColorBrush x:Key="OrandaSeparatorBrush" Color="#404040" />
                    <SolidColorBrush x:Key="OrandaButtonBackgroundBrush" Color="#3A3A3C" />
                    <SolidColorBrush x:Key="OrandaButtonBorderBrush" Color="#545458" />
                    <SolidColorBrush x:Key="OrandaButtonHoverBrush" Color="#444446" />
                    <SolidColorBrush x:Key="OrandaButtonPressedBrush" Color="#4E4E50" />
                    <SolidColorBrush x:Key="OrandaButtonDisabledBackgroundBrush" Color="#3A3A3C" />
                    <SolidColorBrush x:Key="OrandaButtonDisabledForegroundBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="OrandaButtonAccentBrush" Color="#0A64C8" />
                    <SolidColorBrush x:Key="OrandaButtonAccentHoverBrush" Color="#0956AD" />
                    <SolidColorBrush x:Key="OrandaButtonAccentPressedBrush" Color="#074A95" />
                    <SolidColorBrush x:Key="OrandaEditorSelectionBrush" Color="#264F78" />
                    <SolidColorBrush x:Key="OrandaEditorSelectionInactiveBrush" Color="#3A3D41" />
                    <SolidColorBrush x:Key="OrandaToolbarBackgroundBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="OrandaToolbarHoverBrush" Color="#3A4556" />
                    <SolidColorBrush x:Key="OrandaToolbarPressedBrush" Color="#46566E" />
                    <SolidColorBrush x:Key="OrandaPanelHeaderBrush" Color="#333333" />
                    <SolidColorBrush x:Key="OrandaSearchBoxBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="OrandaSplitterBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="OrandaIconGreenBrush" Color="#5CC27A" />
                    <SolidColorBrush x:Key="OrandaIconRedBrush" Color="#FF6B6B" />
                    <SolidColorBrush x:Key="OrandaIconBlueBrush" Color="#6CB4FF" />
                    <SolidColorBrush x:Key="OrandaIconAmberBrush" Color="#F2C14E" />
                    <SolidColorBrush x:Key="OrandaIconOrangeBrush" Color="#FFA25C" />
                    <SolidColorBrush x:Key="OrandaIconPurpleBrush" Color="#B794F6" />
                    <SolidColorBrush x:Key="OrandaIconTealBrush" Color="#4FC3C9" />
                    <SolidColorBrush x:Key="OrandaIconNeutralBrush" Color="#B0B5BA" />
                    <SolidColorBrush x:Key="OrandaFocusBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="OrandaGridCurrentRowBrush" Color="#265B9BFF" />
                    <SolidColorBrush x:Key="OrandaGridRowMarkerBrush" Color="#5B9BFF" />
                    <SolidColorBrush x:Key="OrandaGridNeedsChangeBrush" Color="#6B3A10" />
                    <SolidColorBrush x:Key="OrandaRowAltBrush" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="OrandaTableSelectionBrush" Color="#2E4B6E" />
                    <SolidColorBrush x:Key="OrandaHotRowBrush" Color="#33FFA25C" />
                    <SolidColorBrush x:Key="OrandaDiffAddedBrush" Color="#335CC27A" />
                    <SolidColorBrush x:Key="OrandaDiffRemovedBrush" Color="#33FF6B6B" />
                    <SolidColorBrush x:Key="OrandaDiffChangedBrush" Color="#33F2C14E" />
                    <SolidColorBrush x:Key="OrandaBarTrackBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="OrandaTreeGuideBrush" Color="#5A5A5A" />
                    <SolidColorBrush x:Key="OrandaCodeBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="OrandaWarningForegroundBrush" Color="#F0A04B" />
                    <SolidColorBrush x:Key="OrandaDangerForegroundBrush" Color="#FF7B72" />
                    <SolidColorBrush x:Key="OrandaSuccessForegroundBrush" Color="#6CCB5F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- UI 글자 크기(DIP). 고정 Width/Height 대신 이 값과 자동 크기를 쓴다(ui-shell.md 5장). -->
            <x:Double x:Key="OrandaFontSizeBase">14</x:Double>
            <x:Double x:Key="OrandaFontSizeSmall">12</x:Double>
            <x:Double x:Key="OrandaEditorFontSize">13</x:Double>
            <x:Double x:Key="OrandaGridFontSize">13</x:Double>
            <FontFamily x:Key="OrandaGridFontFamily">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
            <FontFamily x:Key="OrandaEditorFontFamily">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>

            <!-- Fluent 기본 탭 머리글(24 DIP 글자, 48 DIP 높이)은 도구용으로 너무 크다. Orange·SQL Developer 처럼 작게 쓴다. -->
            <x:Double x:Key="TabItemHeaderFontSize">13.5</x:Double>
            <x:Double x:Key="TabItemMinHeight">28</x:Double>
            <x:Double x:Key="TabItemHeaderMinHeight">28</x:Double>
            <x:Double x:Key="TabItemVerticalPipeHeight">16</x:Double>
            <Thickness x:Key="TabItemHeaderMargin">10,0,10,0</Thickness>
            <FontWeight x:Key="TabItemHeaderThemeFontWeight">Normal</FontWeight>

            <!-- Expander 머리: 단추처럼 큰 chevron 상자를 글자 줄 높이에 맞춘 작은 것으로 줄인다. -->
            <x:Double x:Key="ExpanderMinHeight">28</x:Double>
            <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
            <Thickness x:Key="ExpanderChevronMargin">0,0,4,0</Thickness>
            <Thickness x:Key="ExpanderHeaderPadding">10,0,6,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
