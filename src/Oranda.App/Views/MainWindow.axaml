<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Oranda.App.ViewModels"
        xmlns:docking="using:Oranda.App.Shell.Docking"
        x:Class="Oranda.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        MinWidth="960" MinHeight="600"
        FontFamily="Inter, Malgun Gothic, Apple SD Gothic Neo"
        FontSize="{DynamicResource OrandaFontSizeBase}">

  <!-- 환경 테두리는 창 장식이 아니라 창 내용 안쪽에 그린다(최대화·전체 화면에서도 보임, ui-shell.md 4.2). -->
  <Border x:Name="EnvironmentBorder" BorderThickness="3" Classes="env-frame">
    <DockPanel>
      <!-- 창이 아주 좁으면(배율 250 %) 메뉴 머리글이 잘리지 않고 다음 줄로 넘어간다. -->
      <Menu x:Name="MenuBar" DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="Once">
        <Menu.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </Menu.ItemsPanel>
      </Menu>

      <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OrandaSeparatorBrush}"
              Background="{DynamicResource OrandaToolbarBackgroundBrush}">
        <DockPanel x:Name="ToolbarHost" Margin="4,2">
          <!-- 오른쪽 위 검색 칸 모양의 명령 팔레트 단추(SQL Developer 의 검색 칸 자리). -->
          <Button x:Name="PaletteButton" DockPanel.Dock="Right" Classes="palette-box" MinWidth="200"
                  AutomationProperties.Name="명령 검색" ToolTip.Tip="명령 검색 (⇧⌘P)">
            <DockPanel>
              <ContentControl x:Name="PaletteIcon" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock x:Name="PaletteText" Text="명령 검색" Opacity="0.6" VerticalAlignment="Center" />
            </DockPanel>
          </Button>
          <Button x:Name="OverflowButton" DockPanel.Dock="Right" Classes="toolbar toolbar-text" Content="…" IsVisible="False"
                  AutomationProperties.Name="더 보기" />
          <!-- 접속 콤보(ui-shell.md 1장): 맨 왼쪽, 활성 문서의 접속. 내용은 Attach 가 넣는다. -->
          <ContentControl x:Name="ConnectionComboHost" DockPanel.Dock="Left" VerticalAlignment="Center" />
          <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Spacing="1" />
        </DockPanel>
      </Border>

      <!-- 상태 표시줄: Orange 의 Main Statusbar 처럼 구간을 세로선으로 나눈 한 줄. -->
      <Border x:Name="StatusBarBorder" DockPanel.Dock="Bottom" Padding="4,2" MinHeight="24"
              Classes="statusbar">
        <ItemsControl x:Name="StatusBar" ItemsSource="{Binding StatusItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusBarEntry">
              <Border Classes="status-cell" IsVisible="{Binding IsShown}">
                <ContentControl Content="{Binding Item}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <docking:DockHostView x:Name="DockHost" DataContext="{Binding Docking}" />
    </DockPanel>
  </Border>
</Window>
