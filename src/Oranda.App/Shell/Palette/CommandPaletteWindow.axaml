<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:palette="using:Oranda.App.Shell.Palette"
        x:Class="Oranda.App.Shell.Palette.CommandPaletteWindow"
        x:DataType="palette:CommandPaletteViewModel"
        Title="{Binding TitleText}"
        Width="640" MinWidth="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <DockPanel Margin="8">
    <TextBox x:Name="QueryBox" DockPanel.Dock="Top"
             Text="{Binding Query, Mode=TwoWay}"
             PlaceholderText="{Binding WatermarkText}"
             AutomationProperties.Name="{Binding TitleText}" />
    <TextBlock DockPanel.Dock="Bottom" Margin="4,6" IsVisible="{Binding !HasResults}"
               Text="{Binding EmptyText}" Opacity="0.7" />
    <ListBox x:Name="ResultList" Margin="0,6,0,0" MaxHeight="360"
             ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}"
             IsVisible="{Binding HasResults}" AutomationProperties.Name="{Binding ResultsLabel}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="palette:PaletteItem">
          <Grid ColumnDefinitions="*,Auto" Opacity="{Binding IsEnabled, Converter={x:Static palette:PaletteConverters.EnabledOpacity}}">
            <StackPanel>
              <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{Binding ShortcutDisplay}" Opacity="0.8" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
