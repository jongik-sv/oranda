<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Oranda.App.Shell.Settings"
        x:Class="Oranda.App.Shell.Settings.SettingsWindow"
        x:DataType="settings:SettingsViewModel"
        Title="{Binding TitleText}"
        MinWidth="420" MinHeight="260"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <!-- 범주 목록(왼쪽)은 Orange 옵션 창·SQL Developer 환경설정처럼 세로 목록으로, 오른쪽은 라벨-값 두 열. -->
    <Style Selector="TabControl.categories TabItem">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeBase}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MinWidth" Value="120" />
    </Style>
    <Style Selector="Grid.form > NumericUpDown">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="140" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
  </Window.Styles>

  <!-- 고정 폭·높이를 쓰지 않는다(배율 250% 에서 글자가 잘리지 않게). 단추 줄은 항상 아래에 고정. -->
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button MinWidth="80" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Classes="accent"
              IsEnabled="{Binding !IsReadOnly}" IsDefault="True" />
      <Button MinWidth="80" Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" IsCancel="True" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"
               TextWrapping="Wrap" MaxWidth="480" Margin="0,12,0,0" />

    <TabControl Classes="categories" TabStripPlacement="Left" Padding="16,0,0,0">
      <TabItem Header="일반">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding ThemeLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="220" HorizontalAlignment="Stretch" x:Name="ThemeBox"
                      ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      AutomationProperties.Name="{Binding ThemeLabel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settings:ThemeChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="작업 공간" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="시작할 때 마지막 작업 공간 열기" IsChecked="{Binding RestoreOnStartup}" />
            <TextBlock Grid.Row="2" Text="자동 저장(초)" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="10" Increment="1" FormatString="0"
                           Value="{Binding AutosaveSeconds}" AutomationProperties.Name="자동 저장 간격" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="편집기">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding FontLabel}" />
            <!-- 편집 가능한 콤보: 설치되지 않은 글꼴 이름도 그대로 둔다(목록에 없다고 지우지 않는다). -->
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="220" HorizontalAlignment="Stretch" x:Name="FontBox"
                      IsEditable="True" ItemsSource="{Binding FontChoices}" Text="{Binding FontFamily, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding FontLabel}" />
            <TextBlock Grid.Row="1" Text="{Binding FontSizeLabel}" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="FontSizeBox"
                           Minimum="8" Maximum="32" Increment="1" FormatString="0.#"
                           Value="{Binding FontSize}" AutomationProperties.Name="{Binding FontSizeLabel}" />
            <TextBlock Grid.Row="2" Text="{Binding TabSizeLabel}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="TabSizeBox"
                           Minimum="1" Maximum="16" Increment="1" FormatString="0"
                           Value="{Binding TabSize}" AutomationProperties.Name="{Binding TabSizeLabel}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="실행">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="트랜잭션" />
            <CheckBox Grid.Row="0" Grid.Column="1" Content="자동 커밋(새 세션 기본값)" IsChecked="{Binding AutoCommit}" />
            <TextBlock Grid.Row="1" Text="DBMS_OUTPUT" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="실행할 때 함께 받기" IsChecked="{Binding DbmsOutput}" />
            <TextBlock Grid.Row="2" Text="스크립트 오류" />
            <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="160" ItemsSource="{Binding ErrorModes}"
                      SelectedItem="{Binding SelectedErrorMode}" AutomationProperties.Name="스크립트 오류 처리">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settings:ErrorModeChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="문장 나누기" />
            <CheckBox Grid.Row="3" Grid.Column="1" Content="빈 줄을 문장 끝으로 보기" IsChecked="{Binding SplitOnBlankLine}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="결과 그리드">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="한 번에 가져올 행" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="50" Maximum="100000" Increment="100" FormatString="0"
                           Value="{Binding PageSize}" AutomationProperties.Name="한 번에 가져올 행 수" />
            <TextBlock Grid.Row="1" Text="메모리 한도(MB)" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="16" Maximum="4096" Increment="16" FormatString="0"
                           Value="{Binding MemoryLimitMb}" AutomationProperties.Name="결과 메모리 한도" />
            <TextBlock Grid.Row="2" Text="LOB 미리 읽기(바이트)" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1048576" Increment="1000" FormatString="0"
                           Value="{Binding LobFetchSize}" AutomationProperties.Name="LOB 미리 읽기 크기" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="이력·캐시">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="실행 이력" />
            <CheckBox Grid.Row="0" Grid.Column="1" Content="실행한 SQL 을 기록" IsChecked="{Binding HistoryEnabled}" />
            <TextBlock Grid.Row="1" Text="바인드 값" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="바인드 값도 함께 기록" IsChecked="{Binding SaveBindValues}" />
            <TextBlock Grid.Row="2" Text="최대 개수" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="100" Maximum="1000000" Increment="1000" FormatString="0"
                           Value="{Binding HistoryMaxEntries}" AutomationProperties.Name="이력 최대 개수" />
            <TextBlock Grid.Row="3" Text="보관 일수" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="3650" Increment="30" FormatString="0"
                           Value="{Binding HistoryMaxAgeDays}" AutomationProperties.Name="이력 보관 일수" />
            <TextBlock Grid.Row="4" Text="메타데이터 캐시(일)" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="365" Increment="1" FormatString="0"
                           Value="{Binding CacheRetentionDays}" AutomationProperties.Name="메타데이터 캐시 보관 일수" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="모니터">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="새로 고침(초)" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="2" Maximum="60" Increment="1" FormatString="0"
                           Value="{Binding MonitorRefreshSeconds}" AutomationProperties.Name="모니터 새로 고침 간격" />
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
