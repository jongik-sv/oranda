<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Oranda.App.Shell.Settings"
        x:Class="Oranda.App.Shell.Settings.SettingsWindow"
        x:DataType="settings:SettingsViewModel"
        Title="{Binding TitleText}"
        MinWidth="420" MinHeight="260"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource OrandaFontSizeBase}">
  <Window.Styles>
    <!-- 범주 목록(왼쪽)은 Orange 옵션 창·SQL Developer 환경설정처럼 세로 목록으로, 오른쪽은 라벨-값 두 열. -->
    <Style Selector="TabControl.categories TabItem">
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeBase}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MinWidth" Value="120" />
    </Style>
    <Style Selector="Grid.form > NumericUpDown">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="140" />
    </Style>
    <Style Selector="TextBlock.hint.error">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource OrandaEnvProductionBrush}" />
    </Style>
    <!-- SQL 포맷 쪽: Orange 옵션 창처럼 테두리 묶음 안에 촘촘한 라디오 단추. -->
    <Style Selector="Border.fmt-group">
      <Setter Property="BorderBrush" Value="{DynamicResource OrandaSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="8,4,8,6" />
    </Style>
    <Style Selector="Border.fmt-group TextBlock.fmt-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.fmt-group RadioButton">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="4,0,0,0" />
    </Style>
    <Style Selector="TextBlock.fmt-hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.fmt-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource OrandaFocusBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="{DynamicResource OrandaFontSizeSmall}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
  </Window.Styles>

  <!-- 고정 폭·높이를 쓰지 않는다(배율 250% 에서 글자가 잘리지 않게). 열 때 가장 큰 범주에 맞춘 뒤 크기를 고정한다(코드 숨김). 단추 줄은 항상 아래에 고정.
       탭 순서 = 적은 순서(범주 → 입력 칸 → 저장 → 닫기)라서 단추 줄을 맨 뒤에 둔다. -->
  <Grid Margin="12" RowDefinitions="*,Auto,Auto">
    <TabControl Grid.Row="0" x:Name="Categories" Classes="categories" TabStripPlacement="Left" Padding="16,0,0,0" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{Binding Strings[tab.general]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding ThemeLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="220" HorizontalAlignment="Stretch" x:Name="ThemeBox"
                      ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      AutomationProperties.Name="{Binding ThemeLabel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settings:ThemeChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="{Binding LanguageLabel}" />
            <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="220" HorizontalAlignment="Stretch" x:Name="LanguageBox"
                      ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                      AutomationProperties.Name="{Binding LanguageLabel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settings:LanguageChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Text="{Binding UiScaleLabel}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="UiScaleBox"
                           Minimum="80" Maximum="250" Increment="10" FormatString="0'%'"
                           Value="{Binding UiScalePercent}" AutomationProperties.Name="{Binding UiScaleLabel}" />
            <TextBlock Grid.Row="3" Text="{Binding Strings[accessibility]}" />
            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="HighContrastBox"
                      Content="{Binding HighContrastLabel}" IsChecked="{Binding HighContrast}"
                      AutomationProperties.Name="{Binding HighContrastLabel}" />
            <TextBlock Grid.Row="4" Text="{Binding Strings[workspace]}" />
            <CheckBox Grid.Row="4" Grid.Column="1" Content="{Binding Strings[restore]}" IsChecked="{Binding RestoreOnStartup}" />
            <TextBlock Grid.Row="5" Text="{Binding Strings[autosave]}" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="10" Increment="1" FormatString="0"
                           Value="{Binding AutosaveSeconds}" AutomationProperties.Name="{Binding Strings[autosaveName]}" />
            <TextBlock Grid.Row="6" Text="{Binding Strings[schemaBrowser]}" />
            <CheckBox Grid.Row="6" Grid.Column="1" x:Name="SchemaPreviewBox" Content="{Binding Strings[schemaPreview]}"
                      IsChecked="{Binding SchemaSingleClickPreview}" AutomationProperties.Name="{Binding Strings[schemaPreview]}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Strings[tab.editor]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding FontLabel}" />
            <!-- 편집 가능한 콤보: 설치되지 않은 글꼴 이름도 그대로 둔다(목록에 없다고 지우지 않는다). -->
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="220" HorizontalAlignment="Stretch" x:Name="FontBox"
                      IsEditable="True" ItemsSource="{Binding FontChoices}" Text="{Binding FontFamily, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding FontLabel}" />
            <TextBlock Grid.Row="1" Text="{Binding FontSizeLabel}" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="FontSizeBox"
                           Minimum="8" Maximum="32" Increment="1" FormatString="0.#"
                           Value="{Binding FontSize}" AutomationProperties.Name="{Binding FontSizeLabel}" />
            <TextBlock Grid.Row="2" Text="{Binding TabSizeLabel}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="TabSizeBox"
                           Minimum="1" Maximum="16" Increment="1" FormatString="0"
                           Value="{Binding TabSize}" AutomationProperties.Name="{Binding TabSizeLabel}" />
            <CheckBox Grid.Row="3" Grid.Column="1" Content="{Binding LintLabel}" IsChecked="{Binding LintEnabled}" />
            <TextBlock Grid.Row="4" VerticalAlignment="Top" Margin="0,6,0,0" Text="{Binding Strings[auditColumns]}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
              <TextBox x:Name="AuditColumnsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                       Text="{Binding AuditColumns, Mode=TwoWay}" PlaceholderText="REG_DT, REG_ID, UPD_DT, UPD_ID, *_USER_ID"
                       AutomationProperties.Name="{Binding Strings[auditColumns]}" />
              <TextBlock Classes="hint" Text="{Binding Strings[auditColumnsHint]}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Strings[tab.format]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8" x:Name="SqlFormatPanel">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <!-- 절 배치가 열 맞춤(사내 서식)이면 키워드 맞춤은 효과가 없어 회색으로 두고 이유를 툴팁으로(TSK-13-42). -->
              <Border Grid.Row="0" Grid.Column="0" Classes="fmt-group" x:Name="FmtAlignGroup" IsEnabled="{Binding SqlFormat.KeywordAlignApplies}"
                      ToolTip.Tip="{Binding SqlFormat.KeywordAlignTip}" ToolTip.ShowOnDisabled="True">
                <StackPanel>
                  <TextBlock Classes="fmt-title" Text="{Binding Strings[fmt.keywordAlign]}" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="FmtAlignLeft" GroupName="fmtAlign" Content="{Binding Strings[fmt.left]}" IsChecked="{Binding SqlFormat.AlignLeft}" />
                    <RadioButton x:Name="FmtAlignRight" GroupName="fmtAlign" Content="{Binding Strings[fmt.right]}" IsChecked="{Binding SqlFormat.AlignRight}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Classes="fmt-group">
                <StackPanel>
                  <TextBlock Classes="fmt-title" Text="{Binding Strings[fmt.comma]}" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="FmtCommaTrailing" GroupName="fmtComma" Content="{Binding Strings[fmt.trailing]}" IsChecked="{Binding SqlFormat.CommaTrailing}" />
                    <RadioButton x:Name="FmtCommaLeading" GroupName="fmtComma" Content="{Binding Strings[fmt.leading]}" IsChecked="{Binding SqlFormat.CommaLeading}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Classes="fmt-group">
                <StackPanel>
                  <TextBlock Classes="fmt-title" Text="{Binding Strings[fmt.keywordCase]}" />
                  <RadioButton x:Name="FmtCaseAsIs" GroupName="fmtCase" Content="{Binding Strings[fmt.noChange]}" IsChecked="{Binding SqlFormat.CaseAsIs}" />
                  <RadioButton x:Name="FmtCaseUpper" GroupName="fmtCase" Content="{Binding Strings[fmt.upper]}" IsChecked="{Binding SqlFormat.CaseUpper}" />
                  <RadioButton x:Name="FmtCaseLower" GroupName="fmtCase" Content="{Binding Strings[fmt.lower]}" IsChecked="{Binding SqlFormat.CaseLower}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Classes="fmt-group">
                <StackPanel>
                  <TextBlock Classes="fmt-title" Text="{Binding Strings[fmt.byList]}" />
                  <RadioButton x:Name="FmtBySingle" GroupName="fmtBy" Content="{Binding Strings[fmt.singleLine]}" IsChecked="{Binding SqlFormat.ByListSingle}" />
                  <RadioButton x:Name="FmtByMulti" GroupName="fmtBy" Content="{Binding Strings[fmt.multiLine]}" IsChecked="{Binding SqlFormat.ByListMulti}" />
                </StackPanel>
              </Border>
            </Grid>
            <DockPanel>
              <Button x:Name="FmtDefaultButton" DockPanel.Dock="Left" Content="{Binding Strings[fmt.default]}" Command="{Binding SqlFormat.ResetDefaultsCommand}" />
              <Button x:Name="FmtMoreButton" DockPanel.Dock="Right" Classes="fmt-link" VerticalAlignment="Center"
                      Content="{Binding Strings[fmt.more]}" Command="{Binding OpenFormatterProfilesCommand}"
                      ToolTip.Tip="{Binding Strings[fmt.moreTip]}" IsEnabled="{Binding !IsReadOnly}" />
              <TextBlock x:Name="FmtProfile" Classes="fmt-hint" Margin="8,0" TextTrimming="CharacterEllipsis"
                         Text="{Binding SqlFormat.ProfileText}" ToolTip.Tip="{Binding SqlFormat.ProfileText}" />
            </DockPanel>
            <TextBlock x:Name="FmtError" Classes="hint error" TextAlignment="Left" Text="{Binding SqlFormat.ErrorText}"
                       IsVisible="{Binding SqlFormat.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Spacing="2" IsVisible="{Binding SqlFormat.HasPreview}">
              <TextBlock Classes="fmt-hint" Text="{Binding Strings[fmt.preview]}" />
              <Border Background="{DynamicResource OrandaCodeBackgroundBrush}" BorderBrush="{DynamicResource OrandaSeparatorBrush}"
                      BorderThickness="1" Padding="6,4">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <TextBlock x:Name="FmtPreview" Classes="mono" FontSize="{DynamicResource OrandaFontSizeSmall}" Text="{Binding SqlFormat.Preview}" />
                </ScrollViewer>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Strings[tab.execution]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Strings[tx]}" />
            <CheckBox Grid.Row="0" Grid.Column="1" Content="{Binding Strings[autoCommit]}" IsChecked="{Binding AutoCommit}" />
            <TextBlock Grid.Row="1" Text="{Binding Strings[dbmsOutput]}" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="{Binding Strings[dbmsOutputCollect]}" IsChecked="{Binding DbmsOutput}" />
            <TextBlock Grid.Row="2" Text="{Binding Strings[errorLabel]}" />
            <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="160" ItemsSource="{Binding ErrorModes}"
                      SelectedItem="{Binding SelectedErrorMode}" AutomationProperties.Name="{Binding Strings[errorName]}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="settings:ErrorModeChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="{Binding Strings[splitLabel]}" />
            <CheckBox Grid.Row="3" Grid.Column="1" Content="{Binding Strings[split]}" IsChecked="{Binding SplitOnBlankLine}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Strings[tab.grid]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Strings[page]}" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="50" Maximum="100000" Increment="100" FormatString="0"
                           Value="{Binding PageSize}" AutomationProperties.Name="{Binding Strings[pageName]}" />
            <TextBlock Grid.Row="1" Text="{Binding Strings[memory]}" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="16" Maximum="4096" Increment="16" FormatString="0"
                           Value="{Binding MemoryLimitMb}" AutomationProperties.Name="{Binding Strings[memoryName]}" />
            <TextBlock Grid.Row="2" Text="{Binding Strings[lob]}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1048576" Increment="1000" FormatString="0"
                           Value="{Binding LobFetchSize}" AutomationProperties.Name="{Binding Strings[lobName]}" />
            <TextBlock Grid.Row="3" Text="{Binding GridFontLabel}" />
            <ComboBox Grid.Row="3" Grid.Column="1" MinWidth="220" HorizontalAlignment="Stretch" x:Name="GridFontBox"
                      IsEditable="True" ItemsSource="{Binding FontChoices}" Text="{Binding GridFontFamily, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding GridFontLabel}" />
            <TextBlock Grid.Row="4" Text="{Binding GridFontSizeLabel}" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="GridFontSizeBox"
                           Minimum="8" Maximum="32" Increment="1" FormatString="0.#"
                           Value="{Binding GridFontSize}" AutomationProperties.Name="{Binding GridFontSizeLabel}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Strings[tab.history]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Strings[history]}" />
            <CheckBox Grid.Row="0" Grid.Column="1" Content="{Binding Strings[historyOn]}" IsChecked="{Binding HistoryEnabled}" />
            <TextBlock Grid.Row="1" Text="{Binding Strings[binds]}" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="{Binding Strings[bindsOn]}" IsChecked="{Binding SaveBindValues}" />
            <TextBlock Grid.Row="2" Text="{Binding Strings[maxEntries]}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="100" Maximum="1000000" Increment="1000" FormatString="0"
                           Value="{Binding HistoryMaxEntries}" AutomationProperties.Name="{Binding Strings[maxEntriesName]}" />
            <TextBlock Grid.Row="3" Text="{Binding Strings[maxAge]}" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="3650" Increment="30" FormatString="0"
                           Value="{Binding HistoryMaxAgeDays}" AutomationProperties.Name="{Binding Strings[maxAgeName]}" />
            <TextBlock Grid.Row="4" Text="{Binding Strings[cache]}" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="365" Increment="1" FormatString="0"
                           Value="{Binding CacheRetentionDays}" AutomationProperties.Name="{Binding Strings[cacheName]}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Strings[tab.monitor]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Strings[refresh]}" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="2" Maximum="60" Increment="1" FormatString="0"
                           Value="{Binding MonitorRefreshSeconds}" AutomationProperties.Name="{Binding Strings[refreshName]}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Strings[tab.update]}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Strings[update.version]}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UpdateVersionText" Text="{Binding UpdateVersionText}" TextAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="{Binding Strings[update.automatic]}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
              <CheckBox x:Name="UpdateCheckOnStartupBox" Content="{Binding Strings[update.checkOnStartup]}" IsChecked="{Binding UpdateCheckOnStartup}"
                        AutomationProperties.Name="{Binding Strings[update.checkOnStartup]}" />
              <CheckBox x:Name="UpdateAutoDownloadBox" Content="{Binding Strings[update.autoDownload]}" IsChecked="{Binding UpdateAutoDownload}"
                        AutomationProperties.Name="{Binding Strings[update.autoDownload]}" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{Binding Strings[update.feed]}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="UpdateFeedBox" MinWidth="280" Text="{Binding UpdateFeedUrl}"
                     PlaceholderText="{Binding UpdateFeedPlaceholder}" AutomationProperties.Name="{Binding Strings[update.feed]}" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UpdateFeedMessage" Classes="hint" Classes.error="{Binding FeedMessageIsError}"
                       TextAlignment="Left" Text="{Binding FeedMessage}" IsVisible="{Binding HasFeedMessage}" />
            <TextBlock Grid.Row="4" Text="{Binding Strings[update.skipped]}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SkippedVersionText}" VerticalAlignment="Center" />
              <Button x:Name="ClearSkippedButton" Content="{Binding Strings[update.clearSkipped]}" Command="{Binding ClearSkippedVersionCommand}"
                      IsVisible="{Binding HasSkippedVersion}" />
            </StackPanel>
            <TextBlock Grid.Row="5" Text="{Binding Strings[update.lastChecked]}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastCheckedText}" TextAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="6">
              <Button x:Name="CheckUpdateNowButton" Content="{Binding Strings[update.checkNow]}" Command="{Binding CheckUpdateNowCommand}" HorizontalAlignment="Left" />
              <TextBlock Classes="hint" TextAlignment="Left" Text="{Binding Strings[update.checkNowHint]}" />
              <TextBlock x:Name="UpdateCheckResult" TextAlignment="Left" Text="{Binding UpdateCheckText}" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="1" Text="{Binding Notice}" IsVisible="{Binding HasNotice}"
               TextWrapping="Wrap" MaxWidth="480" Margin="0,12,0,0" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Classes="accent"
              IsEnabled="{Binding !IsReadOnly}" IsDefault="True" />
      <Button Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
