<Project Sdk="Microsoft.NET.Sdk">
  <!-- 바닥값 비교용: Avalonia 없는 self-contained 콘솔. Main 진입 시각만 찍는다.
       -p:WithDeps=true 면 StartupProbe 와 같은 패키지를 참조만 한다(쓰지 않음) — deps.json·TPA 크기 효과 확인용. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup Condition="'$(WithDeps)' == 'true'">
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
  </ItemGroup>
</Project>
