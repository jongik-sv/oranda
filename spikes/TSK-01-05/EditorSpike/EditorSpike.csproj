<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- 지정 버전 11.4.1 은 Avalonia 12 와 호환되지 않음(RESULT.md 참고). -p:AvaloniaEditVersion=11.4.1 로 재현 가능. -->
    <AvaloniaEditVersion Condition="'$(AvaloniaEditVersion)' == ''">12.0.0</AvaloniaEditVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS3021;CS0108</NoWarn>
  </PropertyGroup>
  <!-- ANTLR 생성물(../PlSqlAntlr/Generated, Java 필요: PlSqlAntlr/gen-antlr.sh)이 있을 때만 L2 측정 코드를 넣는다. -->
  <PropertyGroup Condition="Exists('../PlSqlAntlr/Generated/PlSqlParser.cs')">
    <DefineConstants>$(DefineConstants);HAS_PLSQL_ANTLR</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../PlSqlAntlr/Generated/PlSqlParser.cs')">
    <ProjectReference Include="../PlSqlAntlr/PlSqlAntlr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="$(AvaloniaEditVersion)" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
